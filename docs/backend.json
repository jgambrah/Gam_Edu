{
  "entities": {
    "LearningMaterial": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LearningMaterial",
      "description": "Represents a piece of editable course content, including rich text and assignments.",
      "type": "object",
      "properties": {
        "courseId": {
          "type": "string",
          "description": "A unique identifier for the course (e.g., 'bs7-integrated-science')."
        },
        "courseName": {
          "type": "string",
          "description": "The display name of the course."
        },
        "subjectId": {
            "type": "string",
            "description": "The ID of the subject this material belongs to."
        },
        "classId": {
            "type": "string",
            "description": "The ID of the class this material is assigned to."
        },
        "strand": {
          "type": "string",
          "description": "The high-level strand or chapter the material belongs to."
        },
        "subStrandTitle": {
          "type": "string",
          "description": "The specific topic or sub-strand title."
        },
        "content": {
          "type": "string",
          "description": "The full notes or learning content, supporting markdown or basic HTML for rich text and images."
        }
      },
      "required": ["courseId", "courseName", "strand", "subStrandTitle", "content"]
    },
    "Announcement": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Announcement",
      "type": "object",
      "description": "Represents an official school-wide announcement.",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the announcement."
        },
        "content": {
          "type": "string",
          "description": "The full content of the announcement."
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time the announcement was published."
        },
        "authorId": {
          "type": "string",
          "description": "The UID of the administrator who published the announcement."
        },
        "audience": {
          "type": "array",
          "description": "List of roles that should see this announcement (e.g., ['Student', 'Parent']). 'Everybody' targets all roles.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["title", "content", "publishedAt", "authorId", "audience"]
    },
    "Staff": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Staff",
      "type": "object",
      "description": "Represents a staff member in the school system.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier for the staff member (matches Firebase Auth UID)."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the staff member."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the staff member."
        },
        "email": {
          "type": "string",
          "description": "Email address of the staff member.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the staff member."
        },
        "role": {
          "type": "string",
          "description": "The assigned role of the staff member."
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "description": "Date of birth of the staff member."
        },
        "gender": {
          "type": "string",
          "description": "Gender of the staff member."
        },
        "nationality": {
          "type": "string",
          "description": "Nationality of the staff member."
        },
        "address": {
          "type": "string",
          "description": "Home address of the staff member."
        },
        "profilePictureUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL of the staff member's profile picture."
        }
      },
      "required": [
        "uid",
        "firstName",
        "lastName",
        "email",
        "role"
      ]
    },
    "Role": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Role",
      "type": "object",
      "description": "Defines the role of a user within the school system, determining their access privileges.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the role."
        },
        "name": {
          "type": "string",
          "description": "Name of the role (e.g., Administrator, Teacher, Student)."
        },
        "description": {
          "type": "string",
          "description": "Description of the role and its responsibilities."
        },
        "permissions": {
          "type": "array",
          "description": "List of permissions associated with this role.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ]
    },
    "Student": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Student",
      "type": "object",
      "description": "Represents a student in the school system.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier for the student (matches Firebase Auth UID)."
        },
        "studentId": {
          "type": "string",
          "description": "A formatted, sequential student ID (e.g., SS-2024-0001). This is the official, human-readable student identification number.",
          "pattern": "^SS-\\d{4}-\\d{4}$"
        },
        "firstName": {
          "type": "string",
          "description": "First name of the student."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the student."
        },
        "email": {
          "type": "string",
          "description": "Email address of the student.",
          "format": "email"
        },
        "classId": {
          "type": "string",
          "description": "The ID of the class the student is assigned to."
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "description": "Date of birth of the student."
        },
        "gender": {
          "type": "string",
          "description": "Gender of the student."
        },
        "address": {
          "type": "string",
          "description": "Home address of the student."
        },
        "enrollmentStatus": {
          "type": "string",
          "enum": [
            "Active",
            "Graduated"
          ],
          "description": "The student's current enrollment status."
        },
        "graduationYear": {
          "type": "number",
          "description": "The year the student graduated."
        },
        "alumniDetails": {
          "type": "object",
          "description": "Details for graduated students.",
          "properties": {
            "currentOccupation": {
              "type": "string"
            },
            "employer": {
              "type": "string"
            },
            "mentorshipWillingness": {
              "type": "boolean"
            }
          }
        },
        "profilePictureUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL of the student's profile picture."
        },
        "transportBillingModel": {
          "type": "string",
          "enum": ["Daily", "Termly"],
          "description": "Specifies how the student should be billed for transport."
        }
      },
      "required": [
        "uid",
        "studentId",
        "firstName",
        "lastName",
        "email",
        "classId"
      ]
    },
    "Parent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Parent",
      "type": "object",
      "description": "Represents a parent or guardian of a student.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier for the parent (matches Firebase Auth UID)."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the parent."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the parent."
        },
        "email": {
          "type": "string",
          "description": "Email address of the parent.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the parent."
        },
        "studentIds": {
          "type": "array",
          "description": "A list of UIDs for the students associated with this parent.",
          "items": {
            "type": "string"
          }
        },
        "address": {
          "type": "string",
          "description": "Home address of the parent."
        },
        "profilePictureUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL of the parent's profile picture."
        }
      },
      "required": [
        "uid",
        "firstName",
        "lastName",
        "email"
      ]
    },
    "Class": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Class",
      "type": "object",
      "description": "Represents a class in the school.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the class (e.g., Grade 5A, Grade 10B)."
        },
        "description": {
          "type": "string",
          "description": "A brief description of the class."
        },
        "teacherId": {
          "type": "string",
          "description": "The UID of the teacher assigned to this class."
        },
        "studentIds": {
          "type": "array",
          "description": "An array of student UIDs enrolled in this class.",
          "items": {
            "type": "string"
          }
        },
        "capacity": {
            "type": "number",
            "description": "The maximum number of students the class can hold."
        }
      },
      "required": [
        "name"
      ]
    },
    "Assignment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Assignment",
      "type": "object",
      "description": "Represents an assignment created by a teacher for a class.",
      "properties": {
        "classId": {
          "type": "string",
          "description": "ID of the class this assignment is for."
        },
        "teacherId": {
          "type": "string",
          "description": "UID of the teacher who created the assignment."
        },
        "title": {
          "type": "string",
          "description": "Title of the assignment."
        },
        "description": {
          "type": "string",
          "description": "Instructions for the assignment."
        },
        "dueDate": {
          "type": "string",
          "format": "date-time",
          "description": "When the assignment is due."
        },
        "gradingType": {
          "type": "string",
          "enum": [
            "points",
            "letter",
            "pass_fail",
            "standards"
          ]
        },
        "attachments": {
          "type": "string",
          "description": "URL to any attachments for the assignment."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "classId",
        "teacherId",
        "title",
        "description",
        "dueDate",
        "gradingType",
        "createdAt"
      ]
    },
    "StudentSubmission": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StudentSubmission",
      "type": "object",
      "description": "Represents a student's submission for an assignment.",
      "properties": {
        "assignmentId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "studentName": {
          "type": "string"
        },
        "submissionType": {
          "type": "string",
          "enum": [
            "file",
            "text"
          ]
        },
        "content": {
          "type": "string",
          "description": "URL for file, or text content for text submission."
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "Submitted",
            "Late",
            "Graded"
          ]
        },
        "grade": {
          "type": "string"
        },
        "teacherFeedback": {
          "type": "string"
        }
      },
      "required": [
        "assignmentId",
        "studentId",
        "studentName",
        "submissionType",
        "content",
        "submittedAt",
        "status"
      ]
    },
    "Quiz": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Quiz",
      "type": "object",
      "description": "Represents an AI-generated quiz for a class.",
      "properties": {
        "classId": {
          "type": "string"
        },
        "teacherId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "questionText": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } },
              "correctAnswer": { "type": "string" }
            },
            "required": ["questionText", "options", "correctAnswer"]
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "classId",
        "teacherId",
        "title",
        "topic",
        "questions",
        "createdAt"
      ]
    },
    "QuizAttempt": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "QuizAttempt",
      "type": "object",
      "description": "Represents a student's attempt at a quiz.",
      "properties": {
        "quizId": { "type": "string" },
        "studentId": { "type": "string" },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["quizId", "studentId", "score", "total", "completedAt"]
    },
    "ReportCard": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "ReportCard",
        "type": "object",
        "description": "Represents the overall status and summary of a student's report card for a specific term.",
        "properties": {
            "studentId": { "type": "string" },
            "classId": { "type": "string" },
            "academicYear": { "type": "string" },
            "term": { "type": "string" },
            "status": { "type": "string", "enum": ["Draft", "AwaitingFinalApproval", "Published"] },
            "generalComment": { "type": "string" },
            "publishedAt": { "type": "string", "format": "date-time" },
            "finalGrade": { "type": "string" },
            "finalPercentage": { "type": "number" }
        },
        "required": ["studentId", "classId", "academicYear", "term", "status"]
    },
    "ReportCardComment": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "ReportCardComment",
        "type": "object",
        "description": "Represents a teacher's comment for a specific subject on a student's report card.",
        "properties": {
            "studentId": { "type": "string" },
            "subjectId": { "type": "string" },
            "comment": { "type": "string" },
            "teacherId": { "type": "string" },
            "term": { "type": "string" },
            "academicYear": { "type": "string" },
            "createdAt": { "type": "string", "format": "date-time" },
            "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["studentId", "subjectId", "comment", "teacherId", "term", "academicYear"]
    },
    "Subject": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Subject",
      "type": "object",
      "description": "Represents a school subject.",
      "properties": {
        "name": { "type": "string" },
        "teacherIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name"]
    },
    "Room": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Room",
      "type": "object",
      "description": "Represents a physical room in the school.",
      "properties": {
        "name": { "type": "string" },
        "capacity": { "type": "number" }
      },
      "required": ["name"]
    },
    "TimeSlot": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TimeSlot",
      "type": "object",
      "description": "Represents a time slot in the school day.",
      "properties": {
        "day": { "type": "string", "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]},
        "startTime": { "type": "string", "format": "time" },
        "endTime": { "type": "string", "format": "time" }
      },
      "required": ["day", "startTime", "endTime"]
    },
    "TimetableEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TimetableEntry",
      "type": "object",
      "description": "Represents a single entry in the school timetable.",
      "properties": {
        "classId": { "type": "string" },
        "subjectId": { "type": "string" },
        "teacherId": { "type": "string" },
        "roomId": { "type": "string" },
        "day": { "type": "string" },
        "timeSlotId": { "type": "string" }
      },
      "required": ["classId", "subjectId", "teacherId", "roomId", "day", "timeSlotId"]
    },
    "Resource": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Resource",
      "type": "object",
      "description": "Represents a learning resource for a course.",
      "properties": {
        "title": { "type": "string", "description": "The name of the resource." },
        "courseName": { "type": "string", "description": "The name of the course this resource belongs to." },
        "resourceType": { "type": "string", "enum": ["Document", "Video", "Presentation", "Link"] },
        "url": { "type": "string", "format": "uri", "description": "The URL pointing to the resource." }
      },
      "required": ["title", "courseName", "resourceType", "url"]
    },
    "LessonPlan": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LessonPlan",
      "type": "object",
      "description": "Represents a teacher's lesson plan for a specific class on a specific date.",
      "properties": {
        "teacherId": {
          "type": "string",
          "description": "The UID of the teacher who created the lesson plan."
        },
        "classId": {
          "type": "string",
          "description": "ID of the class this lesson plan is for."
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "The date the lesson will take take place."
        },
        "topic": {
          "type": "string",
          "description": "The main topic or title of the lesson."
        },
        "objectives": {
          "type": "string",
          "description": "The learning objectives for the lesson."
        },
        "activities": {
          "type": "string",
          "description": "The activities planned for the lesson."
        },
        "materials": {
          "type": "string",
          "description": "A list of materials and resources needed for the lesson."
        },
        "notes": {
          "type": "string",
          "description": "Private notes or reflections for the teacher."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "teacherId",
        "classId",
        "date",
        "topic",
        "objectives",
        "activities",
        "materials"
      ]
    },
     "LibraryItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LibraryItem",
      "type": "object",
      "description": "Represents an item in the school library.",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["Book", "Magazine", "DVD", "Other"] },
        "quantity": { "type": "number" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["Available", "Requested", "Borrowed", "Pending Return"] },
        "currentHolderId": { "type": "string" },
        "currentHolderName": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" },
        "author": { "type": "string" },
        "isbn": { "type": "string" },
        "publisher": { "type": "string" },
        "unitPrice": { "type": "number" },
        "purchaseDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "quantity", "location", "status"]
    },
    "AdmissionApplication": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "AdmissionApplication",
        "type": "object",
        "description": "Stores a parent's application for a student's admission.",
        "properties": {
            "applicationId": { "type": "string", "description": "A user-friendly, unique ID for the application." },
            "status": { "type": "string", "enum": ["Pending Review", "Admitted", "Rejected"] },
            "submittedByParentId": { "type": "string" },
            "submittedAt": { "type": "string", "format": "date-time" },
            "rejectionReason": { "type": "string" },
            "challengeNotes": { "type": "string" },
            "assessmentTestScore": { "type": "number" },
            "assessmentInterviewNotes": { "type": "string" },
            "adminFeedback": { "type": "string" },
            "student": { 
                "type": "object",
                "properties": {
                    "fullName": { "type": "string" }, "dateOfBirth": { "type": "string", "format": "date" }, "gender": { "type": "string" }, "phone": { "type": "string" }, "email": { "type": "string", "format": "email" }, "address": { "type": "string" }, "previousSchool": { "type": "string" }, "desiredGrade": { "type": "string" }
                }
            },
            "parent1": { 
                "type": "object",
                "properties": {
                    "name": { "type": "string" }, "relationship": { "type": "string" }, "phone": { "type": "string" }, "email": { "type": "string", "format": "email" }, "address": { "type": "string" }
                }
            },
            "parent2": { 
                "type": "object",
                "properties": {
                    "name": { "type": "string" }, "relationship": { "type": "string" }, "phone": { "type": "string" }, "email": { "type": "string", "format": "email" }, "address": { "type": "string" }
                }
            },
            "emergencyContact": { 
                "type": "object",
                "properties": {
                    "name": { "type": "string" }, "relationship": { "type": "string" }, "phone": { "type": "string" }
                }
            },
            "medical": { 
                "type": "object",
                "properties": {
                    "allergies": { "type": "string" }, "conditions": { "type": "string" }, "physicianName": { "type": "string" }, "physicianPhone": { "type": "string" }
                }
            }
        },
        "required": ["applicationId", "status", "submittedByParentId", "submittedAt", "student", "parent1", "emergencyContact"]
    },
    "LeaveRequest": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "LeaveRequest",
        "type": "object",
        "description": "Represents a staff member's request for time off.",
        "properties": {
            "staffId": { "type": "string" },
            "staffName": { "type": "string" },
            "leaveType": { "type": "string", "enum": ["Sick Leave", "Vacation", "Personal", "Study Leave", "Unpaid Leave"] },
            "startDate": { "type": "string", "format": "date" },
            "endDate": { "type": "string", "format": "date" },
            "reason": { "type": "string" },
            "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
            "approverId": { "type": "string" },
            "approverName": { "type": "string" },
            "approverNotes": { "type": "string" },
            "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["staffId", "staffName", "leaveType", "startDate", "endDate", "reason", "status", "createdAt"]
    },
    "PublicHoliday": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "PublicHoliday",
        "type": "object",
        "description": "Represents a public holiday recognized by the school.",
        "properties": {
            "name": { "type": "string" },
            "date": { "type": "string", "format": "date" }
        },
        "required": ["name", "date"]
    },
    "PerformanceReview": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PerformanceReview",
      "type": "object",
      "description": "Represents a performance review for a staff member.",
      "properties": {
        "staffId": { "type": "string" },
        "reviewerId": { "type": "string" },
        "reviewerName": { "type": "string" },
        "reviewDate": { "type": "string", "format": "date" },
        "rating": { "type": "number" },
        "strengths": { "type": "string" },
        "improvementAreas": { "type": "string" },
        "goals": { "type": "string" },
        "staffComments": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["staffId", "reviewerId", "reviewDate", "rating", "strengths", "improvementAreas", "goals"]
    },
    "FinancialRecord": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FinancialRecord",
      "type": "object",
      "description": "Represents a single financial record for a student, such as an invoice for tuition or a fine.",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string", "description": "Denormalized for easy display." },
        "classId": { "type": "string" },
        "type": { "type": "string", "enum": ["Tuition Fee", "Library Fine", "Lab Fee", "Sports Fee", "Other"] },
        "description": { "type": "string" },
        "billedAmount": { "type": "number" },
        "amountPaid": { "type": "number", "default": 0 },
        "waiverAmount": { "type": "number", "default": 0 },
        "waiverReason": { "type": "string" },
        "status": { "type": "string", "enum": ["Paid", "Unpaid", "Overdue"] },
        "dueDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentName", "type", "description", "billedAmount", "status", "dueDate", "createdAt"]
    },
    "PayrollSettings": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PayrollSettings",
      "type": "object",
      "description": "Global settings for payroll processing, including tax and statutory contribution rates.",
      "properties": {
        "ssnitEmployeeContributionRate": { "type": "number" },
        "ssnitEmployerContributionRate": { "type": "number" },
        "payeeBrackets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "number" },
              "to": { "type": "number" },
              "rate": { "type": "number" }
            },
            "required": ["from", "rate"]
          }
        }
      },
      "required": ["ssnitEmployeeContributionRate", "ssnitEmployerContributionRate", "payeeBrackets"]
    },
    "StaffPayrollConfig": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StaffPayrollConfig",
      "type": "object",
      "description": "Individual payroll configuration for a staff member.",
      "properties": {
        "basicSalary": { "type": "number" },
        "allowances": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string" }, "amount": { "type": "number" } },
            "required": ["name", "amount"]
          }
        },
        "deductions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string" }, "amount": { "type": "number" } },
            "required": ["name", "amount"]
          }
        },
        "ssnitNumber": { "type": "string" },
        "tinNumber": { "type": "string" },
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" }
      },
      "required": ["basicSalary", "ssnitNumber", "tinNumber", "bankName", "accountNumber"]
    },
    "PayrollRecord": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PayrollRecord",
      "type": "object",
      "description": "A record of a single payroll transaction for a staff member for a specific period.",
      "properties": {
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "period": { "type": "string", "description": "The payroll period, e.g., '2024-07'." },
        "grossSalary": { "type": "number" },
        "netSalary": { "type": "number" },
        "basicSalary": { "type": "number" },
        "totalAllowances": { "type": "number" },
        "totalDeductions": { "type": "number" },
        "allowances": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string" }, "amount": { "type": "number" } }
          }
        },
        "deductions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string" }, "amount": { "type": "number" } }
          }
        },
        "statutory": {
          "type": "object",
          "properties": {
            "ssnitEmployee": { "type": "number" },
            "ssnitEmployer": { "type": "number" },
            "paye": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["staffId", "staffName", "period", "grossSalary", "netSalary"]
    },
    "Vendor": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Vendor",
      "type": "object",
      "description": "Represents a school supplier or vendor.",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" }
      },
      "required": ["name", "category", "email", "phone"]
    },
    "AccountsPayableRecord": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AccountsPayableRecord",
      "type": "object",
      "description": "Represents a single bill from a vendor.",
      "properties": {
        "vendorId": { "type": "string" },
        "expenseAccountId": { "type": "string" },
        "description": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "amount": { "type": "number" },
        "dueDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Unpaid", "Paid"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "paidAt": { "type": "string", "format": "date-time" },
        "paymentAccountId": { "type": "string" }
      },
      "required": ["vendorId", "expenseAccountId", "description", "amount", "dueDate", "status"]
    },
     "AuditLog": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AuditLog",
      "type": "object",
      "description": "Represents a single entry in the system's audit log, tracking user actions.",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user who performed the action." },
        "userName": { "type": "string", "description": "The name of the user who performed the action." },
        "action": { "type": "string", "description": "A short, machine-readable code for the action (e.g., 'CREATE_STUDENT')." },
        "details": { "type": "string", "description": "A human-readable description of the action (e.g., 'Created student John Doe')." },
        "targetId": { "type": "string", "description": "The ID of the document or entity that was affected by the action." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the action occurred." }
      },
      "required": ["userId", "userName", "action", "details", "timestamp"]
    },
    "InventoryItem": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "InventoryItem",
        "type": "object",
        "description": "Represents a physical asset or supply item in the school inventory.",
        "properties": {
            "name": { "type": "string" },
            "category": { "type": "string", "enum": ["IT Equipment", "Furniture", "Office Supplies", "Lab Equipment", "Sports Gear", "Other"] },
            "quantity": { "type": "integer" },
            "location": { "type": "string" },
            "status": { "type": "string", "enum": ["Available", "In Use", "Under Maintenance", "Out of Stock"] },
            "unitPrice": { "type": "number" },
            "condition": { "type": "string", "enum": ["New", "Good", "Fair", "Poor", "For Repair"] },
            "schoolId": { "type": "string" }
        },
        "required": ["name", "category", "quantity", "status", "schoolId"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/announcements_v2/{announcementId}",
        "definition": {
          "entityName": "Announcement",
          "schema": {
            "$ref": "#/backend/entities/Announcement"
          },
          "description": "Stores official school-wide announcements. Managed by administrators.",
          "params": [{ "name": "announcementId" }]
        }
      },
      {
        "path": "/staff/{staffId}",
        "definition": {
          "entityName": "Staff",
          "schema": {
            "$ref": "#/backend/entities/Staff"
          },
          "description": "Stores staff member profiles, including a denormalized `role` for authorization.",
          "params": [
            {
              "name": "staffId",
              "description": "Unique identifier for the staff member, matching their Firebase Auth UID."
            }
          ]
        }
      },
      {
        "path": "/students/{studentId}",
        "definition": {
          "entityName": "Student",
          "schema": {
            "$ref": "#/backend/entities/Student"
          },
          "description": "Stores student profiles. Managed by administrators and directors.",
          "params": [
            {
              "name": "studentId",
              "description": "Unique identifier for the student, matching their Firebase Auth UID."
            }
          ]
        }
      },
      {
        "path": "/parents/{parentId}",
        "definition": {
          "entityName": "Parent",
          "schema": {
            "$ref": "#/backend/entities/Parent"
          },
          "description": "Stores parent profiles. Managed by administrators and directors.",
          "params": [
            {
              "name": "parentId",
              "description": "Unique identifier for the parent, matching their Firebase Auth UID."
            }
          ]
        }
      },
      {
        "path": "/classes/{classId}",
        "definition": {
          "entityName": "Class",
          "schema": {
            "$ref": "#/backend/entities/Class"
          },
          "description": "Stores class information. Managed by administrators and directors.",
          "params": [
            {
              "name": "classId",
              "description": "Unique identifier for the class."
            }
          ]
        }
      },
      {
        "path": "/inventory/{itemId}",
        "definition": {
          "entityName": "InventoryItem",
          "schema": {
            "$ref": "#/backend/entities/InventoryItem"
          },
          "description": "Stores physical assets and supplies.",
          "params": [
            {
              "name": "itemId",
              "description": "Unique identifier for the inventory item."
            }
          ]
        }
      }
    ],
    "reasoning": "This design prioritizes role-based access control and organizational efficiency for the school management system. By explicitly defining entities for personnel (Staff, Students, Parents), academic structures (Classes), and operational assets (Inventory), the system ensures data integrity and supports complex queries required for administrative dashboards."
  }
}
