{
  "entities": {
    "Staff": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Staff",
      "type": "object",
      "description": "Represents a staff member in the school system.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier for the staff member (matches Firebase Auth UID)."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the staff member."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the staff member."
        },
        "email": {
          "type": "string",
          "description": "Email address of the staff member.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the staff member."
        },
        "role": {
          "type": "string",
          "description": "The assigned role of the staff member."
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "description": "Date of birth of the staff member."
        },
        "gender": {
          "type": "string",
          "description": "Gender of the staff member."
        },
        "nationality": {
          "type": "string",
          "description": "Nationality of the staff member."
        },
        "address": {
          "type": "string",
          "description": "Home address of the staff member."
        }
      },
      "required": [
        "uid",
        "firstName",
        "lastName",
        "email",
        "role"
      ]
    },
    "Role": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Role",
      "type": "object",
      "description": "Defines the role of a user within the school system, determining their access privileges.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the role."
        },
        "name": {
          "type": "string",
          "description": "Name of the role (e.g., Administrator, Teacher, Student)."
        },
        "description": {
          "type": "string",
          "description": "Description of the role and its responsibilities."
        },
        "permissions": {
          "type": "array",
          "description": "List of permissions associated with this role.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ]
    },
    "Student": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Student",
      "type": "object",
      "description": "Represents a student in the school system.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier for the student (matches Firebase Auth UID)."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the student."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the student."
        },
        "email": {
          "type": "string",
          "description": "Email address of the student.",
          "format": "email"
        },
        "classId": {
          "type": "string",
          "description": "The ID of the class the student is assigned to."
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "description": "Date of birth of the student."
        },
        "gender": {
          "type": "string",
          "description": "Gender of the student."
        },
        "address": {
          "type": "string",
          "description": "Home address of the student."
        }
      },
      "required": [
        "uid",
        "firstName",
        "lastName",
        "email",
        "classId"
      ]
    },
    "Parent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Parent",
      "type": "object",
      "description": "Represents a parent or guardian of a student.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier for the parent (matches Firebase Auth UID)."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the parent."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the parent."
        },
        "email": {
          "type": "string",
          "description": "Email address of the parent.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the parent."
        },
        "studentIds": {
          "type": "array",
          "description": "A list of UIDs for the students associated with this parent.",
          "items": {
            "type": "string"
          }
        },
        "address": {
          "type": "string",
          "description": "Home address of the parent."
        }
      },
      "required": [
        "uid",
        "firstName",
        "lastName",
        "email"
      ]
    },
    "Class": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Class",
      "type": "object",
      "description": "Represents a class in the school.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the class (e.g., Grade 5A, Grade 10B)."
        },
        "description": {
          "type": "string",
          "description": "A brief description of the class."
        },
        "teacherId": {
          "type": "string",
          "description": "The UID of the teacher assigned to this class."
        },
        "studentIds": {
          "type": "array",
          "description": "An array of student UIDs enrolled in this class.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "Assignment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Assignment",
      "type": "object",
      "description": "Represents an assignment created by a teacher for a class.",
      "properties": {
        "classId": {
          "type": "string",
          "description": "ID of the class this assignment is for."
        },
        "teacherId": {
          "type": "string",
          "description": "UID of the teacher who created the assignment."
        },
        "title": {
          "type": "string",
          "description": "Title of the assignment."
        },
        "description": {
          "type": "string",
          "description": "Instructions for the assignment."
        },
        "dueDate": {
          "type": "string",
          "format": "date-time",
          "description": "When the assignment is due."
        },
        "gradingType": {
          "type": "string",
          "enum": [
            "points",
            "letter",
            "pass_fail",
            "standards"
          ]
        },
        "attachments": {
          "type": "string",
          "description": "URL to any attachments for the assignment."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "classId",
        "teacherId",
        "title",
        "description",
        "dueDate",
        "gradingType",
        "createdAt"
      ]
    },
    "StudentSubmission": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StudentSubmission",
      "type": "object",
      "description": "Represents a student's submission for an assignment.",
      "properties": {
        "assignmentId": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "studentName": {
          "type": "string"
        },
        "submissionType": {
          "type": "string",
          "enum": [
            "file",
            "text"
          ]
        },
        "content": {
          "type": "string",
          "description": "URL for file, or text content for text submission."
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "Submitted",
            "Late",
            "Graded"
          ]
        },
        "grade": {
          "type": "string"
        },
        "teacherFeedback": {
          "type": "string"
        }
      },
      "required": [
        "assignmentId",
        "studentId",
        "studentName",
        "submissionType",
        "content",
        "submittedAt",
        "status"
      ]
    },
    "Quiz": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Quiz",
      "type": "object",
      "description": "Represents an AI-generated quiz for a class.",
      "properties": {
        "classId": {
          "type": "string"
        },
        "teacherId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "questionText": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } },
              "correctAnswer": { "type": "string" }
            },
            "required": ["questionText", "options", "correctAnswer"]
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "classId",
        "teacherId",
        "title",
        "topic",
        "questions",
        "createdAt"
      ]
    },
    "QuizAttempt": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "QuizAttempt",
      "type": "object",
      "description": "Represents a student's attempt at a quiz.",
      "properties": {
        "quizId": { "type": "string" },
        "studentId": { "type": "string" },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["quizId", "studentId", "score", "total", "completedAt"]
    },
    "ReportCard": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "ReportCard",
        "type": "object",
        "description": "Represents the overall status and summary of a student's report card for a specific term.",
        "properties": {
            "studentId": { "type": "string" },
            "classId": { "type": "string" },
            "academicYear": { "type": "string" },
            "term": { "type": "string" },
            "status": { "type": "string", "enum": ["Draft", "AwaitingFinalApproval", "Published"] },
            "generalComment": { "type": "string" },
            "publishedAt": { "type": "string", "format": "date-time" },
            "finalGrade": { "type": "string" },
            "finalPercentage": { "type": "number" }
        },
        "required": ["studentId", "classId", "academicYear", "term", "status"]
    },
    "ReportCardComment": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "ReportCardComment",
        "type": "object",
        "description": "Represents a teacher's comment for a specific subject on a student's report card.",
        "properties": {
            "studentId": { "type": "string" },
            "subjectId": { "type": "string" },
            "comment": { "type": "string" },
            "teacherId": { "type": "string" },
            "term": { "type": "string" },
            "academicYear": { "type": "string" },
            "createdAt": { "type": "string", "format": "date-time" },
            "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["studentId", "subjectId", "comment", "teacherId", "term", "academicYear"]
    },
    "Subject": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Subject",
      "type": "object",
      "description": "Represents a school subject.",
      "properties": {
        "name": { "type": "string" },
        "teacherIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name"]
    },
    "Room": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Room",
      "type": "object",
      "description": "Represents a physical room in the school.",
      "properties": {
        "name": { "type": "string" },
        "capacity": { "type": "number" }
      },
      "required": ["name"]
    },
    "TimeSlot": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TimeSlot",
      "type": "object",
      "description": "Represents a time slot in the school day.",
      "properties": {
        "day": { "type": "string", "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]},
        "startTime": { "type": "string", "format": "time" },
        "endTime": { "type": "string", "format": "time" }
      },
      "required": ["day", "startTime", "endTime"]
    },
    "TimetableEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TimetableEntry",
      "type": "object",
      "description": "Represents a single entry in the school timetable.",
      "properties": {
        "classId": { "type": "string" },
        "subjectId": { "type": "string" },
        "teacherId": { "type": "string" },
        "roomId": { "type": "string" },
        "day": { "type": "string" },
        "timeSlotId": { "type": "string" }
      },
      "required": ["classId", "subjectId", "teacherId", "roomId", "day", "timeSlotId"]
    },
    "Resource": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Resource",
      "type": "object",
      "description": "Represents a learning resource for a course.",
      "properties": {
        "title": { "type": "string", "description": "The name of the resource." },
        "courseName": { "type": "string", "description": "The name of the course this resource belongs to." },
        "resourceType": { "type": "string", "enum": ["Document", "Video", "Presentation", "Link"] },
        "url": { "type": "string", "format": "uri", "description": "The URL pointing to the resource." }
      },
      "required": ["title", "courseName", "resourceType", "url"]
    },
    "LessonPlan": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LessonPlan",
      "type": "object",
      "description": "Represents a teacher's lesson plan for a specific class on a specific date.",
      "properties": {
        "teacherId": {
          "type": "string",
          "description": "The UID of the teacher who created the lesson plan."
        },
        "classId": {
          "type": "string",
          "description": "ID of the class this lesson plan is for."
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "The date the lesson will take place."
        },
        "topic": {
          "type": "string",
          "description": "The main topic or title of the lesson."
        },
        "objectives": {
          "type": "string",
          "description": "The learning objectives for the lesson."
        },
        "activities": {
          "type": "string",
          "description": "The activities planned for the lesson."
        },
        "materials": {
          "type": "string",
          "description": "A list of materials and resources needed for the lesson."
        },
        "notes": {
          "type": "string",
          "description": "Private notes or reflections for the teacher."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "teacherId",
        "classId",
        "date",
        "topic",
        "objectives",
        "activities",
        "materials"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/roles/{roleId}",
        "definition": {
          "entityName": "Role",
          "schema": {
            "$ref": "#/backend/entities/Role"
          },
          "description": "Stores the roles of the campusconnect system. Roles are assigned to staff members, determining their access privileges. An administrator or director can add a staff member and assign them to a role such that they can access features relating to their role when they log in.",
          "params": [
            {
              "name": "roleId",
              "description": "Unique identifier for the role."
            }
          ]
        }
      },
      {
        "path": "/staff/{staffId}",
        "definition": {
          "entityName": "Staff",
          "schema": {
            "$ref": "#/backend/entities/Staff"
          },
          "description": "Stores staff member profiles, including a denormalized `role` for authorization. An administrator or director can add a staff member and assign them to a role such that they can access features relating to their role when they log in.",
          "params": [
            {
              "name": "staffId",
              "description": "Unique identifier for the staff member, matching their Firebase Auth UID."
            }
          ]
        }
      },
      {
        "path": "/roles_admin/{uid}",
        "definition": {
          "entityName": "admin",
          "schema": {
            "$ref": "#/backend/entities/Role"
          },
          "description": "Documents in this collection denote administrative privileges. Existence of a document with a user's UID grants admin access.",
          "params": [
            {
              "name": "uid",
              "description": "The Firebase UID of the user with admin privileges."
            }
          ]
        }
      },
      {
        "path": "/students/{studentId}",
        "definition": {
          "entityName": "Student",
          "schema": {
            "$ref": "#/backend/entities/Student"
          },
          "description": "Stores student profiles. Managed by administrators and directors.",
          "params": [
            {
              "name": "studentId",
              "description": "Unique identifier for the student, matching their Firebase Auth UID."
            }
          ]
        }
      },
      {
        "path": "/parents/{parentId}",
        "definition": {
          "entityName": "Parent",
          "schema": {
            "$ref": "#/backend/entities/Parent"
          },
          "description": "Stores parent profiles. Managed by administrators and directors.",
          "params": [
            {
              "name": "parentId",
              "description": "Unique identifier for the parent, matching their Firebase Auth UID."
            }
          ]
        }
      },
      {
        "path": "/classes/{classId}",
        "definition": {
          "entityName": "Class",
          "schema": {
            "$ref": "#/backend/entities/Class"
          },
          "description": "Stores class information. Managed by administrators and directors.",
          "params": [
            {
              "name": "classId",
              "description": "Unique identifier for the class."
            }
          ]
        }
      },
      {
        "path": "/assignments/{assignmentId}",
        "definition": {
          "entityName": "Assignment",
          "schema": { "$ref": "#/backend/entities/Assignment" },
          "description": "Stores assignments created by teachers.",
          "params": [{ "name": "assignmentId" }]
        }
      },
      {
        "path": "/assignments/{assignmentId}/submissions/{submissionId}",
        "definition": {
          "entityName": "StudentSubmission",
          "schema": { "$ref": "#/backend/entities/StudentSubmission" },
          "description": "Stores student submissions for assignments.",
          "params": [{ "name": "assignmentId" }, { "name": "submissionId" }]
        }
      },
      {
        "path": "/quizzes/{quizId}",
        "definition": {
          "entityName": "Quiz",
          "schema": { "$ref": "#/backend/entities/Quiz" },
          "description": "Stores AI-generated quizzes created by teachers.",
          "params": [{ "name": "quizId" }]
        }
      },
      {
        "path": "/quizzes/{quizId}/attempts/{attemptId}",
        "definition": {
          "entityName": "QuizAttempt",
          "schema": { "$ref": "#/backend/entities/QuizAttempt" },
          "description": "Stores student attempts for quizzes.",
          "params": [{ "name": "quizId" }, { "name": "attemptId" }]
        }
      },
      {
        "path": "/report-cards/{reportCardId}",
        "definition": {
          "entityName": "ReportCard",
          "schema": { "$ref": "#/backend/entities/ReportCard" },
          "description": "Stores the overall status and summary for a student's report card.",
          "params": [{ "name": "reportCardId" }]
        }
      },
      {
        "path": "/report-cards/{reportCardId}/comments/{commentId}",
        "definition": {
          "entityName": "ReportCardComment",
          "schema": { "$ref": "#/backend/entities/ReportCardComment" },
          "description": "Stores teacher comments for specific subjects on a report card.",
          "params": [{ "name": "reportCardId" }, { "name": "commentId" }]
        }
      },
      {
        "path": "/subjects/{subjectId}",
        "definition": {
          "entityName": "Subject",
          "schema": { "$ref": "#/backend/entities/Subject" },
          "description": "Stores school subjects.",
          "params": [{ "name": "subjectId" }]
        }
      },
      {
        "path": "/rooms/{roomId}",
        "definition": {
          "entityName": "Room",
          "schema": { "$ref": "#/backend/entities/Room" },
          "description": "Stores school rooms.",
          "params": [{ "name": "roomId" }]
        }
      },
      {
        "path": "/timeSlots/{timeSlotId}",
        "definition": {
          "entityName": "TimeSlot",
          "schema": { "$ref": "#/backend/entities/TimeSlot" },
          "description": "Stores time slots for the school day.",
          "params": [{ "name": "timeSlotId" }]
        }
      },
      {
        "path": "/timetables/{timetableEntryId}",
        "definition": {
          "entityName": "TimetableEntry",
          "schema": { "$ref": "#/backend/entities/TimetableEntry" },
          "description": "Stores individual timetable entries.",
          "params": [{ "name": "timetableEntryId" }]
        }
      },
      {
        "path": "/resources/{resourceId}",
        "definition": {
          "entityName": "Resource",
          "schema": { "$ref": "#/backend/entities/Resource" },
          "description": "Stores learning resources for courses.",
          "params": [{ "name": "resourceId" }]
        }
      },
      {
        "path": "/lesson-plans/{lessonPlanId}",
        "definition": {
          "entityName": "LessonPlan",
          "schema": { "$ref": "#/backend/entities/LessonPlan" },
          "description": "Stores teachers' lesson plans for their classes.",
          "params": [{ "name": "lessonPlanId" }]
        }
      }
    ],
    "reasoning": "This design prioritizes role-based access control for the CampusConnect application, ensuring that Directors and Administrators can effectively manage staff roles and permissions. The structure uses dedicated collections for `roles` and `staff`, enabling straightforward security rules and efficient data retrieval. By denormalizing the `roleId` within the `/staff/{staffId}` document, authorization independence is achieved, eliminating the need for `get()` calls to the `/roles` collection during security rule evaluation. This promotes atomic operations and simplifies security rule logic. The structure also provides clear segregation, ensuring that all documents within the `staff` collection share similar security needs. Access modeling is achieved using role-based access control. The `roles` collection allows easy management of permissions, and the `staff` collection links users to specific roles. This design supports QAPs by enabling secure `list` operations on both `roles` and `staff` collections based on administrative privileges. The structure ensures the integrity of ownership and relationships. All data is consistently and predictably named to follow semantic naming conventions to maintain clarity."
  }
}
