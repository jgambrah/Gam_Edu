{"schemaVersion":1,"storyId":"rhyme-the-ball-that-rolled","version":1,"title":"The Ball That Rolled Away (a safety rhyme)","ageTiers":["3-4","5-6"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"Bounce, bounce, bounce! My ball is red.\nIt rolls away; it rolls ahead.","sentences":["Bounce, bounce, bounce!","My ball is red.","It rolls away; it rolls ahead."],"alt":"A red ball rolling out of a play area.","image":{"hash":"sha256:9b40423acad322360a194faea0dd6b24e4b69a016e64e987172a55b1ebc1eb04","width":960,"height":717},"audio":{"hash":"sha256:dcb2581a012913d8f3f5bd0b96a8f83b7b5b97a5ce5c36194f99f7d258242217","durationMs":8480,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,3481],[3481,5446],[5446,8480]],"words":[[0,982],[982,1964],[1964,3481],[3481,3660],[3660,4017],[4017,4196],[4196,5446],[5446,5625],[5625,6071],[6071,6874],[6874,7053],[7053,7499],[7499,8480]]}}},{"n":2,"text":"Stop! I stop! I do not run.\nA road is not a place for fun.","sentences":["Stop!","I stop!","I do not run.","A road is not a place for fun."],"alt":"A child holding up a hand, standing still.","image":{"hash":"sha256:59623cefb7bea61dc0969875e7cd93557a2b305d601e8b9b226a8155a95fc803","width":960,"height":717},"audio":{"hash":"sha256:d13312f2d46b9e60e3771083c2301d425f4925d613f3ec051d729abeae84f6fb","durationMs":7160,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,1294],[1294,2761],[2761,4574],[4574,7160]],"words":[[0,1294],[1294,1467],[1467,2761],[2761,2934],[2934,3107],[3107,3366],[3366,4574],[4574,4747],[4747,5092],[5092,5265],[5265,5524],[5524,5697],[5697,6128],[6128,6387],[6387,7160]]}}},{"n":3,"text":"I call out loud, “Please come and see!”\nA grown-up comes to help me.","sentences":["I call out loud, “Please come and see!”\nA grown-up comes to help me."],"alt":"A child calling an adult.","image":{"hash":"sha256:7e12cbd1a7a544a0f5e0bbd64930f088fe2142433aa36b16b473e310f311c139","width":960,"height":717},"