821],[6821,7248],[7248,7804],[7804,7911],[7911,8873],[8873,9301],[9301,9857],[9857,10178],[10178,10670],[10670,10990],[10990,11760]]}}},{"n":5,"text":"‘Listen!’ said Adjeley. They listened with their big ears. Honk! Honk! A bus was coming. ‘Wait,’ said Odarkor.","sentences":["‘Listen!’ said Adjeley.","They listened with their big ears.","Honk!","Honk!","A bus was coming.","‘Wait,’ said Odarkor."],"alt":"Two children cup their ears as a bus approaches.","image":{"hash":"sha256:8415df8040eea2b25dabddda59766bbef67af50c7a8d9cbd5d4959102886cd4e","width":960,"height":717},"audio":{"hash":"sha256:bb9cc096da9d3f682a4dd50e37f021135fc0e69ad776e171da2237d9b8d6f908","durationMs":13480,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,3004],[3004,7010],[7010,7934],[7934,8858],[8858,10938],[10938,13480]],"words":[[0,1181],[1181,1695],[1695,3004],[3004,3518],[3518,4545],[4545,5058],[5058,5700],[5700,6085],[6085,7010],[7010,7934],[7934,8858],[8858,8987],[8987,9372],[9372,9757],[9757,10938],[10938,11657],[11657,12171],[12171,13480]]}}},{"n":6,"text":"The bus went past. The road was quiet. ‘Now we can go,’ said Adjeley. They walked, they did not run, and they kept holding hands.","sentences":["The bus went past.","The road was quiet.","‘Now we can go,’ said Adjeley.","They walked, they did not run, and they kept holding hands."],"alt":"Two children walk across a zebra crossing holding hands.","image":{"hash":"sha256:b491abc9c12563d9d36b53e294eb47a39ecdfbd2b47ea3ff8c596a1bd759d25b","width":960,"height":717},"audio":{"hash":"sha256:2899059ac23c1ff397108a80df6b34fde6b25c1bdbbc661118efdb97bd717f6c","durationMs":17080,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,2586],[2586,5322],[5322,9202],[9202,17080]],"words":[[0,451],[451,902],[902,1504],[1504,2586],[2586,3037],[3037,3639],[3639,4090],[4090,5322],[5322,5774],[5774,6074],[6074,6525],[6525,7067],[7067,7668],[7668,9202],[9202,9803],[9803,10946],[10946,11547],[11547,11998],[11998,12449],[12449,13141],[13141,13592],[13592,14193],[14193,14795],[14795,15847],[15847,17080]]}}},{"n":7,"text":"They got to the other side. ‘Stop, look, listen,’ sang Odarkor. ‘Stop, look, listen!’ Adjeley smiled. ‘Well done!’","sentences":["They got to the other side.","‘Stop, look, listen,’ sang Odarkor.","‘Stop, look, listen!’ Adjeley smiled.","‘Well done!’"],"alt":"Two children sing on the pavement on the far side of the road.","image":{"hash":"sha256:cbaee29b9919534890bd6fbc2dc041d06eb0a67bb31cd36f1e6fc9d381075957","width":960,"height":717},"audio":{"hash":"sha256:1108b2a8360bcca1739c4c67d0142e3c68b167b94b985a7aefa1cf40fa7c5a51","durationMs":13640,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,3144],[3144,7431],[7431,12185],[12185,13640]],"words":[[0,520],[520,909],[909,1169],[1169,1559],[1559,2208],[2208,3144],[3144,3871],[3871,4599],[4599,5586],[5586,6106],[6106,7431],[7431,8158],[8158,8885],[8885,10081],[10081,10990],[10990,12185],[12185,12705],[12705,13640]]}}},{"n":8,"text":"Odarkor got his ice cream. ‘I always hold a grown-up’s hand,’ he said. ‘And I stop, look and listen.’ The end.","sentences":["Odarkor got his ice cream.","‘I always hold a grown-up’s hand,’ he said.","‘And I stop, look and listen.’ The end."],"alt":"A boy holds an ice cream cone and smiles beside his sister.","image":{"hash":"sha256:115c2640a37451a7dbae40a719bd15d6b7b75a83a987280caf6c6845609ed82f","width":960,"height":717},"audio":{"hash":"sha256:d48a958d3f346bc394c82ae8d23bc5ab812b6737906bc5f242f18394cf2ed9a8","durationMs":15280,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,3934],[3934,9591],[9591,15280]],"words":[[0,1138],[1138,1626],[1626,2113],[2113,2601],[2601,3934],[3934,4096],[4096,5072],[5072,5722],[5722,5884],[5884,7185],[7185,8095],[8095,8420],[8420,9591],[9591,10078],[10078,10241],[10241,11151],[11151,11801],[11801,12289],[12289,13785],[13785,14272],[14272,15280]]}}}],"activities":[{"id":