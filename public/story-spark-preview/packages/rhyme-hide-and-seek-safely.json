{"schemaVersion":1,"storyId":"rhyme-hide-and-seek-safely","version":1,"title":"Hide and Seek, Safe and Sound (a game rhyme)","ageTiers":["3-4","5-6"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"Close your eyes and count to ten.\nCount from one, then play again!","sentences":["Close your eyes and count to ten.","Count from one, then play again!"],"alt":"A child counting with eyes covered.","image":{"hash":"sha256:4a2df633495a9987b14bcbb4d213ec2d3f47da56346279c7ca3c37f9ada36715","width":960,"height":717},"audio":{"hash":"sha256:367efedba53812df67f0d57ff73c3aa97905e3e353140afb4250eaad7a50a1f4","durationMs":6800,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,3318],[3318,6800]],"words":[[0,544],[544,979],[979,1414],[1414,1741],[1741,2285],[2285,2502],[2502,3318],[3318,3862],[3862,4298],[4298,4896],[4896,5331],[5331,5766],[5766,6800]]}}},{"n":2,"text":"Stay far from wells and roads, as we learned before.\nHide behind a safe tree or a classroom door!","sentences":["Stay far from wells and roads, as we learned before.","Hide behind a safe tree or a classroom door!"],"alt":"Children hiding behind a tree and a classroom door.","image":{"hash":"sha256:1e84c3cb2115dd4ee383c980e94a48d284c2f1b44fcfe58be3013951c03e14a4","width":960,"height":717},"audio":{"hash":"sha256:1db45e6cad47496590eefe73e657b83f4aa17ee9c4969bebaa844cce9c6d6fab","durationMs":8120,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,4355],[4355,8120]],"words":[[0,363],[363,635],[635,998],[998,1452],[1452,1724],[1724,2404],[2404,2586],[2586,2767],[2767,3402],[3402,4355],[4355,4718],[4718,5262],[5262,5444],[5444,5806],[5806,6169],[6169,6351],[6351,6532],[6532,7349],[7349,8120]]}}},{"n":3,"text":"Ready or not, here I come to see:\nwho is hiding behind the tree?","sentences":["Ready or not, here I come to see:\nwho is hiding behind the tree?"],"alt":"A child searching near a tree.","image":{"hash":"sha256:acd49a317fe611ea67df