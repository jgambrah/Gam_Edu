{"schemaVersion":1,"storyId":"rhyme-hide-and-seek-safely","version":1,"title":"Hide and Seek, Safe and Sound (a game rhyme)","ageTiers":["3-4","5-6"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"Close your eyes and count to ten.\nCount from one, then play again!","sentences":["Close your eyes and count to ten.","Count from one, then play again!"],"alt":"A child counting with eyes covered.","image":{"hash":"sha256:4a2df633495a9987b14bcbb4d213ec2d3f47da56346279c7ca3c37f9ada36715","width":960,"height":717},"audio":{"hash":"sha256:367efedba53812df67f0d57ff73c3aa97905e3e353140afb4250eaad7a50a1f4","durationMs":6800,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,3447],[3447,6800]],"words":[[0,466],[466,839],[839,1212],[1212,1491],[1491,1957],[1957,2143],[2143,3447],[3447,3913],[3913,4286],[4286,5031],[5031,5404],[5404,5777],[5777,6800]]}}},{"n":2,"text":"Stay far from wells and roads, as we learned before.\nHide behind a safe tree or a classroom door!","sentences":["Stay far from wells and roads, as we learned before.","Hide behind a safe tree or a classroom door!"],"alt":"Children hiding behind a tree and a classroom door.","image":{"hash":"sha256:1e84c3cb2115dd4ee383c980e94a48d284c2f1b44fcfe58be3013951c03e14a4","width":960,"height":717},"audio":{"hash":"sha256:1db45e6cad47496590eefe73e657b83f4aa17ee9c4969bebaa844cce9c6d6fab","durationMs":8120,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,4628],[4628,8120]],"words":[[0,325],[325,569],[569,894],[894,1300],[1300,1544],[1544,2356],[2356,2518],[2518,2680],[2680,3248],[3248,4628],[4628,4953],[4953,5440],[5440,5602],[5602,5927],[5927,6252],[6252,6414],[6414,6576],[6576,7307],[7307,8120]]}}},{"n":3,"text":"Ready or not, here I come to see:\nwho is hiding behind the tree?","sentences":["Ready or not, here I come to see:\nwho is hiding behind the tree?"],"alt":"A child searching near a tree.","image":{"hash":"sha256:acd49a317fe611ea67df