{"schemaVersion":1,"storyId":"rhyme-clap-and-jump-ampe","version":1,"title":"Clap and Jump (an ampe-style game rhyme)","ageTiers":["3-4","5-6"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"Clap, clap: one, two, three!\nJump up high and then jump free.","sentences":["Clap, clap: one, two, three!","Jump up high and then jump free."],"alt":"Children clapping and jumping.","image":{"hash":"sha256:02bf651a989624d588fd4bc1a7be7cc2b3236611bda4ef2a2b55237ad7caa5ab","width":960,"height":717},"audio":{"hash":"sha256:6058b0be96b2750bf2e97d1d167edf8136f27e459cb588dc501de935b3d957a1","durationMs":7040,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,3743],[3743,7040]],"words":[[0,726],[726,1453],[1453,2067],[2067,2682],[2682,3743],[3743,4190],[4190,4414],[4414,4861],[4861,5196],[5196,5643],[5643,6090],[6090,7040]]}}},{"n":2,"text":"One foot out and one foot in.\nSmile and clap; now let us begin!","sentences":["One foot out and one foot in.","Smile and clap; now let us begin!"],"alt":"Two children facing each other with one foot forward.","image":{"hash":"sha256:c6ea854803c4c284f4a94199eccc6ab16bdad5e10a693da8c91e55b0b79d2f20","width":960,"height":717},"audio":{"hash":"sha256:edb343583e79da2655ae6b8317e7974c2c28528cd2f239a8567a785f9f3fbf98","durationMs":7840,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,3551],[3551,7840]],"words":[[0,402],[402,938],[938,1340],[1340,1742],[1742,2144],[2144,2680],[2680,3551],[3551,4222],[4222,4624],[4624,5495],[5495,5897],[5897,6299],[6299,6567],[6567,7840]]}}},{"n":3,"text":"Now it is your turn; now it is mine.\nWe take our turns, and that is fine.","sentences":["Now it is your turn; now it is mine.","We take our turns, and that is fine."],"alt":"Children taking turns in a circle.","image":{"hash":"sha256:e5a35d2998e592ff6f5535129d9048fccd75b5d0ef08f16e40f570445ee04790","width":960,"height":717},"audio":{"hash":"sha256:598479f8f05300b6895e68b72e7287a3dc3d