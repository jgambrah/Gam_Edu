{"schemaVersion":1,"storyId":"poem-kente-colours","version":1,"title":"Kente Colours (a rhyme)","ageTiers":["3-4","5-6"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"Red is the sun when it wakes up high,\nGold is the shine of the stars in the sky.","sentences":["Red is the sun when it wakes up high,\nGold is the shine of the stars in the sky."],"alt":"A big red sun and a gold-starred sky over a Ghanaian village.","image":{"hash":"sha256:0eba029544b0a2f1447e62e68fb2d94b44e3c734561932ad74e2183fb09ffe85","width":960,"height":717},"audio":{"hash":"sha256:2c20b50421dbf4f1a35e70c5f3868caeb7b9a5cbbb95caa8c484a4657866aeba","durationMs":12000,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,12000]],"words":[[0,581],[581,968],[968,1549],[1549,2130],[2130,2904],[2904,3291],[3291,4259],[4259,4646],[4646,5614],[5614,6388],[6388,6775],[6775,7356],[7356,8324],[8324,8711],[8711,9292],[9292,10260],[10260,10647],[10647,11228],[11228,12000]]}}},{"n":2,"text":"Green is the leaf on the cocoa tree,\nBlue is the water that runs to the sea.","sentences":["Green is the leaf on the cocoa tree,\nBlue is the water that runs to the sea."],"alt":"A green cocoa leaf and blue water running to the sea.","image":{"hash":"sha256:3644333771b5c6f6cb788d67d17745485e4506a0b1eb9f5ff8850d46106e6ea6","width":960,"height":717},"audio":{"hash":"sha256:f8d96b642792e99dd2931346b68f526186c519caea3fc2e2d7cc9360122fd624","durationMs":10840,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,10840]],"words":[[0,903],[903,1264],[1264,1806],[1806,2529],[2529,2890],[2890,3432],[3432,4335],[4335,5238],[5238,5961],[5961,6322],[6322,6864],[6864,7767],[7767,8490],[8490,9213],[9213,9574],[9574,10116],[10116,10840]]}}},{"n":3,"text":"Black is the night when the drums go still,\nWhite is the cloud on top of the hill.","sentences":["Black is the night when the drums go still,\nWhite is the cloud on top of the hill."],"alt":"A dark night with a quiet drum and a white cloud above a hill.","image":{"hash":"sha256:8f6daedce77f8899faab39d54e08b21e9461dacbf8e2630e9aa3ee84e0f5758b","width":960,"height":717},"audio":{"hash":"sha256:4aff89d29f0903cfa9f41aff88490bd7785a98e313f60b32e3f0ffe8d20ac6c8","durationMs":11680,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,11680]],"words":[[0,898],[898,1257],[1257,1796],[1796,2694],[2694,3413],[3413,3952],[3952,4850],[4850,5209],[5209,6287],[6287,7185],[7185,7544],[7544,8083],[8083,8981],[8981,9340],[9340,9879],[9879,10238],[10238,10777],[10777,11680]]}}},{"n":4,"text":"Weave them together, strip by strip,\nKente is colour from end to tip.","sentences":["Weave them together, strip by strip,\nKente is colour from end to tip."],"alt":"A weaver’s hands making a bright kente strip.","image":{"hash":"sha256:dc264a839156a985fe8d649b2a9b88acc6707c851aa21a88d104b64632b03c99","width":960,"height":717},"audio":{"hash":"sha256:e8aefcbb967e12abd07f479c28786b17b485bafd9d5d2e0acf14970b9a9d7f54","durationMs":12040,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,12040]],"words":[[0,1056],[1056,1901],[1901,3802],[3802,4858],[4858,5280],[5280,6547],[6547,7603],[7603,8025],[8025,9292],[9292,10137],[10137,10771],[10771,11193],[11193,12040]]}}}],"activities":[{"id":"kc-c1","type":"comprehension","afterPage":1,"question":"What colour is the sun in the rhyme?","options":["Red","Blue","Black"],"correctIndex":0},{"id":"kc-ph","type":"phonics","afterPage":2,"targetSound":"ee","prompt":"Which word rhymes with tree?","options":["sea","sun","hill"],"correctIndexes":[0]},{"id":"kc-c2","type":"comprehension","afterPage":3,"question":"Which colour is the cloud?","options":["White","Green","Red"],"correctIndex":0},{"id":"kc-sel","type":"sel","afterPage":4,"prompt":"Which colour makes you feel happy today?","feelingOptions":["Happy","Calm","Excited","Proud"]}],"glossary":[{"word":"kente","definition":"A colourful woven cloth from Ghana.","pages":[4]},{"word":"weave","definition":"To cross threads over and under each other to make cloth.","pages":[4]},{"word":"cocoa","definition":"A tree whose seeds are used to make chocolate.","pages":[2]}],"assets":{"sha256:0eba029544b0a2f1447e62e68fb2d94b44e3c734561932ad74e2183fb09ffe85":{"path":"/story-spark-preview/candidates/poem-kente-colours/page1-1.webp","bytes":124452,"type":"image/webp"},"sha256:2c20b50421dbf4f1a35e70c5f3868caeb7b9a5cbbb95caa8c484a4657866aeba":{"path":"/story-spark-preview/audio/2c20b50421db.mp3","bytes":48428,"type":"audio/mpeg"},"sha256:3644333771b5c6f6cb788d67d17745485e4506a0b1eb9f5ff8850d46106e6ea6":{"path":"/story-spark-preview/candidates/poem-kente-colours/page2-1.webp","bytes":137858,"type":"image/webp"},"sha256:f8d96b642792e99dd2931346b68f526186c519caea3fc2e2d7cc9360122fd624":{"path":"/story-spark-preview/audio/f8d96b642792.mp3","bytes":43820,"type":"audio/mpeg"},"sha256:8f6daedce77f8899faab39d54e08b21e9461dacbf8e2630e9aa3ee84e0f5758b":{"path":"/story-spark-preview/candidates/poem-kente-colours/page3-1.webp","bytes":74680,"type":"image/webp"},"sha256:4aff89d29f0903cfa9f41aff88490bd7785a98e313f60b32e3f0ffe8d20ac6c8":{"path":"/story-spark-preview/audio/4aff89d29f09.mp3","bytes":47180,"type":"audio/mpeg"},"sha256:dc264a839156a985fe8d649b2a9b88acc6707c851aa21a88d104b64632b03c99":{"path":"/story-spark-preview/candidates/poem-kente-colours/page4-1.webp","bytes":138536,"type":"image/webp"},"sha256:e8aefcbb967e12abd07f479c28786b17b485bafd9d5d2e0acf14970b9a9d7f54":{"path":"/story-spark-preview/audio/e8aefcbb967e.mp3","bytes":48620,"type":"audio/mpeg"}},"contentHash":"sha256:b9bfa65532da1e04e41a94bb04d9b0ad290d8f4c7cc914b6e428096819f4e2d7"}