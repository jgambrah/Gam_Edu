{"schemaVersion":1,"storyId":"rhyme-pull-together","version":1,"title":"Pull Together (a tug-of-war chant)","ageTiers":["5-6","7-8","9-10"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"Heave, heave, pull the rope.\nPull together, and keep up hope!","sentences":["Heave, heave, pull the rope.","Pull together, and keep up hope!"],"alt":"Two teams pulling a rope.","image":{"hash":"sha256:f6ad87f3d395d44da1b937b0a4e07b903125a8dc5a9abeefa48cda78d0c3e874","width":960,"height":717},"audio":{"hash":"sha256:25fd899f9922c1c1eca48c6f262eace648441e2550ca0f6b7800b7720e5262e0","durationMs":7320,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,3572],[3572,7320]],"words":[[0,878],[878,1757],[1757,2225],[2225,2577],[2577,3572],[3572,4041],[4041,5270],[5270,5622],[5622,6090],[6090,6324],[6324,7320]]}}},{"n":2,"text":"One for all and all for one!\nPull, pull, until we are done.","sentences":["One for all and all for one!","Pull, pull, until we are done."],"alt":"Children leaning back with all their strength.","image":{"hash":"sha256:9b3cd8bfd565e8be69ddee7e40f701f106098e42aba98995b915b36c2b1bc460","width":960,"height":717},"audio":{"hash":"sha256:1cf23e40c6ff2407712a3488af9f1ee5a87173460e9cd9e509d72d5cd3ae07f5","durationMs":6560,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,2935],[2935,6560]],"words":[[0,345],[345,691],[691,1036],[1036,1381],[1381,1726],[1726,2072],[2072,2935],[2935,3683],[3683,4431],[4431,5006],[5006,5236],[5236,5582],[5582,6560]]}}},{"n":3,"text":"One team wins and one team does not.\nBoth teams cheer right there on the spot!","sentences":["One team wins and one team does not.","Both teams cheer right there on the spot!"],"alt":"Children cheering after the game.","image":{"hash":"sha256:4547417acc27f2530c95495bd78e2722f45859bf1f6dbea0894305d44a98f93b","width":960,"height":717},"audio":{"hash":"sha256:61519f1ab4de9874952a6bf45c1586f0f89b0f18bbc42e67f70f57c200b19c39","duration