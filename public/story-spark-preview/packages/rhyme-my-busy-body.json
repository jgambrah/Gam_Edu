{"schemaVersion":1,"storyId":"rhyme-my-busy-body","version":1,"title":"My Busy Body (an action rhyme)","ageTiers":["3-4","5-6"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"Two little eyes can look and see,\nTwo little ears can hear for me.","sentences":["Two little eyes can look and see,\nTwo little ears can hear for me."],"alt":"A child points to her eyes and ears.","image":{"hash":"sha256:29a0b6a769249927db2dc37f835b41960c4226f4a049261ed6ff1c0c060be7fd","width":960,"height":717},"audio":{"hash":"sha256:e2392bf9c6887c657da794afc9c3351ec833698a50732deaaaf0fd1a1b2b533d","durationMs":8520,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,8520]],"words":[[0,456],[456,1369],[1369,1978],[1978,2434],[2434,3043],[3043,3499],[3499,4184],[4184,4640],[4640,5553],[5553,6162],[6162,6618],[6618,7227],[7227,7683],[7683,8520]]}}},{"n":2,"text":"Two little hands can clap, clap, clap,\nTwo little legs can tap, tap, tap.","sentences":["Two little hands can clap, clap, clap,\nTwo little legs can tap, tap, tap."],"alt":"A child claps and taps her feet.","image":{"hash":"sha256:7bf4612be8482daf86ad277412c7087ab5fcc83226f3a2a8e1865d06048e1500","width":960,"height":717},"audio":{"hash":"sha256:a9808b937cea6d341e018e141b820abc51751d16105746d1944c6094e1b5190b","durationMs":11400,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,11400]],"words":[[0,526],[526,1578],[1578,2455],[2455,2982],[2982,3946],[3946,4911],[4911,5875],[5875,6402],[6402,7454],[7454,8155],[8155,8682],[8682,9471],[9471,10260],[10260,11400]]}}},{"n":3,"text":"One little mouth can smile and say,\n“Good morning!” to the bright new day.","sentences":["One little mouth can smile and say,\n“Good morning!” to the bright new day."],"alt":"A child smiles and waves at the sunrise.","image":{"hash":"sha256:201099d76a6916696c2716c817b932831b9e931d47a643b789f83bf4c8075cb9","width":960,"height":717},"audio":{"hash":"sha256:a35ae01638f4b1b4d86e29022