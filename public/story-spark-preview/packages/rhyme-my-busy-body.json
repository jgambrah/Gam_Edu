{"schemaVersion":1,"storyId":"rhyme-my-busy-body","version":1,"title":"My Busy Body (an action rhyme)","ageTiers":["3-4","5-6"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"Two little eyes can look and see.\nTwo little ears can hear for me.","sentences":["Two little eyes can look and see.","Two little ears can hear for me."],"alt":"A child points to her eyes and ears.","image":{"hash":"sha256:29a0b6a769249927db2dc37f835b41960c4226f4a049261ed6ff1c0c060be7fd","width":960,"height":717},"audio":{"hash":"sha256:e2392bf9c6887c657da794afc9c3351ec833698a50732deaaaf0fd1a1b2b533d","durationMs":8520,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,4636],[4636,8520]],"words":[[0,376],[376,1128],[1128,1629],[1629,2005],[2005,2506],[2506,2882],[2882,4636],[4636,5012],[5012,5764],[5764,6265],[6265,6641],[6641,7142],[7142,7518],[7518,8520]]}}},{"n":2,"text":"Two little hands can clap, clap, clap.\nTwo little legs can tap, tap, tap.","sentences":["Two little hands can clap, clap, clap.","Two little legs can tap, tap, tap."],"alt":"A child claps and taps her feet.","image":{"hash":"sha256:7bf4612be8482daf86ad277412c7087ab5fcc83226f3a2a8e1865d06048e1500","width":960,"height":717},"audio":{"hash":"sha256:a9808b937cea6d341e018e141b820abc51751d16105746d1944c6094e1b5190b","durationMs":11400,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,6263],[6263,11400]],"words":[[0,376],[376,1128],[1128,1754],[1754,2130],[2130,3257],[3257,4384],[4384,6263],[6263,6639],[6639,7391],[7391,7892],[7892,8268],[8268,9270],[9270,10272],[10272,11400]]}}},{"n":3,"text":"One little mouth can smile and say,\n“Good morning!” to the bright new day.","sentences":["One little mouth can smile and say,\n“Good morning!” to the bright new day."],"alt":"A child smiles and waves at the sunrise.","image":{"hash":"sha256:201099d76a6916696c2716c817b932831b9e931d47a643b789f83bf4c8075cb9","width":960,"height":717},"audio":{"hash":"sha256