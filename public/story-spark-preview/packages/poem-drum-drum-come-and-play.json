{"schemaVersion":1,"storyId":"poem-drum-drum-come-and-play","version":1,"title":"Drum, Drum, Come and Play (a rhyme)","ageTiers":["3-4","5-6"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"Boom, boom, the big drum sings,\nTap, tap, the small drum rings.","sentences":["Boom, boom, the big drum sings,\nTap, tap, the small drum rings."],"alt":"A big drum and a small drum with children listening.","image":{"hash":"sha256:c468495f23c257db95415a9213e527fd92c4d8a9348d8a8391857a6288a83c52","width":960,"height":717},"audio":{"hash":"sha256:c2128721e1e420826598ade3bbc06515765c18fdcb02e08f648760a1a989747f","durationMs":9160,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,9160]],"words":[[0,881],[881,1762],[1762,2290],[2290,2818],[2818,3523],[3523,4580],[4580,5285],[5285,5990],[5990,6518],[6518,7399],[7399,8104],[8104,9160]]}}},{"n":2,"text":"Clap, clap, hands in the air,\nStamp, stamp, feet everywhere.","sentences":["Clap, clap, hands in the air,\nStamp, stamp, feet everywhere."],"alt":"Children clap and stamp in a circle.","image":{"hash":"sha256:30f70b9b3e1d8a60a2373d2f90f5cc8e9c68d422089bcacf5b4e73d4b45b370f","width":960,"height":717},"audio":{"hash":"sha256:ea052cda3eb64fefc31cf0f0d0fcd75a381734b503283f5f876948b07df77aa1","durationMs":9200,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,9200]],"words":[[0,902],[902,1804],[1804,2706],[2706,3067],[3067,3608],[3608,4330],[4330,5412],[5412,6494],[6494,7216],[7216,9200]]}}},{"n":3,"text":"Slow, slow, the drum goes low,\nQuick, quick, now off we go!","sentences":["Slow, slow, the drum goes low,\nQuick, quick, now off we go!"],"alt":"Children walk slowly and then run around the drum.","image":{"hash":"sha256:5aa98a77e7a5fba5fc47dfdd8c512bcd26cb6ae1eb4e676a76b2fedfd614af45","width":960,"height":717},"audio":{"hash":"sha256:0583569a548fb08c665f7340722b18d3c6ec563ca7111a94634e36e2588610b8","durationMs":9320,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,9320]],"words":[[0,971],[971,1942],[1942,2525],[2525,3302],[3302,4079],[4079,4856],[4856,6021],[6021,7186],[7186,7769],[7769,8352],[8352,8740],[8740,9320]]}}},{"n":4,"text":"Hush, hush, the drum is shy,\nBoom! it shouts, and we say, “Hi!”","sentences":["Hush, hush, the drum is shy,\nBoom!","it shouts, and we say, “Hi!”"],"alt":"A drum with a shy face and children waving.","image":{"hash":"sha256:e5d167200c31812d56cb5b5e8d4f08e80694a74e4545911202cf6ed6a121d941","width":960,"height":717},"audio":{"hash":"sha256:141998447cd79a29d1f45de1755ef9358941123005b64ba00c6eedd129bb535b","durationMs":9160,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,5028],[5028,9160]],"words":[[0,898],[898,1796],[1796,2335],[2335,3053],[3053,3412],[3412,4130],[4130,5028],[5028,5387],[5387,6644],[6644,7183],[7183,7542],[7542,8260],[8260,9160]]}}}],"activities":[{"id":"dr-c1","type":"comprehension","afterPage":1,"question":"Which drum goes “boom”?","options":["The big drum","The small drum","The shy drum"],"correctIndex":0},{"id":"dr-ph","type":"phonics","afterPage":2,"targetSound":"air","prompt":"Which word rhymes with air?","options":["everywhere","drum","stamp"],"correctIndexes":[0]},{"id":"dr-ph2","type":"phonics","afterPage":3,"targetSound":"ow","prompt":"Which words rhyme with low?","options":["go","quick","slow"],"correctIndexes":[0,2]},{"id":"dr-sel","type":"sel","afterPage":4,"prompt":"Do you feel loud or quiet today?","feelingOptions":["Loud","Quiet","Happy","Shy"]}],"glossary":[{"word":"drum","definition":"A musical instrument you hit to make a sound.","pages":[1]},{"word":"stamp","definition":"To put your foot down hard.","pages":[2]},{"word":"hush","definition":"A word we say to ask for quiet.","pages":[4]}],"assets":{"sha256:c468495f23c257db95415a9213e527fd92c4d8a9348d8a8391857a6288a83c52":{"path":"/story-spark-preview/candidates/poem-drum-drum-come-and-play/page1-1.webp","bytes":92768,"type":"imag