anas?","options":["Yellow","Red","Blue"],"correctIndex":0},{"id":"cm-ph","type":"phonics","afterPage":5,"targetSound":"ound","prompt":"Which word rhymes with round?","options":["sound","yam","home"],"correctIndexes":[0]},{"id":"cm-ph2","type":"phonics","afterPage":2,"targetSound":"unch","prompt":"Which word rhymes with bunch?","options":["lunch","banana","peel"],"correctIndexes":[0]},{"id":"cm-sel","type":"sel","afterPage":5,"prompt":"Which colour of food do you like best?","feelingOptions":["Happy","Hungry","Curious","Playful"]}],"glossary":[{"word":"tomatoes","definition":"Round red fruits that we cook in stew.","pages":[1]},{"word":"bunch","definition":"Several things growing or tied together.","pages":[2]},{"word":"yam","definition":"A big brown root that we boil, pound or fry.","pages":[5]}],"assets":{"sha256:2b61b7b03d5a426ce1f22acf41be85b898768eec22cb102ec5aedc772609439b":{"path":"/story-spark-preview/candidates/rhyme-colours-at-the-market/page1-1.webp","bytes":131228,"type":"image/webp"},"sha256:edb4825c7532b93242671d00f17abbc871f22d2f732f8678b6654b83e31eedc9":{"path":"/story-spark-preview/audio/edb4825c7532.mp3","bytes":76844,"type":"audio/mpeg"},"sha256:43ba4c6a0c94369cfaa9e84864fe341413c36d12bfd25aa25080a8fdb79a7bf4":{"path":"/story-spark-preview/candidates/rhyme-colours-at-the-market/page2-1.webp","bytes":126402,"type":"image/webp"},"sha256:d238afc6d9835ab7ce628ebf2b476097e109fac2c6ab1ebb6fd8f9489fd15bf1":{"path":"/story-spark-preview/audio/d238afc6d983.mp3","bytes":34029,"type":"audio/mpeg"},"sha256:d448fbc0a34ba8799c87217fbe03f7aea372e0026e9184b3d52499a86c35972a":{"path":"/story-spark-preview/candidates/rhyme-colours-at-the-market/page3-1.webp","bytes":131958,"type":"image/webp"},"sha256:0f89d2976a20d82fcd6b6f2c5ed2fab8f7a19a3c2b639e01a3ae8ae529e80c9a":{"path":"/story-spark-preview/audio/0f89d2976a20.mp3","bytes":67820,"type":"audio/mpeg"},"sha256:bb0d2c748dac4cfca60d510947b6bf0bf7d300afcd528243532818a86d0bd9a8":{"path":"/story-spark-preview/candidates