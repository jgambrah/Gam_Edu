{"schemaVersion":1,"storyId":"rhyme-the-ant-parade","version":1,"title":"The Ant Parade (a marching rhyme)","ageTiers":["5-6","7-8"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"Left, right, left, right, ants on a track,\ncarrying crumbs on each tiny back.","sentences":["Left, right, left, right, ants on a track,\ncarrying crumbs on each tiny back."],"alt":"A line of ants on a path, each carrying a crumb.","image":{"hash":"sha256:fe467da1906a6e3c20660f8283f92873db9b098d48e0bf1f2348844835cb70bc","width":960,"height":717},"audio":{"hash":"sha256:94526ad01b4a1c895ebffa987225a44e7af3f194fce903aa80927cd2e4a6935d","durationMs":8880,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,8880]],"words":[[0,708],[708,1544],[1544,2252],[2252,3089],[3089,3603],[3603,3861],[3861,3990],[3990,4826],[4826,5856],[5856,6628],[6628,6885],[6885,7400],[7400,7915],[7915,8880]]}}},{"n":2,"text":"A crumb is big when you are small,\nbut ants can carry it, one and all.","sentences":["A crumb is big when you are small,\nbut ants can carry it, one and all."],"alt":"Several ants carrying a bread crumb.","image":{"hash":"sha256:6fdefe5538f0da5db09d83d547304b6352ebdf9cccccf13f107957d52b734949","width":960,"height":717},"audio":{"hash":"sha256:f3cb4edfce74edfe11d449a9c1b311852856ae7d267540ceafcf9522291e7f65","durationMs":10240,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,10240]],"words":[[0,175],[175,1050],[1050,1400],[1400,1925],[1925,2626],[2626,3151],[3151,3676],[3676,4814],[4814,5339],[5339,6039],[6039,6564],[6564,7439],[7439,8052],[8052,8577],[8577,9102],[9102,10240]]}}},{"n":3,"text":"Down the path to their hill they go,\na house of tunnels, deep below.","sentences":["Down the path to their hill they go,\na house of tunnels, deep below."],"alt":"Ants entering an earth mound.","image":{"hash":"sha256:2d983553a1b608a621ab45754216ef9dbc896f5cd084be4824b3594a6ed093df","width":960,"height":717},"audio":{"hash":"sha256:4c9903385ad0bb6db05261637dc51ad242760975308e9e096bc5c0daed839626","durationMs":10160,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,10160]],"words":[[0,695],[695,1216],[1216,1910],[1910,2258],[2258,3126],[3126,3821],[3821,4516],[4516,5123],[5123,5297],[5297,6165],[6165,6513],[6513,7989],[7989,8684],[8684,10160]]}}},{"n":4,"text":"Together they work, and together they eat.\nNo ant is lonely. No ant is beat.","sentences":["Together they work, and together they eat.","No ant is lonely.","No ant is beat."],"alt":"Ants sharing food in a nest.","image":{"hash":"sha256:1584ffd8f61af2ae7f3d57ae2faef22b9bcbf062e3043e201215002796cc7d4f","width":960,"height":717},"audio":{"hash":"sha256:9128f298b1a9405a6534ac29e95879a155b33619c576fb76457b19fda5aedbdb","durationMs":15480,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,8678],[8678,12079],[12079,15480]],"words":[[0,1876],[1876,2815],[2815,4105],[4105,4808],[4808,6685],[6685,7623],[7623,8678],[8678,9147],[9147,9851],[9851,10320],[10320,12079],[12079,12548],[12548,13252],[13252,13721],[13721,15480]]}}},{"n":5,"text":"We watch them from far. We do not touch.\nThey are small, but they do very much.","sentences":["We watch them from far.","We do not touch.","They are small, but they do very much."],"alt":"Two children watching ants from a few steps away.","image":{"hash":"sha256:dcf676b68d0a9579e4b41611255af3b836432e25666e96ac261111e7e651bd53","width":960,"height":717},"audio":{"hash":"sha256:b1b2b665d265c52c87c51486490488bc17962d496cd55fdf0e70c820a7af1d0b","durationMs":11960,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,3481],[3481,5891],[5891,11960]],"words":[[0,357],[357,1250],[1250,1964],[1964,2678],[2678,3481],[3481,3838],[3838,4195],[4195,4730],[4730,5891],[5891,6605],[6605,7140],[7140,8301],[8301,8836],[8836,9550],[9550,9907],[9907,10621],[10621,11960]]}}}],"activities":[{"id":"ap-c1","type":"comprehension",