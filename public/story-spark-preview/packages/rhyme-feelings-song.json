{"schemaVersion":1,"storyId":"rhyme-feelings-song","version":1,"title":"The Feelings Song","ageTiers":["5-6","7-8"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"When I am happy, I jump and sing,\nI share my smile with everything.","sentences":["When I am happy, I jump and sing,\nI share my smile with everything."],"alt":"A child jumping with joy.","image":{"hash":"sha256:aaff6a82db1a2d1844f29dfed67b41e7750b5255b8ff48231de1893457cc867e","width":960,"height":717},"audio":{"hash":"sha256:f05419695f7e468f54ce9b8559fb1bb1b413d6aeaf3fbdceb73181797a1c875b","durationMs":10440,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,10440]],"words":[[0,726],[726,908],[908,1271],[1271,2451],[2451,2633],[2633,3359],[3359,3904],[3904,4902],[4902,5084],[5084,5992],[5992,6355],[6355,7263],[7263,7989],[7989,10440]]}}},{"n":2,"text":"When I am sad, I tell a friend,\nA hug and a talk can help me mend.","sentences":["When I am sad, I tell a friend,\nA hug and a talk can help me mend."],"alt":"A child talking to a friend.","image":{"hash":"sha256:109c57dd80b4c272530299b904ef924b7ae531265426cbfe3b32d6a4cb6d9f31","width":960,"height":717},"audio":{"hash":"sha256:755927326b65805f455623326248333ee7896feecf215c3dea2ecc8c95c3b5a9","durationMs":9160,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,9160]],"words":[[0,685],[685,856],[856,1199],[1199,1969],[1969,2140],[2140,2825],[2825,2996],[2996,4280],[4280,4452],[4452,4965],[4965,5479],[5479,5650],[5650,6335],[6335,6849],[6849,7533],[7533,7876],[7876,9160]]}}},{"n":3,"text":"When I am cross, I count to ten,\nThen I speak, and not shout, again.","sentences":["When I am cross, I count to ten,\nThen I speak, and not shout, again."],"alt":"A child counting on fingers.","image":{"hash":"sha256:a7ad0609aa9adcf6db69cd5fe4a3ea47177c35323588b3205b0938671a7e5ae0","width":960,"height":717},"audio":{"hash":"sha256:b717d7c677e1901965b4605a3985e0bdb797307df056951b071b93bf84