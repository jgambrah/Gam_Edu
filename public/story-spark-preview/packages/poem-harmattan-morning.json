{"schemaVersion":1,"storyId":"poem-harmattan-morning","version":1,"title":"Harmattan Morning (a poem)","ageTiers":["5-6","7-8"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"The harmattan wind blows soft and dry,\nIt paints a pale haze across the sky.","sentences":["The harmattan wind blows soft and dry,\nIt paints a pale haze across the sky."],"alt":"A pale dusty sky over a village at dawn.","image":{"hash":"sha256:92644c78c8c2b617a28655a6e6fe362862aa60992b3b5b1a8002cbc5f064a6b9","width":960,"height":717},"audio":{"hash":"sha256:6a85c07447d7954df6c5e96454ecdc12cfebd8283109d22adad9354720d8aaac","durationMs":11160,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,11160]],"words":[[0,540],[540,2160],[2160,2880],[2880,3780],[3780,4500],[4500,5040],[5040,5760],[5760,6120],[6120,7200],[7200,7380],[7380,8100],[8100,8820],[8820,9900],[9900,10440],[10440,11160]]}}},{"n":2,"text":"It tickles my nose and cracks my lips,\nIt steals the dew from the leaves’ green tips.","sentences":["It tickles my nose and cracks my lips,\nIt steals the dew from the leaves’ green tips."],"alt":"A child rubs her nose while dew-free leaves hang nearby.","image":{"hash":"sha256:5e8d79b953cbaafda94d8eba67665097021aa022ed7e62eb6d59d63b797b9b0d","width":960,"height":717},"audio":{"hash":"sha256:9019947ac185803b51ca70e3c55706a2bc44b508a9c59e4a26273f668bc60b0a","durationMs":9560,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,9560]],"words":[[0,277],[277,1247],[1247,1524],[1524,2078],[2078,2494],[2494,3325],[3325,3602],[3602,4295],[4295,4572],[4572,5403],[5403,5819],[5819,6235],[6235,6789],[6789,7205],[7205,8175],[8175,8868],[8868,9560]]}}},{"n":3,"text":"Mama rubs shea butter on my knees,\nAnd wraps me up against the breeze.","sentences":["Mama rubs shea butter on my knees,\nAnd wraps me up against the breeze."],"alt":"A mother rubs shea butter on a child’s knees and wraps a cloth around her.","image":{"hash":"sha256:d5fc4ac8fe669634b8ff39d34cb52eb4b6c7b5d44a515379a1b68f8acd34dda6","width":960,"height":717},"audio":{"hash":"sha256:e97936eb46afd7d96625fcf81172f3b4ceff6d725ace9251779c8db90c3de068","durationMs":10240,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,10240]],"words":[[0,719],[719,1438],[1438,2157],[2157,3235],[3235,3594],[3594,3953],[3953,5031],[5031,5570],[5570,6468],[6468,6827],[6827,7186],[7186,8444],[8444,8983],[8983,10240]]}}},{"n":4,"text":"The sun is a coin of orange gold,\nA shy little thing, not big or bold.","sentences":["The sun is a coin of orange gold,\nA shy little thing, not big or bold."],"alt":"A small orange sun behind a dusty haze.","image":{"hash":"sha256:86ebb8bac6542e42fe0585d84772262c1f1ffd0df26da56965624baaec313406","width":960,"height":717},"audio":{"hash":"sha256:1d8e48b39591f94da3776be2bdd6ede926af0ac87dfdfe58bf6a094f30a105ca","durationMs":10360,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,10360]],"words":[[0,565],[565,1130],[1130,1507],[1507,1695],[1695,2448],[2448,2825],[2825,3955],[3955,4897],[4897,5085],[5085,5650],[5650,6780],[6780,7910],[7910,8475],[8475,9040],[9040,9417],[9417,10360]]}}},{"n":5,"text":"We fly our kites on the Saturday hill,\nThe wind is a friend that is never still.","sentences":["We fly our kites on the Saturday hill,\nThe wind is a friend that is never still."],"alt":"Children fly kites on a hill under a hazy sky.","image":{"hash":"sha256:dc595a4a6a21c52a7e4ebc06da60fc0da2c8d583012eaa6bc9361d8de3115896","width":960,"height":717},"audio":{"hash":"sha256:6e85d2fcf1820c065e7447bf8c548e21a487033ae2dc5c50f6d0067a0e221083","durationMs":10320,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,10320]],"words":[[0,323],[323,807],[807,1291],[1291,2097],[2097,2420],[2420,2904],[2904,4194],[4194,5000],[5000,5484],[5484,6129],[6129,6452],[6452,6613],[6613,7581],[7581,8226],[8226,8549],[8549,9355],[9355,10320]]}}}],"activities":[{"id":"hm-c1","type":"comprehension","afterPage":2,"question":"What does the wind do to the child’s lips?","options":["Cracks them","Paints them blue","Makes them sing"],"correctIndex":0},{"id":"hm-ph","type":"phonics","afterPage":3,"targetSound":"ees","prompt":"Which word rhymes with knees?","options":["breeze","butter","wind"],"correctIndexes":[0]},{"id":"hm-c2","type":"comprehension","afterPage":4,"question":"What is the sun compared to?","options":["A coin of orange gold","A red ball","A white plate"],"correctIndex":0,"explanation":"This is a metaphor: the poem says the sun is a coin."},{"id":"hm-voc","type":"vocabulary","afterPage":1,"word":"haze","definition":"A thin cloud of dust or smoke in the air that makes things look pale.","distractors":["A kind of bird","A loud noise"]},{"id":"hm-s1","type":"sequencing","prompt":"Put the poem’s pictures in order.","items":["The wind blows across the sky.","Mama rubs shea butter on my knees.","The shy orange sun peeps out.","We fly kites on the hill."]},{"id":"hm-sel","type":"sel","afterPage":5,"prompt":"The poem says the wind is a friend. Do you like harmattan weather?","feelingOptions":["Happy","Cold","Dusty","Playful"]}],"glossary":[{"word":"harmattan","definition":"A dry, dusty wind from the Sahara that blows across West Africa in the dry season.","pages":[1]},{"word":"haze","definition":"A thin cloud of dust that makes the sky look pale.","pages":[1]},{"word":"breeze","definition":"A gentle wind.","pages":[3]},{"word":"kites","definition":"Light toys with a string that fly in the wind.","pages":[5]}],"assets":{"sha256:92644c78c8c2b617a28655a6e6fe362862aa60992b3b5b1a8002cbc5f064a6b9":{"path":"/story-spark-preview/candidates/poem-harmattan-morning/page1-1.webp","bytes":83524,"type":"image/webp"},"sha256:6a85c07447d7954df6c5e96454ecdc12cfebd8283109d22adad9354720d8aaac":{"path":"/story-spark-preview/audio/6a85c07447d7.mp3","bytes":45068,"type":"audio/mpeg"},"sha256:5e8d79b953cbaafda94d8eba67665097021aa022ed7e62eb6d59d63b797b9b0d":{"path":"/story-spark-preview/candidates/poem-harmattan-morning/page2-1.webp","bytes":91490,"type":"image/webp"},"sha256:9019947ac185803b51ca70e3c55706a2bc44b508a9c59e4a26273f668bc60b0a":{"path":"/story-spark-preview/audio/9019947ac185.mp3","bytes":38732,"type":"audio/mpeg"},"sha256:d5fc4ac8fe669634b8ff39d34cb52eb4b6c7b5d44a515379a1b68f8acd34dda6":{"path":"/story-spark-preview/candidates/poem-harmattan-morning/page3-1.webp","bytes":96882,"type":"image/webp"},"sha256:e97936eb46afd7d96625fcf81172f3b4ceff6d725ace9251779c8db90c3de068":{"path":"/story-spark-preview/audio/e97936eb46af.mp3","bytes":41420,"type":"audio/mpeg"},"sha256:86ebb8bac6542e42fe0585d84772262c1f1ffd0df26da56965624baaec313406":{"path":"/story-spark-preview/candidates/poem-harmattan-morning/page4-1.webp","bytes":104620,"type":"image/webp"},"sha256:1d8e48b39591f94da3776be2bdd6ede926af0ac87dfdfe58bf6a094f30a105ca":{"path":"/story-spark-preview/audio/1d8e48b39591.mp3","bytes":41900,"type":"audio/mpeg"},"sha256:dc595a4a6a21c52a7e4ebc06da60fc0da2c8d583012eaa6bc9361d8de3115896":{"path":"/story-spark-preview/candidates/poem-harmattan-morning/page5-1.webp","bytes":106816,"type":"image/webp"},"sha256:6e85d2fcf1820c065e7447bf8c548e21a487033ae2dc5c50f6d0067a0e221083":{"path":"/story-spark-preview/audio/6e85d2fcf182.mp3","bytes":41708,"type":"audio/mpeg"}},"contentHash":"sha256:a399e5f9b7237a5e017ce4b86ec8a92afbf993f32f1b3b4228945645d21910d0"}