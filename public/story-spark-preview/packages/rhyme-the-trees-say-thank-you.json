{"schemaVersion":1,"storyId":"rhyme-the-trees-say-thank-you","version":1,"title":"The Trees Say Thank You (a poem)","ageTiers":["7-8","9-10"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"I am a tree with roots down deep.\nThey hold the soil that rain would sweep.","sentences":["I am a tree with roots down deep.","They hold the soil that rain would sweep."],"alt":"A big tree with roots holding soil on a slope.","image":{"hash":"sha256:a468e2a02a3c6e0b52af2153bd13ae449f60a57c725a7ae9edcfa5ca6010a470","width":960,"height":717},"audio":{"hash":"sha256:d425fc2c248adbb442c865278b28a46d7c526b611e535d18348977c9b317f2d4","durationMs":12240,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,6041],[6041,12240]],"words":[[0,318],[318,636],[636,954],[954,1590],[1590,2226],[2226,3021],[3021,3657],[3657,6041],[6041,6677],[6677,7313],[7313,7790],[7790,8426],[8426,9062],[9062,9698],[9698,10493],[10493,12240]]}}},{"n":2,"text":"My leaves give shade at the hottest noon.\nSit under me. You will be cool soon.","sentences":["My leaves give shade at the hottest noon.","Sit under me.","You will be cool soon."],"alt":"Children resting in the shade of a tree at noon.","image":{"hash":"sha256:05e29dad3a680a81814958c4d2749e54afac2e1eb3bad1c2531ed08d38a70d48","width":960,"height":717},"audio":{"hash":"sha256:01570a065ed03abd87ea833e8ad1bdbf2dd1dbe40354762bf028077759608e04","durationMs":11120,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,5560],[5560,8214],[8214,11120]],"words":[[0,253],[253,1011],[1011,1516],[1516,2148],[2148,2401],[2401,2780],[2780,3665],[3665,5560],[5560,5939],[5939,6571],[6571,8214],[8214,8593],[8593,9098],[9098,9351],[9351,9856],[9856,11120]]}}},{"n":3,"text":"I take in the air that people breathe out,\nand I give back the air that you need, no doubt.","sentences":["I take in the air that people breathe out,\nand I give back the air that you need, no doubt."],"alt":"A tree with arrows showing air moving in and out.","image":{"hash":"sha256:04c6fffcacd6241daf4fc589bda6b7b3917608fb356572259770b1dd486abb4c","width":960,"height":717},"audio":{"hash":"sha256:1ef33957f2ee75c93a6ce2649e737763870f5ee251142901895c9eaa5f9e91c5","durationMs":17680,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,17680]],"words":[[0,406],[406,1219],[1219,1625],[1625,2235],[2235,2845],[2845,3658],[3658,4877],[4877,6300],[6300,7926],[7926,8536],[8536,8942],[8942,9755],[9755,10568],[10568,11178],[11178,11788],[11788,12601],[12601,13211],[13211,15040],[15040,15446],[15446,17680]]}}},{"n":4,"text":"Birds make nests in my branches high.\nBees visit my flowers as they fly by.","sentences":["Birds make nests in my branches high.","Bees visit my flowers as they fly by."],"alt":"Birds in a nest and bees at tree flowers.","image":{"hash":"sha256:e216d7da0f5e87eb981b4dd918159c35db38128ed14ae76658a5bcac614c45b0","width":960,"height":717},"audio":{"hash":"sha256:dd8463e20ca20a1be5a0db93e6a70c6b236ab32a6c24d779dc46cee879dbfe53","durationMs":12360,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,6667],[6667,12360]],"words":[[0,813],[813,1464],[1464,2277],[2277,2602],[2602,2927],[2927,4228],[4228,6667],[6667,7318],[7318,8131],[8131,8456],[8456,9594],[9594,9919],[9919,10570],[10570,11058],[11058,12360]]}}},{"n":5,"text":"If a tree must fall, plant a new one near,\nso shade and birds and fruit stay here.","sentences":["If a tree must fall, plant a new one near,\nso shade and birds and fruit stay here."],"alt":"Children plant a young tree beside an old stump.","image":{"hash":"sha256:5d195ee2a332fcecda6943827e2c487080d0458c7ce8140faf581dae7218bf2d","width":960,"height":717},"audio":{"hash":"sha256:67852cd876ec0547ffd3b23f7f33e03db9567b7191b8156a6cd80d1cee9a9779","durationMs":11800,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,11800]],"words":[[0,295],[295,590],[590,1180],[1180,1770],[1770,3098],[3098,3836],[3836,4131],[4131,4574],[4574,5017],[5017,6345],[6345,6640],[6640,7378],[7378,7821],[7821,8559],[8559,9002],[9002,9740],[9740,10330],[10330,11800]]}}},{"n":6,"text":"Thank you, children, for every seed you sow.\nWe will grow with you. Watch us grow!","sentences":["Thank you, children, for every seed you sow.","We will grow with you.","Watch us grow!"],"alt":"Children watering a seedling with a can.","image":{"hash":"sha256:f4fdfd4e3c60e364e1d8a15ae474e23fcd5c8f480cd729d36fc10c17160eb448","width":960,"height":717},"audio":{"hash":"sha256:0b0a4ccb04e0687be69bfcae654bb959fbe7ce0dbfd05a19f8f9084b9e0361cc","durationMs":11400,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,6270],[6270,9462],[9462,11400]],"words":[[0,570],[570,1482],[1482,2964],[2964,3306],[3306,3876],[3876,4332],[4332,4674],[4674,6270],[6270,6498],[6498,6954],[6954,7410],[7410,7866],[7866,9462],[9462,10032],[10032,10260],[10260,11400]]}}}],"activities":[{"id":"tt-c1","type":"comprehension","afterPage":1,"question":"What do the tree’s roots do?","options":["Hold the soil","Make rain","Chase the birds"],"correctIndex":0},{"id":"tt-c2","type":"comprehension","afterPage":5,"question":"What does the tree ask people to do if a tree must fall?","options":["Plant a new one","Leave the stump alone","Do nothing"],"correctIndex":0},{"id":"tt-ph","type":"phonics","afterPage":2,"targetSound":"oon","prompt":"Which word rhymes with noon?","options":["soon","shade","leaf"],"correctIndexes":[0]},{"id":"tt-voc","type":"vocabulary","afterPage":1,"word":"roots","definition":"The parts of a plant that grow under the soil and take in water.","distractors":["The flowers of a tree","The top branches"]},{"id":"tt-sel","type":"sel","afterPage":6,"prompt":"The trees say thank you for planting seeds. How does that make you feel?","feelingOptions":["Proud","Hopeful","Happy","Caring"]}],"glossary":[{"word":"roots","definition":"The parts of a plant under the soil that hold it and take in water.","pages":[1]},{"word":"shade","definition":"A cool place out of the sun.","pages":[2]},{"word":"nests","definition":"Homes that birds build for their eggs and chicks.","pages":[4]}],"assets":{"sha256:a468e2a02a3c6e0b52af2153bd13ae449f60a57c725a7ae9edcfa5ca6010a470":{"path":"/story-spark-preview/candidates/rhyme-the-trees-say-thank-you/page1-1.webp","bytes":108712,"type":"image/webp"},"sha256:d425fc2c248adbb442c865278b28a46d7c526b611e535d18348977c9b317f2d4":{"path":"/story-spark-preview/audio/d425fc2c248a.mp3","bytes":98540,"type":"audio/mpeg"},"sha256:05e29dad3a680a81814958c4d2749e54afac2e1eb3bad1c2531ed08d38a70d48":{"path":"/story-spark-preview/candidates/rhyme-the-trees-say-thank-you/page2-1.webp","bytes":87182,"type":"image/webp"},"sha256:01570a065ed03abd87ea833e8ad1bdbf2dd1dbe40354762bf028077759608e04":{"path":"/story-spark-preview/audio/01570a065ed0.mp3","bytes":89708,"type":"audio/mpeg"},"sha256:04c6fffcacd6241daf4fc589bda6b7b3917608fb356572259770b1dd486abb4c":{"path":"/story-spark-preview/candidates/rhyme-the-trees-say-thank-you/page3-1.webp","bytes":100870,"type":"image/webp"},"sha256:1ef33957f2ee75c93a6ce2649e737763870f5ee251142901895c9eaa5f9e91c5":{"path":"/story-spark-preview/audio/1ef33957f2ee.mp3","bytes":142124,"type":"audio/mpeg"},"sha256:e216d7da0f5e87eb981b4dd918159c35db38128ed14ae76658a5bcac614c45b0":{"path":"/story-spark-preview/candidates/rhyme-the-trees-say-thank-you/page4-1.webp","bytes":102020,"type":"image/webp"},"sha256:dd8463e20ca20a1be5a0db93e6a70c6b236ab32a6c24d779dc46cee879dbfe53":{"path":"/story-spark-preview/audio/dd8463e20ca2.mp3","bytes":99500,"type":"audio/mpeg"},"sha256:5d195ee2a332fcecda6943827e2c487080d0458c7ce8140faf581dae7218bf2d":{"path":"/story-spark-preview/candidates/rhyme-the-trees-say-thank-you/page5-1.webp","bytes":94666,"type":"image/webp"},"sha256:67852cd876ec0547ffd3b23f7f33e03db9567b7191b8156a6cd80d1cee9a9779":{"path":"/story-spark-preview/audio/67852cd876ec.mp3","bytes":95084,"type":"audio/mpeg"},"sh