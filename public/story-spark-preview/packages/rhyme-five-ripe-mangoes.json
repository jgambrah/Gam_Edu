{"schemaVersion":1,"storyId":"rhyme-five-ripe-mangoes","version":1,"title":"Five Ripe Mangoes (a counting rhyme)","ageTiers":["3-4","5-6"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"Five ripe mangoes hang up high.\nOne drops down. Oh my, oh my!","sentences":["Five ripe mangoes hang up high.","One drops down.","Oh my, oh my!"],"alt":"Five mangoes on a tree and one falling down.","image":{"hash":"sha256:63ac0bcd127bd34b793808e23ea14654402522675448d562e5ecfae3d32ba4de","width":960,"height":717},"audio":{"hash":"sha256:5839c1113d433d904f01fb1e6e7ddea0d2279050e1e06ded38d29eeec71b4279","durationMs":12440,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,5741],[5741,9408],[9408,12440]],"words":[[0,638],[638,1276],[1276,2392],[2392,3030],[3030,3349],[3349,5741],[5741,6219],[6219,7016],[7016,9408],[9408,9727],[9727,10843],[10843,11162],[11162,12440]]}}},{"n":2,"text":"Four ripe mangoes, round and sweet.\nOne is shared with a friend to eat.","sentences":["Four ripe mangoes, round and sweet.","One is shared with a friend to eat."],"alt":"A child gives half a mango to a friend.","image":{"hash":"sha256:4f79772178ed06160c5515d3e74afe984958cbe9aff634f65861dec534055cc2","width":960,"height":717},"audio":{"hash":"sha256:fbf07a455f50fe5f4e1601c279ef5741f2fed8c006bf160d759b3b5a49d70cfe","durationMs":14280,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,8054],[8054,14280]],"words":[[0,732],[732,1464],[1464,3661],[3661,4576],[4576,5125],[5125,8054],[8054,8603],[8603,8969],[8969,10067],[10067,10799],[10799,11165],[11165,12263],[12263,12629],[12629,14280]]}}},{"n":3,"text":"Three ripe mangoes, gold and bright.\nOne is for Grandma, a sweet delight.","sentences":["Three ripe mangoes, gold and bright.","One is for Grandma, a sweet delight."],"alt":"A grandmother smiling and holding a mango.","image":{"hash":"sha256:478231e2724460298fa63a33e98f521eb976e0f006534ae979fc7bbed53b64a9","width":960,"height":717},"audio":{"hash":"sha256:e529703eef5b9f7f82f748748e393d795b72b21321c92efb2cb6cf97fbce70e0","durationMs":10760,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,5696],[5696,10760]],"words":[[0,633],[633,1139],[1139,2658],[2658,3164],[3164,3544],[3544,5696],[5696,6076],[6076,6329],[6329,6709],[6709,8228],[8228,8481],[8481,9114],[9114,10760]]}}},{"n":4,"text":"Two ripe mangoes, just a few:\nOne for Teacher, one for you.","sentences":["Two ripe mangoes, just a few:\nOne for Teacher, one for you."],"alt":"A teacher receives a mango from a child.","image":{"hash":"sha256:42896981120433dbd7397ab1f96ec50cd1ed5d36fc9235065a893e6a46bd2a2f","width":960,"height":717},"audio":{"hash":"sha256:23551a2b3cc66dbf95ec2907c08d7d198991eae5a6d58d85132185a5666e417e","durationMs":10200,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,10200]],"words":[[0,464],[464,1082],[1082,2937],[2937,3555],[3555,3864],[3864,5100],[5100,5564],[5564,6028],[6028,7883],[7883,8347],[8347,8811],[8811,10200]]}}},{"n":5,"text":"One ripe mango, the last one there.\nWe wash it well and we share with care.","sentences":["One ripe mango, the last one there.","We wash it well and we share with care."],"alt":"Children wash a mango in a bowl of clean water.","image":{"hash":"sha256:42d98f959f4f0f49b541bcf86f3464406fa0468b7f40d776dacdbbbb2b9b65fe","width":960,"height":717},"audio":{"hash":"sha256:4270080a1d23f87cb25888e18fbfb6c6f454f406182cb44b0bac3f050751831d","durationMs":13080,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,7120],[7120,13080]],"words":[[0,497],[497,1159],[1159,2815],[2815,3312],[3312,3974],[3974,4471],[4471,7120],[7120,7451],[7451,8113],[8113,8444],[8444,9106],[9106,9603],[9603,9934],[9934,10762],[10762,11424],[11424,13080]]}}},{"n":6,"text":"No more mangoes, but look, a seed!\nWe plant it and water it. That is all we need.","sentences":["No more mangoes, but look, a seed!","We plant it and water it.","That is all we need."],"alt":"Children plant a mango seed in the soil and pour water.","image":{"hash":"sha256:a260b8cf2cf2ec81264126570fb52375ce5fd87cd72adc31ce27ec5054ce2263","width":960,"height":717},"audio":{"hash":"sha256:4198841ad50fba74f2128e8a738f94ec95ffa92eb2d870c3b095edf9941de2f1","durationMs":11520,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,5525],[5525,9052],[9052,11520]],"words":[[0,235],[235,705],[705,2116],[2116,2469],[2469,3527],[3527,3762],[3762,5525],[5525,5760],[5760,6348],[6348,6583],[6583,6936],[6936,7524],[7524,9052],[9052,9522],[9522,9757],[9757,10110],[10110,10345],[10345,11520]]}}}],"activities":[{"id":"fm-c1","type":"comprehension","afterPage":3,"question":"Who is the third mango for?","options":["Grandma","The goat","The tree"],"correctIndex":0},{"id":"fm-ph","type":"phonics","afterPage":2,"targetSound":"eet","prompt":"Which word rhymes with sweet?","options":["eat","mango","friend"],"correctIndexes":[0]},{"id":"fm-ph2","type":"phonics","afterPage":6,"targetSound":"eed","prompt":"Which word rhymes with seed?","options":["need","water","plant"],"correctIndexes":[0]},{"id":"fm-s1","type":"sequencing","prompt":"Put the mango rhyme in order.","items":["Five mangoes hang on the tree.","One is shared with a friend.","One is for Grandma.","We plant the seed."]},{"id":"fm-sel","type":"sel","afterPage":6,"prompt":"How do you feel when you share?","feelingOptions":["Happy","Kind","Proud","Hungry"]}],"glossary":[{"word":"ripe","definition":"Ready to eat, soft and sweet.","pages":[1,2]},{"word":"share","definition":"To give some of what you have to another person.","pages":[5]},{"word":"seed","definition":"The small part of a fruit that can grow into a new plant.","pages":[6]}],"assets":{"sha256:63ac0bcd127bd34b793808e23ea14654402522675448d562e5ecfae3d32ba4de":{"path":"/story-spark-preview/candidates/rhyme-five-ripe-mangoes/page1-1.webp","bytes":128502,"type":"image/webp"},"sha256:5839c1113d433d904