{"schemaVersion":1,"storyId":"rhyme-ten-little-fingers","version":1,"title":"Ten Little Fingers (a counting rhyme)","ageTiers":["3-4","5-6"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"One finger, two fingers, three, four, five.\nWiggle them, jiggle them, look alive!","sentences":["One finger, two fingers, three, four, five.","Wiggle them, jiggle them, look alive!"],"alt":"A child wiggling five fingers.","image":{"hash":"sha256:656c72de84b6161b8388b1a93d198112e74e774eeac67efcde6744c9f93d4b82","width":960,"height":717},"audio":{"hash":"sha256:4bd97078fd5743628f43840fe6398c4c7a7f72721744678ade0d597088e33fa2","durationMs":14480,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,8447],[8447,14480]],"words":[[0,402],[402,1877],[1877,2279],[2279,3888],[3888,5229],[5229,6436],[6436,8447],[8447,9251],[9251,10458],[10458,11262],[11262,12469],[12469,13005],[13005,14480]]}}},{"n":2,"text":"Six fingers, seven, eight, nine, ten.\nClap them, tap them, and start again!","sentences":["Six fingers, seven, eight, nine, ten.","Clap them, tap them, and start again!"],"alt":"A child holding up ten fingers and clapping.","image":{"hash":"sha256:57d8ba2bc4c1aad43b1761a5a0b87e4b1424817a8910dc1179eeb394c28899e7","width":960,"height":717},"audio":{"hash":"sha256:9c355bd1d42f600d2bfaba30b709f1bb17cfa98df60bdafebfcd6e300ff8cad3","durationMs":12280,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,6983],[6983,12280]],"words":[[0,361],[361,1806],[1806,3010],[3010,4214],[4214,5298],[5298,6983],[6983,7465],[7465,8549],[8549,8910],[8910,9994],[9994,10355],[10355,10957],[10957,12280]]}}},{"n":3,"text":"Ten little toes in my shoes all day.\nThey wiggle at night when I stretch and play.","sentences":["Ten little toes in my shoes all day.","They wiggle at night when I stretch and play."],"alt":"A child wiggling bare toes on a mat.","image":{"hash":"sha256:dbb107faaa10fd9be487265fd06ed8dad21564f0f12e09f6886cf6349e25