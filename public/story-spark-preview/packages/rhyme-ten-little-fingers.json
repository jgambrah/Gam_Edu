{"schemaVersion":1,"storyId":"rhyme-ten-little-fingers","version":1,"title":"Ten Little Fingers (a counting rhyme)","ageTiers":["3-4","5-6"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"One finger, two fingers, three, four, five.\nWiggle them, jiggle them, look alive!","sentences":["One finger, two fingers, three, four, five.","Wiggle them, jiggle them, look alive!"],"alt":"A child wiggling five fingers.","image":{"hash":"sha256:656c72de84b6161b8388b1a93d198112e74e774eeac67efcde6744c9f93d4b82","width":960,"height":717},"audio":{"hash":"sha256:4bd97078fd5743628f43840fe6398c4c7a7f72721744678ade0d597088e33fa2","durationMs":14480,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,7626],[7626,14480]],"words":[[0,579],[579,2027],[2027,2606],[2606,4247],[4247,5502],[5502,6564],[6564,7626],[7626,8785],[8785,9846],[9846,11005],[11005,12067],[12067,12839],[12839,14480]]}}},{"n":2,"text":"Six fingers, seven, eight, nine, ten.\nClap them, tap them, and start again!","sentences":["Six fingers, seven, eight, nine, ten.","Clap them, tap them, and start again!"],"alt":"A child holding up ten fingers and clapping.","image":{"hash":"sha256:57d8ba2bc4c1aad43b1761a5a0b87e4b1424817a8910dc1179eeb394c28899e7","width":960,"height":717},"audio":{"hash":"sha256:9c355bd1d42f600d2bfaba30b709f1bb17cfa98df60bdafebfcd6e300ff8cad3","durationMs":12280,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,6140],[6140,12280]],"words":[[0,534],[534,2047],[2047,3203],[3203,4360],[4360,5339],[5339,6140],[6140,6852],[6852,7831],[7831,8365],[8365,9343],[9343,9877],[9877,10767],[10767,12280]]}}},{"n":3,"text":"Ten little toes in my shoes all day.\nThey wiggle at night when I stretch and play.","sentences":["Ten little toes in my shoes all day.","They wiggle at night when I stretch and play."],"alt":"A child wiggling bare toes on a mat.","image":{"hash":"sha256:dbb107faaa10fd9be487265fd06ed8dad21564f0f12e09f6886cf6349e2535e1