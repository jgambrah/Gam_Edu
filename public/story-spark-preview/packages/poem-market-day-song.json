{"schemaVersion":1,"storyId":"poem-market-day-song","version":1,"title":"Market Day Song (a poem)","ageTiers":["7-8","9-10"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"Tomatoes red, plantain ripe and gold.\nCome buy, come buy, before they are sold!","sentences":["Tomatoes red, plantain ripe and gold.","Come buy, come buy, before they are sold!"],"alt":"A stall of red tomatoes and golden plantain with a smiling trader.","image":{"hash":"sha256:c11cccae259d97664910d3489b6c034b4a7569a9e7c76a53747a1b6154472ba4","width":960,"height":717},"audio":{"hash":"sha256:08bea6b08b32d9b397d6ea376fc567208a0a7e640e0a5a5d1696f99c4fdcac91","durationMs":9840,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,4865],[4865,9840]],"words":[[0,846],[846,1692],[1692,2538],[2538,2961],[2961,3278],[3278,4865],[4865,5288],[5288,6134],[6134,6557],[6557,7403],[7403,8038],[8038,8461],[8461,8778],[8778,9840]]}}},{"n":2,"text":"Yams so big and fish so fresh,\npineapples sweet in a basket of mesh.","sentences":["Yams so big and fish so fresh,\npineapples sweet in a basket of mesh."],"alt":"Big yams, fresh fish and pineapples in a mesh basket.","image":{"hash":"sha256:c90b36a7df3c45024be61b3b36c21006d7d3405f3364779d9e6aab067cf7296d","width":960,"height":717},"audio":{"hash":"sha256:c273a1eb70547c1e59e4de62efa75c3ab6076b0ebacc4b1478ed8e910a656f99","durationMs":9760,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,9760]],"words":[[0,601],[601,901],[901,1351],[1351,1801],[1801,2402],[2402,2702],[2702,4204],[4204,5706],[5706,6457],[6457,6757],[6757,7057],[7057,7958],[7958,8258],[8258,9760]]}}},{"n":3,"text":"Clink go the coins in the trader’s hand;\nchatter and laughter, a happy band.","sentences":["Clink go the coins in the trader’s hand;\nchatter and laughter, a happy band."],"alt":"A trader counts coins while customers laugh.","image":{"hash":"sha256:223201dc0cada5206558a1dbe5c390df35329c6ec2e7c8c0555120c97455f2e7","width":960,"height":717},"audio":{"hash":"sha256:accad3d6e0ae0afd2c553dead6622c1bbbe6d1d1c504649b865523fa1936a839","durationMs":7840,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,7840]],"words":[[0,516],[516,722],[722,1031],[1031,1547],[1547,1753],[1753,2062],[2062,2784],[2784,3712],[3712,4434],[4434,4743],[4743,6084],[6084,6290],[6290,6806],[6806,7840]]}}},{"n":4,"text":"“Auntie, please, make it small!”\n“Madam, my price is fair for all!”","sentences":["“Auntie, please, make it small!”\n“Madam, my price is fair for all!”"],"alt":"A customer and a trader bargain with friendly faces.","image":{"hash":"sha256:e74f98c23a9a94736497e1c066ba39f62e39766833c925a8e63d6b1f1adce690","width":960,"height":717},"audio":{"hash":"sha256:1b9afec021f7f62e835fd5daa671f9da51ac11980d2d61885c31e10213ecb93c","durationMs":10080,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,10080]],"words":[[0,1404],[1404,2808],[2808,3318],[3318,3573],[3573,5615],[5615,6891],[6891,7146],[7146,7784],[7784,8039],[8039,8549],[8549,8932],[8932,10080]]}}},{"n":5,"text":"Baskets on heads, so balanced and straight,\nwalking in rhythm, never late.","sentences":["Baskets on heads, so balanced and straight,\nwalking in rhythm, never late."],"alt":"Women and girls walk with baskets on their heads in a line.","image":{"hash":"sha256:b700b6ab01c422838d91ccbc7b50998409c6093df9f9f69f884bea26acedb1c7","width":960,"height":717},"audio":{"hash":"sha256:a9c5d98a4f64a2c0c5970daeae7b4f748a6c23a1b906f5720c67ad036845b6b9","durationMs":9080,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,9080]],"words":[[0,795],[795,1022],[1022,2157],[2157,2384],[2384,3292],[3292,3633],[3633,5109],[5109,5904],[5904,6131],[6131,7380],[7380,7948],[7948,9080]]}}},{"n":6,"text":"Come, come, buy, buy, what will you take?\nFresh from the farm, for goodness’ sake!","sentences":["Come, come, buy, buy, what will you take?","Fresh from the farm, for goodness’ sake!"],"alt":"The whole market sings together under bright awnings.","image":{"hash":"sha256:4202d91f14573645ee0e9fe886e7d39fe5963ea5c57e3fd912da46f902a7ade4","width":960,"height":717},"audio":{"hash":"sha256:6f40adaf9a5b81c52b294b46127b86e27658bca6eb6e6a3af9a6405c658c07e7","durationMs":6960,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,4095],[4095,6960]],"words":[[0,614],[614,1228],[1228,1774],[1774,2320],[2320,2593],[2593,2866],[2866,3071],[3071,4095],[4095,4436],[4436,4709],[4709,4914],[4914,5528],[5528,5733],[5733,6279],[6279,6960]]}}}],"activities":[{"id":"md-c1","type":"comprehension","afterPage":2,"question":"Which foods does the trader sell in the first two verses?","options":["Tomatoes, plantain, yams, fish and pineapples","Shoes and hats","Books and pencils"],"correctIndex":0},{"id":"md-ph","type":"phonics","afterPage":3,"targetSound":"and","prompt":"Which words rhyme with hand?","options":["band","coins","sand"],"correctIndexes":[0,2]},{"id":"md-c2","type":"comprehension","afterPage":4,"question":"What does “Clink” show?","options":["The sound of coins","The colour of fish","The taste of yam"],"correctIndex":0,"explanation":"Clink is a sound word, called onomatopoeia."},{"id":"md-voc","type":"vocabulary","afterPage":4,"word":"bargain","definition":"To talk about a price to agree on one that is fair.","distractors":["To carry a basket","To cook food"]},{"id":"md-s1","type":"sequencing","prompt":"Put the market day in order.","items":["The traders show their goods.","Coins clink in the trader’s hand.","The customer bargains.","People carry baskets home."]},{"id":"md-sel","type":"sel","afterPage":6,"prompt":"A market can be noisy and busy. How does it make you feel?","feelingOptions":["Excited","Hungry","Happy","Overwhelmed"]}],"glossary":[{"word":"plantain","definition":"A starchy fruit like a big banana that is cooked before eating.","pages":[1]},{"word":"price","definition":"The amount of money you must pay for something.","pages":[4]},{"word":"chatter","definition":"Fast, friendly talking.","pages":[3]},{"word":"balanced","definition":"Steady and not falling over.","pages":[5]}],"assets":{"sha256:c11cccae259d97664910d3489b6c034b4a7569a9e7c76a53747a1b6154472ba4":{"path":"/story-spark-preview/candidates/poem-market-day-song/page1-1.webp","bytes":132802,"type":"image/webp"},"sha256:08bea6b08b32d9b397d6ea376fc567208a0a7e640e0a5a5d1696f99c4fdcac91":{"path":"/story-spark-preview/audio/08bea6b08b32.mp3","bytes":39788,"type":"audio/mpeg"},"sha256:c90b36a7df3c45024be61b3b36c21006d7d3405f3364779d9e6aab067cf7296d":{"path":"/story-spark-preview/candidates/poem-market-day-song/page2-1.webp","bytes":143626,"type":"image/webp"},"sha256:c273a1eb70547c1e59e4de62efa75c3ab6076b0ebacc4b1478ed8e910a656f99":{"path":"/story-spark-preview/audio/c273a1eb7054.mp3","bytes":39500,"type":"audio/mpeg"},"sha256:223201dc0cada5206558a1dbe5c390df35329c6ec2e7c8c0555120c97455f2e7":{"path":"/story-spark-preview/candidates/poem-market-day-song/page3-1.webp","bytes":121676,"type":"image/webp"},"sha256:accad3d6e0ae0afd2c553dead6622c1bbbe6d1d1c504649b865523fa1936a839":{"path":"/story-spark-preview/audio/accad3d6e0ae.mp3","bytes":31820,"type":"audio/mpeg"},"sha256:e74f98c23a9a94736497e1c066ba39f62e39766833c925a8e63d6b1f1adce690":{"path":"/story-spark-preview/candidates/poem-market-day-song/page4-1.webp","bytes":119660,"type":"image/webp"},"sha256:1b9afec021f7f62e835fd5daa671f9da51ac11980d2d61885c31e10213ecb93c":{"path":"/story-spark-preview/audio/1b9afec021f7.mp3","bytes":40748,"type":"audio/mpeg"},"sha256:b700b6ab01c422838d91ccbc7b50998409c6093df9f9f69f884bea26acedb1c7":{"path":"/story-spark-preview/candidates/poem-market-day-song/page5-1.webp","bytes":135104,"type":"image/webp"},"sha256:a9c5d98a4f64a2c0c5970daeae7b4f748a6c23a1b906f5720c67ad036845b6b9":{"path":"/story-spark-preview/audio/a9c5d98a4f64.mp3","bytes":36812,"type":"audio/mpeg"},"sha256:4202d91f14573645ee0e9fe886e7d39fe5963ea5c57e3fd912da4