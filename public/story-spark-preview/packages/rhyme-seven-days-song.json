{"schemaVersion":1,"storyId":"rhyme-seven-days-song","version":1,"title":"Seven Days, Seven Ways (a song)","ageTiers":["5-6","7-8"],"language":"en","narrationLocale":"en-GH","pages":[{"n":1,"text":"On Monday we sweep and tidy the floor,\nOn Tuesday we count and count some more.","sentences":["On Monday we sweep and tidy the floor,\nOn Tuesday we count and count some more."],"alt":"Children sweep a classroom and count pebbles.","image":{"hash":"sha256:caf547dbcc4a4cd66f90bb00d42998a096c9139ae0d34213c4e19a3fe40f8dc7","width":960,"height":717},"audio":{"hash":"sha256:3d8fafb6e6503a29dcc5f03c6c989726c927262d4bc928412b0795ae296f3d7d","durationMs":10360,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,10360]],"words":[[0,309],[309,1237],[1237,1546],[1546,2319],[2319,2783],[2783,3402],[3402,3866],[3866,4871],[4871,5180],[5180,6262],[6262,6572],[6572,7345],[7345,7809],[7809,8582],[8582,9200],[9200,10360]]}}},{"n":2,"text":"On Wednesday we draw with a crayon or two,\nOn Thursday we sing a song for you.","sentences":["On Wednesday we draw with a crayon or two,\nOn Thursday we sing a song for you."],"alt":"Children draw pictures and sing in a circle.","image":{"hash":"sha256:c99921d147e4095a330a4f4927f23f787179fa6f8df912286184f45068e446b4","width":960,"height":717},"audio":{"hash":"sha256:ae4483d45013c03ebb173665711605ea659aeb53abff4e6a94d2df89d58faef9","durationMs":9120,"timing":{"granularity":"word","method":"tts-marks","verified":true,"sentences":[[0,9120]],"words":[[0,281],[281,1543],[1543,1824],[1824,2385],[2385,2946],[2946,3087],[3087,3929],[3929,4209],[4209,4841],[4841,5121],[5121,6244],[6244,6524],[6524,7086],[7086,7226],[7226,7787],[7787,8208],[8208,9120]]}}},{"n":3,"text":"On Friday we read a story with a friend,\nOn Saturday we play until day’s end.","sentences":["On Friday we read a story with a friend,\nOn Saturday we play until day’s end."],"alt":"Two children read a book and then play outdoors.","image":{"hash":"sha256:68098aea