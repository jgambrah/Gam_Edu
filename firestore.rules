rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // 1. HELPER FUNCTIONS
    // =========================================================
    
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Efficiently get user role and school from the best available source
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : (exists(/databases/$(database)/documents/staff/$(request.auth.uid))
           ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data
           : {});
    }

    function getUserRole() {
      return getUserData().get('role', '');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2" || 
        request.auth.uid == "gZxe3nMbGcQhNgEzkwEZwDBnkFR2" ||
        getUserRole() in ['Director', 'Administrator', 'Admin']
      );
    }

    function isTeacher() { return isSignedIn() && getUserRole() == 'Teacher'; }
    function isStaff() { return exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isParent() { return exists(/databases/$(database)/documents/parents/$(request.auth.uid)); }
    function isFinanceStaff() { return getUserRole() in ['Accountant', 'Administrator', 'Director', 'Admin']; }
    function isDirector() { return getUserRole() == 'Director'; }
    function isLibrarian() { return getUserRole() == 'Librarian'; }

    // =========================================================
    // 2. SAAS CORE
    // =========================================================

    match /schools/{schoolId} {
      allow read, write: if request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2" || request.auth.uid == "gZxe3nMbGcQhNgEzkwEZwDBnkFR2"; 
      allow read: if isSignedIn() && getUserData().get('schoolId', '') == schoolId;
      allow update: if isSignedIn() && isDirector() && getUserData().get('schoolId', '') == schoolId;
    }
    
    match /schoolSettings/{docId} { 
      allow read: if isSignedIn(); 
      allow write: if isAdmin(); 
      match /{subcollection}/{subdocId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /leads/{leadId} {
      allow read, write: if request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2" || request.auth.uid == "gZxe3nMbGcQhNgEzkwEZwDBnkFR2";
    }

    // =========================================================
    // 3. CORE COLLECTIONS
    // =========================================================

    match /users/{userId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    match /staff/{staffId} { 
      allow get: if isSignedIn();
      allow list: if isAdmin() || isFinanceStaff();
      allow write: if isAdmin() || isOwner(staffId); 
      match /payroll/{configId} { 
        allow read, write: if isFinanceStaff() || isAdmin(); 
      } 
    }
    match /students/{studentId} { allow read, list: if isSignedIn(); allow write: if isAdmin() || isOwner(studentId); }
    match /parents/{parentId} { allow read, list: if isSignedIn(); allow write: if isAdmin() || isOwner(parentId); }
    
    match /notifications/{notificationId} { 
      allow create: if isSignedIn(); 
      allow read, update, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid); 
      allow delete: if isAdmin(); 
    }
    
    match /auditLogs/{logId} { 
        allow read, list: if isSignedIn() && (isAdmin() || isFinanceStaff()); 
        allow create: if isSignedIn(); 
        allow update, delete: if false; 
    }
    
    match /announcements_v2/{announcementId} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }

    // =========================================================
    // 5. HR & STAFF
    // =========================================================

    match /leaveRequests/{requestId} { 
      allow create: if isSignedIn();
      allow read, list: if isAdmin() || isFinanceStaff();
      allow read: if isSignedIn() && resource.data.staffId == request.auth.uid;
      allow write: if isAdmin();
    }
    
    match /performanceReviews/{reviewId} { 
      allow read, list: if isAdmin() || (isSignedIn() && resource.data.staffId == request.auth.uid); 
      allow write: if isAdmin(); 
    }

    // =========================================================
    // 6. ACADEMICS
    // =========================================================

    match /classes/{classId} { allow read, list: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /subjects/{subjectId} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    match /timetables/{timetableId} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    match /rooms/{roomId} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    match /timeSlots/{timeSlotId} { allow read, list: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    
    match /attendance/{attendanceId} {
        allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher() || isStaff() || isAdmin());
        allow list: if isSignedIn() && (isTeacher() || isStaff() || isAdmin());
        allow write: if isTeacher() || isAdmin();
    }

    match /staff_attendance/{attendanceId} {
        allow create: if isSignedIn();
        allow read: if isAdmin() || isOwner(resource.data.staffId);
        allow list: if isAdmin() || (isSignedIn() && isStaff());
    }

    match /report-cards/{reportId} {
        allow get: if isSignedIn() && (
            isTeacher() || isStaff() || isAdmin() || 
            resource.data.studentId == request.auth.uid ||
            (isParent() && request.auth.uid in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.studentIds)
        );
        allow list: if isSignedIn();
        allow write: if isTeacher() || isStaff() || isAdmin();
    }

    match /assignments/{assignmentId} { 
      allow read, list: if isSignedIn(); 
      allow write: if isTeacher() || isAdmin(); 
      match /submissions/{submissionId} { 
        allow read, list: if isTeacher() || isAdmin() || request.auth.uid == resource.data.studentId; 
        allow create: if isStudent(); 
        allow update: if isTeacher() || isAdmin(); 
      } 
    }
    
    match /quizzes/{quizId} { 
      allow read, list: if isSignedIn(); 
      allow create: if isStaff() && request.resource.data.teacherId == request.auth.uid; 
      allow update, delete: if isTeacher() && get(/databases/$(database)/documents/quizzes/$(quizId)).data.teacherId == request.auth.uid; 
      match /attempts/{attemptId} { 
        allow read, list: if isTeacher() || isAdmin() || request.auth.uid == resource.data.studentId; 
        allow create: if isStudent(); 
      } 
    }
    
    match /quizAttempts/{attemptId} { 
        allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher() || isStaff() || isAdmin());
        allow list: if isSignedIn();
        allow create: if isStudent(); 
        allow update, delete: if isTeacher() || isAdmin(); 
    }
    
    match /lesson-plans/{planId} {
      allow read, list: if isSignedIn();
      allow create: if (isStaff() && request.resource.data.teacherId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /learning_materials/{materialId} { allow read, list: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    
    match /behavioral_records/{recordId} {
        allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher() || isStaff() || isAdmin());
        allow list: if isSignedIn() && (isTeacher() || isStaff() || isAdmin());
        allow write: if isTeacher() || isStaff() || isAdmin();
    }

    // =========================================================
    // 7. FINANCE
    // =========================================================

    match /tills/{tillId} { 
      allow read, write, list: if isFinanceStaff() || isAdmin(); 
      match /transactions/{transactionId} { allow read, write, list: if isFinanceStaff() || isAdmin(); } 
    }

    match /bank_transactions/{transactionId} {
        allow read, list: if isFinanceStaff() || isAdmin();
        allow create: if isFinanceStaff();
        allow update: if isAdmin();
    }

    match /financialRecords/{recordId} { 
      allow get: if isSignedIn() && (
        isFinanceStaff() || isAdmin() || isTeacher() ||
        (resource.data.studentId == request.auth.uid) ||
        (isParent() && resource.data.studentId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.get('studentIds', []))
      ); 
      allow list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin() || isTeacher(); 

      match /payments/{paymentId} {
        allow read, write: if isFinanceStaff() || isAdmin() || isTeacher();
        allow read: if isSignedIn() && (
            get(/databases/$(database)/documents/financialRecords/$(recordId)).data.studentId == request.auth.uid ||
            (isParent() && get(/databases/$(database)/documents/financialRecords/$(recordId)).data.studentId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.get('studentIds', []))
        );
      }
    }
    
    match /accountsPayable/{payableId} { allow read, write, list: if isFinanceStaff() || isAdmin(); }
    match /inventory/{itemId} { 
        allow read, list: if isSignedIn(); 
        allow write: if isFinanceStaff() || isAdmin(); 
        match /transactions/{tId} { allow read, write, list: if isFinanceStaff() || isAdmin(); }
    }
    
    match /school_shop_items/{itemId} { 
      allow read, list: if isSignedIn(); 
      allow write: if isFinanceStaff() || isAdmin(); 
      match /transactions/{tId} { allow read, write, list: if isFinanceStaff() || isAdmin(); }
    }
    match /school_shop_transactions/{transId} { allow read, write, list: if isFinanceStaff() || isAdmin(); }
    
    match /accounts/{accountId} { allow read, list: if isFinanceStaff() || isAdmin(); allow write: if isAdmin(); }
    match /journal_entries/{entryId} { allow read, list: if isFinanceStaff() || isAdmin(); allow create: if isFinanceStaff() || isAdmin(); }
    match /payrollSettings/{settingsId} { allow read, list: if isFinanceStaff(); allow write: if isAdmin(); }
    match /payrollRecords/{recordId} { 
      allow read, write: if isFinanceStaff() || isAdmin(); 
      allow get: if isSignedIn() && request.auth.uid == resource.data.staffId; 
      allow list: if isSignedIn() && (isFinanceStaff() || request.query.where.staffId == request.auth.uid);
    }
    
    match /routes/{routeId} { allow read, list: if isSignedIn(); allow write: if isAdmin() || isFinanceStaff(); }
    match /buses/{busId} { allow read, list: if isSignedIn(); allow write: if isAdmin() || isFinanceStaff(); }

    // =========================================================
    // 8. CLUBS & COMMUNICATION
    // =========================================================

    match /forumThreads/{threadId} { 
      allow read, list: if isSignedIn(); 
      allow create: if isSignedIn(); 
      allow update, delete: if isAdmin() || request.auth.uid == resource.data.createdBy.uid; 
      match /replies/{replyId} { 
        allow read, list: if isSignedIn(); 
        allow create: if isSignedIn(); 
        allow update, delete: if isAdmin() || request.auth.uid == resource.data.author.uid; 
      } 
    }
    
    match /direct_messages/{chatId} { 
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow list: if isSignedIn() && request.auth.uid in request.query.where.participants; 
      allow create: if isSignedIn();
      match /messages/{messageId} { 
        allow read, create: if isSignedIn(); 
      } 
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}