
/**
 * @fileoverview Firestore Security Rules for CampusConnect application.
 *
 * Core Philosophy:
 * This ruleset implements role-based access control (RBAC) where access is determined by a user's role.
 * Only authenticated users can access data, with admin users having elevated privileges. Data validation
 * is relaxed to allow for rapid prototyping.
 *
 * Data Structure:
 * - /roles/{roleId}: Stores role definitions, accessible only to admins.
 * - /staff/{staffId}: Stores staff profiles, accessible to admins for management and individual staff members for their own profiles.
 * - /roles_admin/{uid}: Documents in this collection indicate admin privileges for the given user.
 * - /students/{studentId}: Stores student profiles, accessible only to admins.
 * - /parents/{parentId}: Stores parent profiles, accessible only to admins.
 * - /classes/{classId}: Stores class information, accessible only to admins.
 *
 * Key Security Decisions:
 * - Only admins can create, update, or delete roles, students, parents, and classes.
 * - Staff can only read their own profile; admins can manage all staff profiles.
 * - Listing of roles is allowed only for admins.
 * - Listing of staff is allowed for any signed-in user for now.
 * - Listing of students, parents, and classes is allowed only for admins.
 * - The existence of a document in `/roles_admin/{uid}` grants admin privileges to the user.
 *
 * Denormalization for Authorization:
 * - The `staff` documents include a `roleId` field, denormalizing the role assignment. This allows rules to check a user's role directly on the staff document without needing a separate `get()` call to the `roles` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants administrators full access to manage roles.
     * @path /roles/{roleId}
     */
    match /roles/{roleId} {
      allow create: if isAdmin();
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Allows admins to manage staff profiles and staff to view their own profile.
     * @path /staff/{staffId}
     */
    match /staff/{staffId} {
        allow read: if isSignedIn();
        allow create: if isAdmin();
        allow update, delete: if isAdmin() || isOwner(staffId);
    }

    /**
     * @description Grants administrators full access to manage student profiles.
     * @path /students/{studentId}
     */
    match /students/{studentId} {
      allow create: if isAdmin();
      allow read: if isSignedIn();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
    
    /**
     * @description Grants any signed-in user read access to parent profiles.
     * @path /parents/{parentId}
     */
    match /parents/{parentId} {
      allow create: if isAdmin();
      allow read: if isSignedIn();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Grants administrators full access to manage classes.
     * @path /classes/{classId}
     */
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Grants admin privileges to a user by creating a document with their UID.
     * @path /roles_admin/{uid}
     */
    match /roles_admin/{uid} {
      allow create: if isAdmin();
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for assignments.
     * @path /assignments/{assignmentId}
     */
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isTeacher();
      allow update, delete: if isTeacher() && isAssignmentOwner(assignmentId);
    }

    /**
     * @description Rules for student submissions.
     * @path /assignments/{assignmentId}/submissions/{submissionId}
     */
    match /assignments/{assignmentId}/submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create: if isStudent();
      allow update: if isTeacher() || isOwner(request.resource.data.studentId);
    }

    /**
     * @description Rules for quizzes.
     * @path /quizzes/{quizId}
     */
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create: if isTeacher();
      allow update, delete: if isTeacher() && isQuizOwner(quizId);
    }
    
    /**
     * @description Rules for quiz attempts.
     * @path /quizzes/{quizId}/attempts/{attemptId}
     */
    match /quizzes/{quizId}/attempts/{attemptId} {
        allow read: if isTeacher() || isOwner(request.resource.data.studentId);
        allow create: if isStudent();
    }

    /**
     * @description Rules for manual assessments and grade entries.
     * @path /assessments/{assessmentId}
     */
    match /assessments/{assessmentId} {
      allow list, read: if isSignedIn();
      allow create, update: if isTeacher() || isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for behavioral and incident logs.
     * @path /behavioral_records/{recordId}
     */
    match /behavioral_records/{recordId} {
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      allow write: if request.auth != null;
    }

    /**
     * @description Rules for report cards.
     * @path /report-cards/{reportCardId}
     */
    match /report-cards/{reportCardId} {
        allow read: if isSignedIn();
        allow create, update: if isTeacher() || isAdmin();
    }

     /**
     * @description Rules for report card comments.
     * @path /report-cards/{reportCardId}/comments/{commentId}
     */
    match /report-cards/{reportCardId}/comments/{commentId} {
        allow read: if isSignedIn();
        allow create, update: if isTeacher() && get(/databases/$(database)/documents/report-cards/$(reportCardId)).data.status == 'Draft';
        allow delete: if isTeacher() && get(/databases/$(database)/documents/report-cards/$(reportCardId)).data.status == 'Draft';
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /timeSlots/{timeSlotId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /timetables/{timetableEntryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /lesson-plans/{lessonPlanId} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    match /library/{itemId} {
      allow read: if isSignedIn();
      allow create, delete: if isLibrarianOrAdmin();
      allow update: if isLibrarianOrAdmin() || (isBorrower() && canRequest(itemId));
    }
    
    match /attendance/{attendanceId} {
      allow read: if isTeacher() || isAdmin() || isOwner(resource.data.studentId);
      allow create: if isTeacher() || isAdmin();
    }

    match /admissionApplications/{applicationId} {
      allow read: if isAdmin();
      allow create: if isParent();
      allow update: if isAdmin();
    }
    
    match /leaveRequests/{requestId} {
      allow read: if isStaff() || isAdmin();
      allow create: if isStaff() && isOwner(request.resource.data.staffId);
      allow update: if isAdmin();
    }

    match /publicHolidays/{holidayId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /performanceReviews/{reviewId} {
        allow read, write: if isAdmin();
    }

    match /financialRecords/{recordId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff();
    }

    match /payrollSettings/{settingsId} {
      allow read, write, list: if request.auth != null;
    }

    match /staff/{staffId}/payroll/{configId} {
      allow read, write: if isFinanceStaff();
    }

    match /payrollRecords/{recordId} {
      allow read: if isFinanceStaff() || isOwner(resource.data.staffId);
    }

    match /vendors/{vendorId} {
      allow read, write, list: if request.auth != null;
    }
    
    match /accountsPayable/{payableId} {
      allow read, write, list: if request.auth != null;
    }

    match /inventory/{itemId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }
    
    match /inventory/{itemId}/transactions/{transactionId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
    }
    
    match /announcements/{announcementId} {
      allow create, update, delete: if isAdmin();
      allow read: if isSignedIn() && (isAdmin() || canReadAnnouncement(resource.data.audience));
    }


    // ------ Helper Functions ------

    /**
     * @description Checks if the request is made by an authenticated user.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document based on the provided userId.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user has admin privileges.
     * This now checks for a specific email or falls back to checking the role in the user's staff document.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      // Super admin check for initial setup or a specific high-privilege account.
      if (request.auth != null && request.auth.token.email == 'jamesgambrah@sunnyside.com') {
        return true;
      }
      
      // Standard role-based check for other administrators or directors.
      if (isSignedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid))) {
        let userRole = get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role;
        return userRole == 'Administrator' || userRole == 'Director';
      }
      
      return false;
    }

    function isTeacher() {
      if (!exists(/databases/$(database)/documents/staff/$(request.auth.uid))) { return false; }
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'Teacher';
    }
    
    function isLibrarianOrAdmin() {
      if (!exists(/databases/$(database)/documents/staff/$(request.auth.uid))) { return false; }
      let userRole = get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role;
      return userRole == 'Librarian' || userRole == 'Administrator' || userRole == 'Director';
    }

    function isFinanceStaff() {
        if (!exists(/databases/$(database)/documents/staff/$(request.auth.uid))) { return false; }
        let userRole = get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role;
        return userRole == 'Accountant' || userRole == 'Administrator' || userRole == 'Director';
    }

    function isStudent() {
      return exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }
    
    function isParent() {
        return exists(/databases/$(database)/documents/parents/$(request.auth.uid));
    }

    function isBorrower() {
      return isStudent() || isTeacher();
    }

    function isStaff() {
        return exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function canReadAnnouncement(audience) {
      // This function can be improved by checking a `role` custom claim in the auth token.
      // For now, it requires a GET, which is not ideal for performance.
      if ('Everybody' in audience) {
        return true;
      }
      if (request.auth == null) {
        return false;
      }
      // Check for student or parent role from their respective collections
      if (isStudent() && 'Student' in audience) {
        return true;
      }
      if (isParent() && 'Parent' in audience) {
        return true;
      }
      // Check for staff role
      if (!exists(/databases/$(database)/documents/staff/$(request.auth.uid))) { return false; }
      let userRole = get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role;
      return userRole in audience;
    }
    
    function isAssignmentOwner(assignmentId) {
        let assignment = get(/databases/$(database)/documents/assignments/$(assignmentId)).data;
        return assignment.teacherId == request.auth.uid;
    }

    function isQuizOwner(quizId) {
        let quiz = get(/databases/$(database)/documents/quizzes/$(quizId)).data;
        return quiz.teacherId == request.auth.uid;
    }

    function canRequest(itemId) {
      let currentStatus = resource.data.status;
      let incomingStatus = request.resource.data.status;
      // Allow a borrower to change status from 'Available' to 'Requested'
      return currentStatus == 'Available' && incomingStatus == 'Requested'
        // And allow them to change status from 'Borrowed' to 'Pending Return'
        || currentStatus == 'Borrowed' && incomingStatus == 'Pending Return'
        // And ensure they are the owner of the item they are trying to return
        && resource.data.currentHolderId == request.auth.uid;
    }
  }
}

    