rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // 1. HELPER FUNCTIONS
    // =========================================================

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isSuperAdmin() {
      return request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2" ||
             request.auth.uid == "gZxe3nMbGcQhNgEzkwEZwDBnkFR2";
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
           ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
           : '');
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        getUserRole() in ['Director', 'Administrator', 'Admin']
      );
    }

    function isTeacher() { return isSignedIn() && getUserRole() == 'Teacher'; }
    function isStudent() { return exists(/databases/$(database)/documents/students/$(request.auth.uid)); }
    function isStaff() { return exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isParent() { return exists(/databases/$(database)/documents/parents/$(request.auth.uid)); }

    function isFinanceStaff() {
      let role = getUserRole();
      if (role in ['Accountant', 'Director', 'Admin']) return true;
      return false;
    }

    function isDirector() { return isAdmin(); }
    function isLibrarian() { return isAdmin() || getUserRole() == 'Librarian'; }
    function isTransportStaff() { return isAdmin() || getUserRole() == 'Transport Staff'; }

    function parentOwnsStudent(studentId) {
      return isParent() && studentId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.studentIds;
    }

    function isAnyStaff(schoolId) {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.schoolId == schoolId)
      );
    }

    // =========================================================
    // 2. SECURITY & AUDIT (SPOT CHECKS)
    // =========================================================

    // v1.4: Consolidated rule to fix 'list' permissions for all users
    match /spot_checks/{checkId} {
        allow get, list: if isSignedIn();
        allow create: if isAdmin();
        allow update: if isSignedIn(); // Allow staff to submit responses
        allow delete: if isAdmin();
    }

    // =========================================================
    // 3. SAAS CORE
    // =========================================================

    match /schools/{schoolId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isSuperAdmin();
      allow update: if isSignedIn() && isDirector();
    }

    match /schoolSettings/{schoolId} {
      allow read: if isSuperAdmin() || isAnyStaff(schoolId);
      allow write: if isSuperAdmin() || isDirector();

      match /{allPaths=**} {
        allow read: if isSuperAdmin() || isAnyStaff(schoolId);
        allow write: if isSuperAdmin() || isDirector();
      }
    }

    match /leads/{leadId} {
      allow read, write: if isSuperAdmin();
    }

    // =========================================================
    // 4. CORE COLLECTIONS
    // =========================================================

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    match /staff/{staffId} {
      allow get: if (resource.data.showOnWebsite == true) || isSignedIn();
      allow list: if (resource.data.showOnWebsite == true) || isAdmin() || isFinanceStaff() || isTransportStaff();
      allow write: if isAdmin() || isOwner(staffId);
      match /payroll/{configId} {
        allow read, write: if isFinanceStaff() || isAdmin();
      }
    }

    match /students/{studentId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isOwner(studentId);
    }

    match /parents/{parentId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isOwner(parentId);
    }

    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read, update, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFinanceStaff();
    }

    match /announcements_v2/{announcementId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================================================
    // 5. HR & STAFF
    // =========================================================

    match /leaveRequests/{requestId} {
      allow read, write, list: if isSuperAdmin() || isAdmin();
      allow list: if isStaff();
      allow read: if isSignedIn() && (resource.data.staffId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if isSignedIn();
    }

    match /performanceReviews/{reviewId} {
      allow read, list: if isAdmin() || (isSignedIn() && resource.data.staffId == request.auth.uid);
      allow write: if isAdmin();
    }

    // =========================================================
    // 6. ACADEMICS
    // =========================================================

    match /classes/{classId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /subjects/{subjectId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId}/assessments/{assessmentId} {
        allow read, list: if isSignedIn();
        allow write: if isAdmin() || isTeacher();
    }

    match /timetables/{timetableId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /timeSlots/{timeSlotId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /school_calendar/{eventId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isTeacher() || isStaff() || isAdmin() || isDirector() ||
        parentOwnsStudent(resource.data.studentId)
      );
      allow list: if isSignedIn();
      allow write: if isTeacher() || isAdmin() || isDirector();
    }

    match /staff_attendance/{attendanceId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || isOwner(resource.data.staffId);
      allow list: if isAdmin() || (isSignedIn() && isStaff());
    }

    match /report-cards/{reportId} {
      allow get: if isSignedIn() && (
        isTeacher() || isStaff() || isAdmin() || isDirector() ||
        resource.data.studentId == request.auth.uid ||
        parentOwnsStudent(resource.data.studentId)
      );
      allow list: if isSignedIn();
      allow write: if isTeacher() || isStaff() || isAdmin();
    }

    match /report_card_remarks/{id} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
      match /submissions/{submissionId} {
        allow read, list: if isTeacher() || isAdmin() || request.auth.uid == resource.data.studentId;
        allow create: if isStudent();
        allow update: if isTeacher() || isAdmin();
      }
    }

    match /submissions/{submissionId} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn();
      allow update: if isTeacher() || isAdmin();
      allow delete: if false;
    }

    match /quizzes/{quizId} {
      allow read, list: if isSignedIn();
      allow create: if isStaff() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && get(/databases/$(database)/documents/quizzes/$(quizId)).data.teacherId == request.auth.uid;
      match /attempts/{attemptId} {
        allow read, list: if isTeacher() || isAdmin() || request.auth.uid == resource.data.studentId;
        allow create: if isStudent();
      }
    }

    match /quizAttempts/{attemptId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher() || isStaff() || isAdmin());
      allow list: if isSignedIn();
      allow create: if isStudent();
      allow update, delete: if isTeacher() || isAdmin();
    }

    match /assessments/{assessmentId} {
      allow get: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isTeacher() || isStaff() || isAdmin() || isDirector()
      );
      allow list: if isSignedIn();
      allow create, update: if isTeacher() || isStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    match /lesson-plans/{planId} {
      allow read, list: if isSignedIn();
      allow create: if (isStaff() && request.resource.data.teacherId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /learning_materials/{materialId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /behavioral_records/{recordId} {
      allow get: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isTeacher() || isStaff() || isAdmin() || isDirector() ||
        parentOwnsStudent(resource.data.studentId)
      );
      allow list: if isSignedIn();
      allow create, update: if isTeacher() || isStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================
    // 7. FINANCE
    // =========================================================

    match /tills/{tillId} {
      allow read, write, list: if isFinanceStaff() || isAdmin();
      match /transactions/{transactionId} {
        allow read, write, list: if isFinanceStaff() || isAdmin();
      }
    }

    match /bank_transactions/{transactionId} {
      allow read, list: if isFinanceStaff() || isAdmin();
      allow create: if isFinanceStaff();
      allow update: if isAdmin();
    }

    match /financialRecords/{recordId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        isFinanceStaff() || isAdmin() || isTeacher() ||
        resource.data.studentId == request.auth.uid ||
        parentOwnsStudent(get(/databases/$(database)/documents/financialRecords/$(recordId)).data.studentId)
      );
      allow list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin() || isTeacher();
      match /payments/{paymentId} {
        allow read, write: if isFinanceStaff() || isAdmin() || isTeacher();
        allow read: if isSignedIn() && (
          exists(/databases/$(database)/documents/financialRecords/$(recordId)) &&
          (get(/databases/$(database)/documents/financialRecords/$(recordId)).data.studentId == request.auth.uid ||
           parentOwnsStudent(get(/databases/$(database)/documents/financialRecords/$(recordId)).data.studentId))
        );
      }
    }

    match /vendors/{vendorId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /accountsPayable/{payableId} {
      allow read, list: if isFinanceStaff() || isAdmin();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /accountsReceivable/{receivableId} {
      allow read, list: if isFinanceStaff() || isAdmin();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /inventory/{itemId} {
      allow read, list: if isSuperAdmin() || (isSignedIn() && isStaff());
      allow write: if isSuperAdmin() || isFinanceStaff() || isAdmin() || isDirector();
    }

    match /suppliers/{id} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /purchase_orders/{id} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /vendor_bills/{id} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /products/{productId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff();
    }

    match /categories/{categoryId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff();
    }

    match /pos_transactions/{transactionId} {
      allow read, create, list: if isSignedIn();
      allow update: if isFinanceStaff();
    }

    match /school_shop_items/{itemId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /school_shop_transactions/{transId} {
      allow read, write, list: if isFinanceStaff() || isAdmin();
    }

    match /accounts/{accountId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /journal_entries/{entryId} {
      allow read, list: if isFinanceStaff() || isAdmin();
      allow create: if isFinanceStaff() || isAdmin();
      allow update: if false;
    }

    match /payment_vouchers/{voucherId} {
      allow read, write, list: if isFinanceStaff() || isAdmin();
    }

    match /payrollSettings/{settingsId} {
      allow read, list: if isFinanceStaff();
      allow write: if isAdmin();
    }

    match /payroll_settings/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /payroll_runs/{runId} {
      allow read, list: if isFinanceStaff() || isAdmin() || (isSignedIn() && request.auth.uid == resource.data.staffId);
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /payrollRecords/{recordId} {
      allow read, write: if isAdmin() || isFinanceStaff();
      allow get: if isSignedIn() && (isAdmin() || isFinanceStaff() || resource.data.staffId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || isFinanceStaff() || request.query.where.staffId == request.auth.uid);
    }

    match /staff_salary_details/{userId} {
      allow read, list: if isFinanceStaff() || isAdmin() || request.auth.uid == userId;
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /routes/{routeId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isFinanceStaff() || isTransportStaff();
    }

    match /buses/{busId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isFinanceStaff() || isTransportStaff();
    }

    match /admissionApplications/{applicationId} {
      allow read, write, list: if isAdmin();
      allow create: if true; 
      allow read: if isSignedIn() && resource.data.submittedByParentId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }

  }
}