
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role
        : '';
    }

    function isAdmin() {
      let userRole = getUserRole();
      return isSignedIn() && (userRole == 'Director' || userRole == 'Administrator');
    }

    function isTeacher() {
      return isSignedIn() && getUserRole() == 'Teacher';
    }
    
    function isStudent() {
      return exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }

    function isParent() {
      return exists(/databases/$(database)/documents/parents/$(request.auth.uid));
    }
    
    function isStaff() {
      return exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isLibrarianOrAdmin() {
      let userRole = getUserRole();
      return userRole in ['Librarian', 'Administrator', 'Director'];
    }

    function isFinanceStaff() {
      let userRole = getUserRole();
      return userRole in ['Accountant', 'Administrator', 'Director'];
    }

    // --- Collection Rules ---
    
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(staffId);
    }

    match /students/{studentId} {
      allow read: if isSignedIn(); 
      allow write: if isAdmin() || isOwner(studentId);
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }

    match /timetables/{timetableEntryId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }
    
    match /assignments/{assignmentId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create: if isStaff() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && get(/databases/$(database)/documents/quizzes/$(quizId)).data.teacherId == request.auth.uid;
    }

    match /assessments/{assessmentId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /behavioral_records/{recordId} {
      allow read, write: if isSignedIn();
    }
    
    match /financialRecords/{recordId} {
      allow read, write: if isFinanceStaff();
    }

    match /accountsPayable/{payableId} {
      allow read, write: if isFinanceStaff();
    }
    
    match /vendors/{vendorId} {
      allow read, write: if isFinanceStaff();
    }

    match /lesson-plans/{planId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    match /learning_materials/{materialId} {
      allow read: if true; 
      
      allow write: if isTeacher() || isAdmin();
    }

    // --- MATH CLUB ---
    match /math_problems/{problemId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /user_results/{resultId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow update, delete: if false;
    }

    match /global_leaderboard/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- SCIENCE CLUB ---
    match /science_problems/{problemId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /science_results/{resultId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow update, delete: if false;
    }

    match /science_leaderboard/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /daily_facts/{factId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /attendance/{attendanceId} {
        allow read, list: if isSignedIn();
        allow write: if isTeacher() || isAdmin();
    }

    // Default deny for everything else that has not been matched
    match /{path=**} {
      allow read, write: if false;
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    // Explicitly allow reads and writes to the materials folder for any logged-in user.
    match /materials/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // A general fallback rule for other paths.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
