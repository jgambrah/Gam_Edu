rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // 0. GLOBAL ALERT SYSTEM (SPOT CHECKS) - HIGH PRIORITY
    // =========================================================
    
    match /spot_checks/{checkId} {
        allow read, list: if request.auth != null; 
        allow create: if request.auth != null && (
          exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['Director', 'Administrator', 'Admin']
        );
        allow update: if request.auth != null; 
        allow delete: if request.auth != null && (
          exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['Director', 'Administrator', 'Admin']
        );
    }

    // =========================================================
    // 1. HELPER FUNCTIONS
    // =========================================================

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isSuperAdmin() {
      return request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2" ||
             request.auth.uid == "gZxe3nMbGcQhNgEzkwEZwDBnkFR2";
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
           ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
           : '');
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        getUserRole() in ['Director', 'Administrator', 'Admin']
      );
    }

    function isTeacher() { return isSignedIn() && getUserRole() == 'Teacher'; }
    function isStudent() { return exists(/databases/$(database)/documents/students/$(request.auth.uid)); }
    function isStaff() { return exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isParent() { return exists(/databases/$(database)/documents/parents/$(request.auth.uid)); }

    function isFinanceStaff() { return isAdmin() || getUserRole() == 'Accountant'; }
    function isDirector() { return isAdmin(); }
    function isLibrarian() { return isAdmin() || getUserRole() == 'Librarian'; }
    function isTransportStaff() { return isAdmin() || getUserRole() == 'Transport Staff'; }

    function parentOwnsStudent(studentId) {
      return isParent() && studentId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.studentIds;
    }

    // =========================================================
    // 2. SAAS CORE
    // =========================================================

    match /schools/{schoolId} {
      allow get, list: if true;
      allow write: if isSuperAdmin();
      allow update: if isSignedIn() && isDirector();
    }

    // ─── DASHBOARD SUMMARY (aggregation cache) ────────────────────────────────
    // Read: Director or Administrator of that specific school only.
    // Write: Cloud Functions only (no client write access — prevents tampering).
    match /dashboard_summaries/{schoolId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        getUserRole() in ['Director', 'Administrator']
      );
      allow write: if false; // Server-side only via Cloud Functions
    }


    match /schoolSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFinanceStaff();

      match /{subcollection}/{subdocId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isFinanceStaff();
      }
    }

    match /leads/{leadId} {
      allow read, write: if isSuperAdmin();
    }

    match /tutorials/{tutorialId} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2";
    }

    // =========================================================
    // 3. CORE COLLECTIONS
    // =========================================================

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    match /staff/{staffId} {
      allow get, list: if isSignedIn() || resource.data.showOnWebsite == true;
      allow write: if isAdmin() || isOwner(staffId);
      match /payroll/{configId} {
        allow read, write: if isFinanceStaff() || isAdmin();
      }
    }

    match /students/{studentId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isOwner(studentId);

      match /timeline/{eventId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          (isTeacher() && !(resource.data.category in ['health', 'financial'])) ||
          (isStudent() && studentId == request.auth.uid) ||
          parentOwnsStudent(studentId) ||
          (getUserRole() in ['Nurse', 'Doctor', 'Warden', 'Boarding Staff'] && resource.data.category == 'health')
        );
        
        allow create, update: if isSignedIn() && (
          isAdmin() ||
          (isTeacher() && !(request.resource.data.category in ['health', 'financial'])) ||
          (getUserRole() in ['Nurse', 'Doctor', 'Warden', 'Boarding Staff'] && request.resource.data.category == 'health')
        );
        
        allow delete: if isSignedIn() && isAdmin();
      }
    }

    match /parents/{parentId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isOwner(parentId);
    }

    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read, update, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFinanceStaff();
    }

    match /announcements_v2/{announcementId} {
      allow read, list: if isSignedIn() || 'Everybody' in resource.data.audience;
      allow write: if isAdmin();
    }

    // =========================================================
    // 5. HR & STAFF
    // =========================================================

    match /leaveRequests/{requestId} {
      allow read, write, list: if isSuperAdmin() || isAdmin();
      allow list: if isStaff();
      allow read: if isSignedIn() && (resource.data.staffId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if isSignedIn();
    }

    match /performanceReviews/{reviewId} {
      allow read, list: if isAdmin() || (isSignedIn() && resource.data.staffId == request.auth.uid);
      allow write: if isAdmin();
    }

    // =========================================================
    // 6. ACADEMICS
    // =========================================================

    match /classes/{classId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /subjects/{subjectId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId}/assessments/{assessmentId} {
        allow read, list: if isSignedIn();
        allow write: if isAdmin() || isTeacher();
    }

    match /timetables/{timetableId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /timeSlots/{timeSlotId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /school_calendar/{eventId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isTeacher() || isStaff() || isAdmin() || isDirector() ||
        parentOwnsStudent(resource.data.studentId)
      );
      allow list: if isSignedIn();
      allow write: if isTeacher() || isAdmin() || isDirector();
    }

    match /staff_attendance/{attendanceId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || isOwner(resource.data.staffId);
      allow list: if isAdmin() || (isSignedIn() && isStaff());
    }

    match /report-cards/{reportId} {
      allow get: if isSignedIn() && (
        isTeacher() || isStaff() || isAdmin() || isDirector() ||
        resource.data.studentId == request.auth.uid ||
        parentOwnsStudent(resource.data.studentId)
      );
      allow list: if isSignedIn();
      allow write: if isTeacher() || isStaff() || isAdmin();
    }

    match /report_card_remarks/{id} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
      match /submissions/{submissionId} {
        allow read, list: if isTeacher() || isAdmin() || request.auth.uid == resource.data.studentId || parentOwnsStudent(resource.data.studentId);
        allow create: if isStudent();
        allow update: if isTeacher() || isAdmin();
      }
    }

    match /submissions/{submissionId} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn();
      allow update: if isTeacher() || isAdmin();
      allow delete: if false;
    }

    match /quizzes/{quizId} {
      allow read, list: if isSignedIn();
      allow create: if isStaff() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && get(/databases/$(database)/documents/quizzes/$(quizId)).data.teacherId == request.auth.uid;
      match /attempts/{attemptId} {
        allow read, list: if isTeacher() || isAdmin() || request.auth.uid == resource.data.studentId || parentOwnsStudent(resource.data.studentId);
        allow create: if isStudent();
      }
    }

    match /quizAttempts/{attemptId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher() || isStaff() || isAdmin() || parentOwnsStudent(resource.data.studentId));
      allow list: if isSignedIn();
      allow create: if isStudent();
      allow update, delete: if isTeacher() || isAdmin();
    }

    match /assessments/{assessmentId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacher() || isStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    match /lesson-plans/{planId} {
      allow read, list: if isSignedIn();
      allow create: if (isStaff() && request.resource.data.teacherId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /learning_materials/{materialId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /behavioral_records/{recordId} {
      allow get: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isTeacher() || isStaff() || isAdmin() || isDirector() ||
        parentOwnsStudent(resource.data.studentId)
      );
      allow list: if isSignedIn();
      allow create, update: if isTeacher() || isStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================
    // 7. FINANCE
    // =========================================================

    match /tills/{tillId} {
      allow read, write, list: if isFinanceStaff() || isAdmin();
      match /transactions/{transactionId} {
        allow read, write, list: if isFinanceStaff() || isAdmin();
      }
    }

    match /bank_transactions/{transactionId} {
      allow read, list: if isFinanceStaff() || isAdmin();
      allow create: if isFinanceStaff();
      allow update: if isAdmin();
    }

    match /financialRecords/{recordId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        isFinanceStaff() || isAdmin() || isTeacher() ||
        resource.data.studentId == request.auth.uid ||
        parentOwnsStudent(get(/databases/$(database)/documents/financialRecords/$(recordId)).data.studentId)
      );
      allow list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin() || isTeacher();
      match /payments/{paymentId} {
        allow read, write: if isFinanceStaff() || isAdmin() || isTeacher();
        allow read: if isSignedIn() && (
          exists(/databases/$(database)/documents/financialRecords/$(recordId)) &&
          (get(/databases/$(database)/documents/financialRecords/$(recordId)).data.studentId == request.auth.uid ||
           parentOwnsStudent(get(/databases/$(database)/documents/financialRecords/$(recordId)).data.studentId))
        );
      }
    }

    // Collection Group rule for payments
    match /{path=**}/payments/{paymentId} {
      allow read: if isSignedIn() && (
        isFinanceStaff() || 
        isAdmin() || 
        isTeacher() || 
        resource.data.studentId == request.auth.uid || 
        parentOwnsStudent(resource.data.studentId)
      );
    }

    match /reversalLogs/{logId} {
      allow read, list, create: if isFinanceStaff() || isAdmin();
      allow update, delete: if false;
    }

    match /paymentVouchers/{voucherId} {
      allow read, list: if isSuperAdmin() || isFinanceStaff() || isAdmin();
      allow create: if isSuperAdmin() || isFinanceStaff() || isAdmin();
      allow update: if isSuperAdmin() || isAdmin();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /payment_vouchers/{voucherId} {
      allow read, list: if isSuperAdmin() || isFinanceStaff() || isAdmin();
      allow create: if isSuperAdmin() || isFinanceStaff() || isAdmin();
      allow update: if isSuperAdmin() || isAdmin();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /vendors/{vendorId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /sponsors/{sponsorId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /accountsPayable/{payableId} {
      allow read, list: if isFinanceStaff() || isAdmin();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /accountsReceivable/{receivableId} {
      allow read, list: if isFinanceStaff() || isAdmin();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /inventory/{itemId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin() || isDirector();
    }

    match /suppliers/{id} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /purchase_orders/{id} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /vendor_bills/{id} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /products/{productId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff();
    }

    match /categories/{categoryId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff();
    }

    match /pos_transactions/{transactionId} {
      allow read, create, list: if isSignedIn();
      allow update: if isFinanceStaff();
    }

    match /school_shop_items/{itemId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /school_shop_transactions/{transId} {
      allow read, write, list: if isFinanceStaff() || isAdmin();
    }

    match /accounts/{accountId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /journal_entries/{entryId} {
      allow read, list: if isFinanceStaff() || isAdmin();
      allow create: if isFinanceStaff() || isAdmin();
      allow update: if false;
    }

    match /budgets/{budgetId} {
      allow read, list: if isFinanceStaff() || isAdmin();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /budget_items/{itemId} {
      allow read, list: if isFinanceStaff() || isAdmin();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /fixed_assets/{assetId} {
      allow read, write: if isFinanceStaff() || isAdmin();
    }

    match /depreciation_logs/{logId} {
      allow read, write: if isFinanceStaff() || isAdmin();
    }

    match /payrollSettings/{settingsId} {
      allow read, list: if isFinanceStaff();
      allow write: if isAdmin() || isFinanceStaff();
    }

    match /payroll_settings/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /payroll_runs/{runId} {
      allow read, list: if isFinanceStaff() || isAdmin() || (isSignedIn() && request.auth.uid == resource.data.staffId);
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /payrollRecords/{recordId} {
      allow read, write: if isAdmin() || isFinanceStaff();
      allow get: if isSignedIn() && (isAdmin() || isFinanceStaff() || resource.data.staffId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || isFinanceStaff() || request.query.where.staffId == request.auth.uid);
    }

    match /staff_salary_details/{userId} {
      allow read, list: if isFinanceStaff() || isAdmin() || request.auth.uid == userId;
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /routes/{routeId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isFinanceStaff() || isTransportStaff();
    }

    match /buses/{busId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isFinanceStaff() || isTransportStaff();
    }

    // Support Staff Collections
    match /cafeteria_menus/{menuId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cook';
    }

    match /kitchen_inventory/{itemId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cook';
    }

    match /meal_logs/{logId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cook';
    }

    match /canteen_requisitions/{reqId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cook';
    }

    match /canteen_transactions/{transId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cook';
    }

    match /cleaning_tasks/{taskId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cleaner';
    }

    match /sanitation_logs/{logId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cleaner';
    }

    match /cleaning_issues/{issueId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cleaner';
    }

    match /visitor_logs/{logId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Security Officer';
    }

    match /security_incidents/{incidentId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Security Officer';
    }

    match /gate_logs/{logId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Security Officer';
    }

    match /vehicle_logs/{logId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTransportStaff();
    }


    match /admissionApplications/{applicationId} {
      allow read, write, list: if isAdmin() || isSuperAdmin();
      allow create: if true;
      allow read: if isSignedIn() && resource.data.submittedByParentId == request.auth.uid;
    }

    match /admissionEnquiries/{enquiryId} {
      allow read, write, list: if isAdmin() || isSuperAdmin();
      allow create: if true;
    }

    // =========================================================
    // 8. JUNIOR / SENIOR ACADEMY & CLUBS
    // =========================================================

    match /junior_abc_words/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /junior_phonics_sounds/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /junior_phonics_rhymes/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /junior_stories/{storyId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if request.auth.uid == resource.data.createdBy || isTeacher() || isAdmin();
    }

    match /junior_science/{factId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if request.auth.uid == resource.data.createdBy || isTeacher() || isAdmin();
    }

    match /junior_phonics/{wordId} {
      allow read, list: if isSignedIn();
      allow create: if isTeacher() || isAdmin();
      allow delete: if isTeacher() || isAdmin();
    }

    match /junior_puzzles/{puzzleId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /junior_stickers/{stickerId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /junior_sorter_items/{itemId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /junior_science_materials/{materialId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /junior_art_quests/{questId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /senior_stories/{id} {
      allow read, list: if true;
      allow write: if isTeacher() || isAdmin();
    }

    match /senior_math/{id} {
      allow read, list: if true;
      allow write: if isTeacher() || isAdmin();
    }

    match /senior_labs/{id} {
      allow read, list: if true;
      allow write: if isTeacher() || isAdmin();
    }

    match /curriculum/{gradeId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
      match /units/{unitId} {
        allow read, list: if isSignedIn();
        allow write: if isTeacher() || isAdmin();
        match /lessons/{lessonId} {
          allow read, list: if isSignedIn();
          allow write: if isTeacher() || isAdmin();
        }
      }
    }

    match /logic_lab_missions/{missionId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /logic_lab_curriculum/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /student_progress/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /math_problems/{problemId} {
      allow read, list: if isSignedIn();
      allow write: if isStaff() || isAdmin();
    }

    match /user_results/{resultId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if isOwner(resource.data.userId) || isStaff();
      allow update, delete: if false;
    }

    match /global_leaderboard/{userId} {
      allow read, list: if isSignedIn();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    match /math_learning_history/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if request.auth.uid == resource.data.userId || isTeacher() || isAdmin();
      allow delete: if request.auth.uid == resource.data.userId || isAdmin();
    }

    match /science_problems/{problemId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    match /daily_facts/{factId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    match /science_leaderboard/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == userId;
    }

    match /science_results/{resultId} {
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) || isStaff();
      allow read, list: if isOwner(resource.data.userId) || isStaff();
      allow update, delete: if false;
    }

    match /science_lab_questions/{id} {
      allow read, write: if isSignedIn();
    }

    match /science_lab_results/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /science_learning_history/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if request.auth.uid == resource.data.userId || isTeacher() || isAdmin();
      allow delete: if request.auth.uid == resource.data.userId || isAdmin();
    }

    // ELA Rules
    match /ela_grammar_drills/{drillId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /ela_reading_passages/{passageId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /ela_writing_challenges/{challengeId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /ela_user_submissions/{submissionId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isTeacher() || isStaff() || isAdmin() || isDirector()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isTeacher() || isStaff() || isAdmin() || isDirector();
    }

    match /ela_learning_history/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if isSignedIn();
      allow delete: if request.auth.uid == resource.data.userId || isAdmin();
    }

    match /ela_leaderboard/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Logic/Think Tank
    match /think_tank_paradoxes/{paradoxId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /think_tank_detective_cases/{caseId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /think_tank_debates/{debateId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /think_tank_crosswords/{puzzleId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /think_tank_submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isTeacher() || isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isTeacher() || isAdmin();
    }

    match /think_tank_responses/{responseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /scratch_assets/{assetId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /coding_curriculum/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /student_coding_progress/{progressId} {
      allow read, write: if isSignedIn() && (
        progressId.matches('^' + request.auth.uid) ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow read: if isTeacher() || isAdmin();
    }

    match /coding-club-projects/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /forumThreads/{threadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || request.auth.uid == resource.data.createdBy.uid;
      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin() || request.auth.uid == resource.data.author.uid;
      }
    }

    match /direct_messages/{chatId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /lectures/{lectureId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
      match /messages/{messageId} {
        allow read, create: if isSignedIn();
      }
    }

    match /active_classes/{classId} {
      allow read, write: if isSignedIn();
      match /{document=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /library/{itemId} {
      allow read: if isSignedIn();
      allow create: if isLibrarian() || isAdmin() || isTeacher();
      allow update: if isLibrarian() || isAdmin() || isTeacher() ||
                    (isStudent() && request.resource.data.status == 'Requested' && request.resource.data.currentHolderId == request.auth.uid) ||
                    (isStudent() && resource.data.currentHolderId == request.auth.uid && request.resource.data.status == 'Pending Return');
    }

    // =========================================================
    // 8.2 BOARDING MODULE SUBMODULES
    // =========================================================

    match /hostel_blocks/{blockId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /hostel_rooms/{roomId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /hostel_beds/{bedId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /hostel_allocations/{allocationId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /boarding_applications/{applicationId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /student_leaves/{leaveId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /boarding_visitors/{visitorId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /roll_calls/{rollCallId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /mess_weekly_menus/{menuId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /mess_attendance/{attendanceId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /infirmary_logs/{logId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================================================
    // 8.5 DIGITAL POCKET MONEY WALLET
    // =========================================================

    match /student_wallets/{studentId} {
      allow get: if isSignedIn() && (
        isOwner(studentId) ||
        parentOwnsStudent(studentId) ||
        isStaff() ||
        isAdmin()
      );
      allow list: if isSignedIn() && (isStaff() || isAdmin());
      allow write: if isAdmin();
    }

    match /wallet_transactions/{transactionId} {
      allow get: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        parentOwnsStudent(resource.data.studentId) ||
        isStaff() ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================================================
    // 8.9. GALLERY SECURITY
    // =========================================================
    match /gallery/{postId} {
      allow read, list: if isSignedIn();
      allow create, delete: if isAdmin() || isTeacher();
      allow update: if isSignedIn();
    }

    // =========================================================
    // 8.10. PARENT SATISFACTION SECURITY
    // =========================================================
    match /parent_satisfaction/{id} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn() && (resource.data.parentId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // 9. CATCH-ALL (Admin only — keep at bottom)
    // =========================================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }

  }
}