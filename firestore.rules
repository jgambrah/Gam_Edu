
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      // Assumes a 'staff' collection where documents are keyed by user UID
      // and contain a 'role' field.
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      // Standard role-based check.
      return isSignedIn() && getUserRole() in ['Director', 'Administrator'];
    }

    function isTeacher() {
      return isSignedIn() && getUserRole() == 'Teacher';
    }
    
    function isStudent() {
      return exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }

    function isParent() {
      return exists(/databases/$(database)/documents/parents/$(request.auth.uid));
    }
    
    function isStaff() {
        return exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isLibrarianOrAdmin() {
      let userRole = getUserRole();
      return userRole in ['Librarian', 'Administrator', 'Director'];
    }

    function isFinanceStaff() {
        let userRole = getUserRole();
        return userRole in ['Accountant', 'Administrator', 'Director'];
    }

    // --- Collection Rules ---

    match /roles/{roleId} {
      allow read, write: if isAdmin();
    }

    match /staff/{staffId} {
        // This rule is critical. It allows any signed-in user to read any staff
        // profile. This is necessary for the `getUserRole()` helper function to work
        // correctly for all other security rules that depend on it.
        allow read: if isSignedIn();
        // Write permissions remain restricted to admins.
        allow create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow create, update, delete: if isAdmin();
      allow read: if isSignedIn();
    }
    
    match /parents/{parentId} {
      allow create, update, delete: if isAdmin();
      allow read: if isSignedIn();
    }

    match /classes/{classId} {
      allow create, update, delete: if isAdmin();
      allow read: if isSignedIn();
    }
    
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isTeacher();
      allow update, delete: if isTeacher() && get(/databases/$(database)/documents/assignments/$(assignmentId)).data.teacherId == request.auth.uid;
    }

    match /assignments/{assignmentId}/submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create: if isStudent();
      allow update: if isTeacher() || isOwner(request.resource.data.studentId);
    }
    
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create: if isTeacher();
      allow update, delete: if isTeacher() && get(/databases/$(database)/documents/quizzes/$(quizId)).data.teacherId == request.auth.uid;
    }
    
    match /quizzes/{quizId}/attempts/{attemptId} {
        allow read: if isTeacher() || isOwner(request.resource.data.studentId);
        allow create: if isStudent();
    }

    match /assessments/{assessmentId} {
      allow list, read: if isSignedIn();
      allow create, update: if isTeacher() || isAdmin();
      allow delete: if isAdmin();
    }

    match /behavioral_records/{recordId} {
      allow read, list, write: if request.auth != null;
    }

    match /report-cards/{reportCardId} {
        allow read: if isSignedIn();
        allow create, update: if isTeacher() || isAdmin();
    }

    match /report-cards/{reportCardId}/comments/{commentId} {
        allow read: if isSignedIn();
        allow create, update: if isTeacher() && get(/databases/$(database)/documents/report-cards/$(reportCardId)).data.status == 'Draft';
        allow delete: if isTeacher() && get(/databases/$(database)/documents/report-cards/$(reportCardId)).data.status == 'Draft';
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /timeSlots/{timeSlotId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /timetables/{timetableEntryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /lesson-plans/{lessonPlanId} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    match /library/{itemId} {
      allow read: if isSignedIn();
      allow create, delete: if isLibrarianOrAdmin();
      allow update: if isLibrarianOrAdmin();
    }
    
    match /admissionApplications/{applicationId} {
      allow read: if isAdmin();
      allow create: if isParent();
      allow update: if isAdmin();
    }
    
    match /leaveRequests/{requestId} {
      allow read: if isStaff() || isAdmin();
      allow create: if isStaff() && isOwner(request.resource.data.staffId);
      allow update: if isAdmin();
    }

    match /publicHolidays/{holidayId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /performanceReviews/{reviewId} {
        allow read, write: if isAdmin();
    }

    match /financialRecords/{recordId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff();
    }

    match /payrollSettings/{settingsId} {
      allow read, write, list: if isFinanceStaff() || isAdmin();
    }

    match /staff/{staffId}/payroll/{configId} {
      allow read, write: if isFinanceStaff() || isAdmin();
    }

    match /payrollRecords/{recordId} {
      allow read: if isFinanceStaff() || isOwner(resource.data.staffId);
    }

    match /vendors/{vendorId} {
      allow read, write, list: if isFinanceStaff() || isAdmin();
    }
    
    match /accountsPayable/{payableId} {
      allow read, write, list: if isFinanceStaff() || isAdmin();
    }

    match /inventory/{itemId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }
    
    match /inventory/{itemId}/transactions/{transactionId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
    }
    
    match /announcements/{announcementId} {
      allow create, update, delete: if isAdmin();
      allow read: if isSignedIn();
    }

    match /auditLogs/{logId} {
      allow read, list: if isAdmin();
      allow write: if false; 
    }

    match /coding-club-projects/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /math_problems/{problemId} {
        allow get, list: if isTeacher() || isAdmin();
        allow write: if isTeacher() || isAdmin();
    }

    match /user_results/{resultId} {
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow read: if isOwner(resource.data.userId);
        allow update, delete: if false;
    }

    match /global_leaderboard/{userId} {
        allow read: if isSignedIn();
        allow write: if false;
    }

    match /science_problems/{problemId} {
        allow read, write: if isTeacher() || isAdmin();
    }

    match /science_results/{resultId} {
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow read: if isOwner(resource.data.userId);
        allow update, delete: if false;
    }

    match /science_leaderboard/{userId} {
        allow read: if isSignedIn();
        allow write: if false;
    }

    match /daily_facts/{factId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /ela_grammar_drills/{drillId} {
        allow read: if isSignedIn();
        allow write: if isTeacher() || isAdmin();
    }

    match /ela_reading_passages/{passageId} {
        allow read: if isSignedIn();
        allow write: if isTeacher() || isAdmin();
    }

    match /ela_writing_challenges/{challengeId} {
        allow read: if isSignedIn();
        allow write: if isTeacher() || isAdmin();
    }
    
    match /ela_user_submissions/{submissionId} {
        allow create: if isOwner(request.resource.data.userId);
        allow read: if isOwner(request.resource.data.userId) || isTeacher() || isAdmin();
        allow update: if (isTeacher() || isAdmin()) && request.resource.data.keys().hasOnly(['teacher_score', 'teacher_feedback']);
        allow delete: if false;
    }

    // Default deny all access to other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
