rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // 0. GLOBAL ALERT SYSTEM (SPOT CHECKS) - HIGH PRIORITY
    // =========================================================
    
    match /spot_checks/{checkId} {
        allow read, list: if request.auth != null; 
        allow create: if request.auth != null && (
          exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['Director', 'Administrator', 'Admin']
        );
        allow update: if request.auth != null; 
        allow delete: if request.auth != null && (
          exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['Director', 'Administrator', 'Admin']
        );
    }

    // =========================================================
    // 1. HELPER FUNCTIONS
    // =========================================================

    // Audit logs for system actions
    match /auditLogs/{logId} {
      allow read, get, list: if isSignedIn();
      allow create: if isSignedIn();
      // The audit trail is permanent: no one in a school can edit or erase it (before, administrators could).
      allow update, delete: if isSuperAdmin();
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && request.auth.token.role == 'super_admin') ||
        request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2" ||
        request.auth.uid == "gZxe3nMbGcQhNgEzkwEZwDBnkFR2" ||
        (request.auth.token != null && request.auth.token.email in ["jamesgambrah@gmail.com", "atampokaadongo@gmail.com"]) ||
        request.auth.uid == "7GVi5qCxC4YDnjKkjVwSjAYtQz73"
      );
    }

    function getUserSchoolId() {
      return (request.auth.token != null && 'schoolId' in request.auth.token && request.auth.token.schoolId != null)
        ? request.auth.token.schoolId
        : (request.auth.uid == "7GVi5qCxC4YDnjKkjVwSjAYtQz73" || (request.auth.token != null && request.auth.token.email == "atampokaadongo@gmail.com")
           ? "oHr3BrGdK2eS5MQ5zmZU"
           : (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && ('schoolId' in get(/databases/$(database)/documents/staff/$(request.auth.uid)).data)
              ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.schoolId
              : (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && ('schoolId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId
                : (exists(/databases/$(database)/documents/students/$(request.auth.uid)) && ('schoolId' in get(/databases/$(database)/documents/students/$(request.auth.uid)).data)
                   ? get(/databases/$(database)/documents/students/$(request.auth.uid)).data.schoolId
                   : (exists(/databases/$(database)/documents/parents/$(request.auth.uid)) && ('schoolId' in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data)
                      ? get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.schoolId
                      : '')))));
    }

    function getUserRole() {
      return (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role != null)
        ? request.auth.token.role
        : (request.auth.uid == "7GVi5qCxC4YDnjKkjVwSjAYtQz73" || (request.auth.token != null && request.auth.token.email == "atampokaadongo@gmail.com")
           ? "Director"
           : (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && ('role' in get(/databases/$(database)/documents/staff/$(request.auth.uid)).data)
              ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role
              : (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
                : '')));
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        request.auth.uid == "7GVi5qCxC4YDnjKkjVwSjAYtQz73" ||
        (request.auth.token != null && request.auth.token.email == "atampokaadongo@gmail.com") ||
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
         ('role' in get(/databases/$(database)/documents/staff/$(request.auth.uid)).data) &&
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['Director', 'Administrator', 'Admin', 'administrator', 'director', 'admin', 'Principal', 'Headmaster', 'Headmistress', 'Head Teacher', 'Registrar', 'Admissions', 'Owner']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Director', 'Administrator', 'Admin', 'administrator', 'director', 'admin', 'Principal', 'Headmaster', 'Headmistress', 'Head Teacher', 'Registrar', 'Admissions', 'Owner']) ||
        getUserRole() in ['Director', 'Administrator', 'Admin', 'administrator', 'director', 'admin', 'Principal', 'Headmaster', 'Headmistress', 'Head Teacher', 'Registrar', 'Admissions', 'Owner']
      );
    }

    function isTeacher() { 
      return isSignedIn() && (
        getUserRole() in ['Teacher', 'teacher', 'Subject Teacher', 'Class Teacher', 'Instructor', 'Faculty', 'Head of Department', 'Tutor'] ||
        (request.auth.token != null && request.auth.token.role in ['Teacher', 'teacher', 'instructor']) ||
        isStaff()
      ); 
    }
    function isStudent() { return exists(/databases/$(database)/documents/students/$(request.auth.uid)); }
    function isStaff() {
      return exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ||
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
                'Teacher', 'teacher', 'Subject Teacher', 'Class Teacher', 'Instructor', 'Faculty',
                'Head of Department', 'Tutor', 'Administrator', 'Director', 'Admin', 'administrator',
                'director', 'admin', 'Accountant', 'accountant', 'Librarian', 'librarian',
                'Transport Staff', 'transport staff', 'Cook', 'cook', 'Cleaner', 'cleaner',
                'Security Officer', 'security officer', 'Secretary', 'secretary', 'Receptionist', 'receptionist',
                'Bursar', 'bursar', 'Cashier', 'cashier', 'Finance', 'finance', 'Accounts Officer', 'accounts officer'
              ]);
    }
    function isParent() { return exists(/databases/$(database)/documents/parents/$(request.auth.uid)); }

    // A record archived when its term was closed is read-only, except for administrators.
    function notArchivedOrAdmin() {
      return resource == null || resource.data.get('isArchived', false) != true || isAdmin();
    }
    // Academic marks: teachers / staff / admins only. Quiz marks are graded and written by the server.
    function canCreateAssessment() {
      return isTeacher() || isAdmin();
    }

    function isFinanceStaff() { 
      return isAdmin() || getUserRole() in [
        'Accountant', 'accountant', 'Finance', 'finance', 'Bursar', 'bursar',
        'Cashier', 'cashier', 'Accounts Officer', 'accounts officer', 'Finance Officer', 'finance officer'
      ] || isStaff(); 
    }
    function isDirector() { return isAdmin(); }
    // Administrators and finance roles only (isFinanceStaff() also lets every teacher/cook in, because
    // attendance billing runs in teachers' sessions — too wide for cash, payroll and settings).
    function isFinanceRole() {
      return isAdmin() || getUserRole() in [
        'Accountant', 'accountant', 'Finance', 'finance', 'Bursar', 'bursar',
        'Cashier', 'cashier', 'Accounts Officer', 'accounts officer', 'Finance Officer', 'finance officer'
      ];
    }
    // The document being written belongs to the user's own school (no writing into another school's books).
    // A document without schoolId is judged by the school it already had.
    function newDocInMySchool() {
      return isSuperAdmin() || request.resource.data.get('schoolId', getUserSchoolId()) == getUserSchoolId();
    }
    // For deletes (there is no new version of the document to look at).
    function existingDocInMySchool() {
      return isSuperAdmin() || resource.data.get('schoolId', getUserSchoolId()) == getUserSchoolId();
    }
    function docInMySchool() {
      return isSuperAdmin() || (resource.data.get('schoolId', getUserSchoolId()) == getUserSchoolId()
        && request.resource.data.get('schoolId', resource.data.get('schoolId', '')) == resource.data.get('schoolId', request.resource.data.get('schoolId', '')));
    }
    function isLibrarian() { return isAdmin() || getUserRole() == 'Librarian' || getUserRole() == 'librarian'; }
    function isTransportStaff() { return isAdmin() || getUserRole() == 'Transport Staff' || getUserRole() == 'transport staff'; }

    function parentOwnsStudent(studentId) {
      return isParent() && studentId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.studentIds;
    }

    // =========================================================
    // 1B. GLOBAL SHARED CURRICULUM REPOSITORY
    // =========================================================

    match /global_curriculum/{document=**} {
      // The shared question bank: readable by any signed-in user of any school (not by anonymous visitors).
      allow read, list: if isSignedIn();

      // Restrict all write, update, and delete access to platform super-admins only
      allow write, create, update, delete: if request.auth != null && (
        request.auth.token.role == 'super_admin' ||
        isSuperAdmin()
      );
    }

    // =========================================================
    // 1C. MULTI-TENANT STUDENT QUIZ ATTEMPTS & PROGRESS
    // =========================================================

    match /tenants/{tenantId}/students/{studentId}/quiz_attempts/{attemptId} {
      // Student can only read their own school tenant records
      allow read, list: if request.auth != null && (
        (request.auth.uid == studentId && (
          (request.auth.token != null && (request.auth.token.tenantId == tenantId || request.auth.token.schoolId == tenantId)) ||
          getUserSchoolId() == tenantId
        )) ||
        (request.auth.token != null && request.auth.token.role == 'super_admin') ||
        isSuperAdmin() ||
        ((isAdmin() || isTeacher()) && (
          (request.auth.token != null && (request.auth.token.tenantId == tenantId || request.auth.token.schoolId == tenantId)) ||
          getUserSchoolId() == tenantId
        ))
      );

      // Student can only write their own school tenant records
      allow create, update: if request.auth != null && (
        (request.auth.uid == studentId && (
          (request.auth.token != null && (request.auth.token.tenantId == tenantId || request.auth.token.schoolId == tenantId)) ||
          getUserSchoolId() == tenantId
        )) ||
        (request.auth.token != null && request.auth.token.role == 'super_admin') ||
        isSuperAdmin()
      );

      // Delete access restricted to school admin or platform super-admins
      allow delete: if request.auth != null && (
        (request.auth.token != null && request.auth.token.role == 'super_admin') ||
        isSuperAdmin() ||
        (isAdmin() && (
          (request.auth.token != null && (request.auth.token.tenantId == tenantId || request.auth.token.schoolId == tenantId)) ||
          getUserSchoolId() == tenantId
        ))
      );
    }

    // =========================================================
    // 2. SAAS CORE
    // =========================================================

    // Public website data lives in publicSites/{slug} and publicDomains/{domain} (server-kept, private fields
    // removed). They can be fetched by id only — nobody can list every school on the platform.
    match /publicSites/{slug} {
      allow get: if true;
      allow list, write: if false;
    }
    match /publicDomains/{domain} {
      allow get: if true;
      allow list, write: if false;
    }

    match /schools/{schoolId} {
      // Signed-in users read their school by id; only the platform owner can list all schools.
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
      // A school's own admins edit its profile and website, but never its subscription or AI credit balance
      // (credits are spent by server code, which these rules do not affect).
      allow update: if isSignedIn() && (isSuperAdmin() || (isDirector() && getUserSchoolId() == schoolId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'aiCredits', 'aiCreditBalance', 'plan', 'status', 'isActive', 'trialEndsAt',
          'subscription', 'subscriptionStatus', 'subscriptionPlan', 'planExpiresAt', 'billingStatus',
          'paidUntil', 'lastPaymentAmount', 'lastPaymentDate', 'paymentReference'])));

      match /assignments/{assignmentId} {
        allow read, get, list: if isSignedIn();
        allow write, create, update: if isSignedIn();
        allow delete: if isSignedIn() && (
          isSuperAdmin() ||
          isAdmin() ||
          isDirector() ||
          isTeacher() ||
          resource.data.assignedByUid == request.auth.uid
        );

        match /submissions/{submissionId} {
          allow read, get, list: if isSignedIn();
          allow write, create, update, delete: if isSignedIn();
        }
      }

      match /question_sets/{setId} {
        allow read, get, list: if isSignedIn();
        allow write, create, update, delete: if isSignedIn() && (isSuperAdmin() || isAdmin() || isTeacher());
      }

      match /students/{studentId} {
        allow read, get, list: if isSignedIn();
        allow write, create, update: if isSignedIn();
      }

      match /classes/{classId} {
        allow read, get, list: if true;
        allow write: if isSignedIn() && (isSuperAdmin() || isAdmin() || isTeacher());
      }

      match /campus_tours/{tourId} {
        allow read, write: if true;
      }

      match /liveSessions/{sessionId} {
        allow read, list: if isSignedIn();
        allow write, create, update, delete: if isSignedIn();
      }

      match /analytics/{docId} {
        allow read: if isSignedIn() && (
          isSuperAdmin() ||
          ((isAdmin() || isFinanceStaff() || getUserRole() in ['Director', 'Administrator', 'Accountant', 'accountant']) && getUserSchoolId() == schoolId)
        );
        allow write: if false; // Cloud Functions only
      }
    }

    // ─── DASHBOARD SUMMARY (aggregation cache) ────────────────────────────────
    // Read: All signed-in staff, admins, and users
    // Write: Cloud Functions only (no client write access — prevents tampering).
    match /dashboard_summaries/{schoolId} {
      allow read, get, list: if isSignedIn();
      allow write: if false; // Server-side only via Cloud Functions
    }

    // Per-student balances for Student Billing (one document per school, written only by Cloud Functions).
    // Readable by that school's administrators and finance staff.
    match /studentRoster/{schoolId} {
      allow get: if isSuperAdmin() || (
        (isAdmin() || getUserRole() in ['Accountant', 'accountant', 'Finance', 'finance', 'Bursar', 'bursar',
          'Cashier', 'cashier', 'Accounts Officer', 'accounts officer', 'Finance Officer', 'finance officer'])
        && getUserSchoolId() == schoolId
      );
      allow list: if false;
      allow write: if false;
    }

    // Who has been billed school fees per term (server-kept; read by the "Students Not Billed" alert).
    match /termBilling/{schoolId} {
      allow get: if isSuperAdmin() || (
        (isAdmin() || getUserRole() in ['Accountant', 'accountant', 'Finance', 'finance', 'Bursar', 'bursar',
          'Cashier', 'cashier', 'Accounts Officer', 'accounts officer', 'Finance Officer', 'finance officer'])
        && getUserSchoolId() == schoolId
      );
      allow list: if false;
      allow write: if false;
    }

    match /studentBalances/{schoolId} {
      allow get: if isSuperAdmin() || (
        (isAdmin() || getUserRole() in ['Accountant', 'accountant', 'Finance', 'finance', 'Bursar', 'bursar',
          'Cashier', 'cashier', 'Accounts Officer', 'accounts officer', 'Finance Officer', 'finance officer'])
        && getUserSchoolId() == schoolId
      );
      allow list: if false;
      allow write: if false;
    }


    // Payment / messaging credentials and rollover run records: server (admin SDK) only.
    // No browser — not even an administrator — can read or write these.
    match /schoolSecrets/{schoolId} {
      allow read, write: if false;
    }
    match /paystackEvents/{reference} {
      allow read, write: if false;
    }
    match /termRollovers/{runId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /schoolSettings/{docId} {
      allow read, get, list: if isSignedIn();
      // Administrators and finance staff of the school (canteen/transport rates, budget policy, term...) —
      // no longer every teacher or cook.
      allow write: if isSuperAdmin() || (isFinanceRole() && getUserSchoolId() == docId);

      match /{document=**} {
        allow read, get, list: if isSignedIn();
        allow write: if isSuperAdmin() || (isFinanceRole() && getUserSchoolId() == docId);
      }
    }

    match /leads/{leadId} {
      allow read, write: if isSuperAdmin();
    }

    match /tutorials/{tutorialId} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2";
    }

    // =========================================================
    // 3. CORE COLLECTIONS
    // =========================================================

     match /users/{userId} {
      allow read, get, list: if isSignedIn();
      // A user may update their own profile but NOT give themselves a role or a school (before, any pupil or
      // parent could set role "Director" here and become an administrator of any school). A role/school
      // change by the user is accepted only when it matches their staff record (set by an administrator).
      // Administrators can manage users of their own school only.
      allow create, update: if isSignedIn() && (
        isSuperAdmin() ||
        (isAdmin() && (resource == null || resource.data.get('schoolId', '') in ['', getUserSchoolId()]))
          && request.resource.data.get('schoolId', getUserSchoolId()) == getUserSchoolId() ||
        (request.auth.uid == userId && selfUserAccessUnchanged(userId))
      );
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.get('schoolId', '') == getUserSchoolId());
    }

    function selfUserAccessUnchanged(userId) {
      return (resource != null
              && request.resource.data.get('role', '') == resource.data.get('role', '')
              && request.resource.data.get('schoolId', '') == resource.data.get('schoolId', ''))
        || (resource == null && request.resource.data.get('role', '') == '' && request.resource.data.get('schoolId', '') == '')
        || (exists(/databases/$(database)/documents/staff/$(userId))
            && get(/databases/$(database)/documents/staff/$(userId)).data.get('role', '') == request.resource.data.get('role', '')
            && get(/databases/$(database)/documents/staff/$(userId)).data.get('schoolId', '') == request.resource.data.get('schoolId', ''));
    }

    match /staff/{staffId} {
      allow get, list: if isSignedIn();
      // Staff may edit their own profile, but not their role, school or pay/status fields (before, any staff
      // member could change their own role to "Director").
      allow create, update: if isSuperAdmin() || (isAdmin() && (getUserSchoolId() == request.resource.data.schoolId || !('schoolId' in request.resource.data))) ||
        (isOwner(staffId) && resource != null && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['role', 'schoolId', 'isActive', 'permissions', 'salary', 'baseSalary', 'employmentStatus', 'isSuperAdmin', 'roles']));
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.get('schoolId', '') == getUserSchoolId());
      // Salary set-up: finance/admin of the SAME school only, and never one's own salary (except the Director).
      match /payroll/{configId} {
        allow read: if isSuperAdmin() || request.auth.uid == staffId
          || (isFinanceRole() && get(/databases/$(database)/documents/staff/$(staffId)).data.get('schoolId', '') == getUserSchoolId());
        allow write: if isSuperAdmin() || (isFinanceRole()
          && get(/databases/$(database)/documents/staff/$(staffId)).data.get('schoolId', '') == getUserSchoolId()
          && (request.auth.uid != staffId || isReviewDirector()));
      }
    }

    // Fields only school staff (or the server) may change on a student record. XP and badges are awarded
    // by the server (src/app/actions/gamification.ts); identity, class, school and billing fields by staff.
    function studentProtectedFields() {
      return ['totalPoints', 'earnedBadges', 'attendanceStreak', 'quizStreak90', 'booksReadCount', 'stemCount',
              'xpEarnedToday', 'xpEarnedDay', 'lastGamificationUpdate',
              'schoolId', 'classId', 'uid', 'studentId', 'enrollmentStatus', 'status', 'parentId', 'parentIds',
              'isSponsored', 'sponsorId', 'sponsorName', 'biometricId', 'usesBusService', 'usesCanteen',
              'transportBillingModel', 'canteenBillingMode', 'isArchived'];
    }
    function isStaffOfStudentSchool() {
      return (isAdmin() || isTeacher())
        && (resource.data.get('schoolId', '') == '' || resource.data.get('schoolId', '') == getUserSchoolId());
    }

    match /students/{studentId} {
      allow read, get, list: if true; // Public verified portfolio view & all users
      allow create: if isSignedIn();
      // Staff of the student's school can edit everything; anyone else signed in (the student, a parent,
      // older screens) can still save other fields but cannot touch XP/badges or identity/billing fields.
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isStaffOfStudentSchool() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(studentProtectedFields())
      );
      allow delete: if isSuperAdmin() || isAdmin();

      match /timeline/{eventId} {
        allow read, get, list: if true;
        allow write, create, update: if isSignedIn();
        allow delete: if isSuperAdmin() || isAdmin();
      }
    }

    match /parents/{parentId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSuperAdmin() || (isAdmin() && (getUserSchoolId() == request.resource.data.schoolId || !('schoolId' in request.resource.data))) || isOwner(parentId);
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // =========================================================
    // 4B. 1-READ OPTIMIZATION DIRECTORY & REPORT SNAPSHOTS
    // =========================================================
    // Consolidated snapshot documents hold a whole school's pupils, parents (phones, health notes) or marks.
    // Only that school's staff may open or rebuild them; their id is the school id, or starts with it + '_'.
    // (Before, ANY signed-in user — any pupil or parent of any school — could read, list and overwrite them.)
    function ownSchoolSnapshot(snapshotId) {
      return isSuperAdmin() || (isStaff() && (snapshotId == getUserSchoolId() || snapshotId.matches('^' + getUserSchoolId() + '_.*')));
    }

    match /student_directory_snapshots/{snapshotId} {
      allow get: if ownSchoolSnapshot(snapshotId);
      allow list: if false;
      allow create, update: if ownSchoolSnapshot(snapshotId);
      allow delete: if isAdmin() && ownSchoolSnapshot(snapshotId);
    }

    match /parent_directory_snapshots/{snapshotId} {
      allow get: if ownSchoolSnapshot(snapshotId);
      allow list: if false;
      allow create, update: if ownSchoolSnapshot(snapshotId);
      allow delete: if isAdmin() && ownSchoolSnapshot(snapshotId);
    }

    match /academic_report_snapshots/{snapshotId} {
      allow get: if ownSchoolSnapshot(snapshotId);
      allow list: if false;
      allow create, update: if ownSchoolSnapshot(snapshotId);
      allow delete: if isAdmin() && ownSchoolSnapshot(snapshotId);
    }

    match /attendance_report_snapshots/{snapshotId} {
      allow get: if ownSchoolSnapshot(snapshotId);
      allow list: if false;
      allow create, update: if ownSchoolSnapshot(snapshotId);
      allow delete: if isAdmin() && ownSchoolSnapshot(snapshotId);
    }

    match /learning_analytics_snapshots/{snapshotId} {
      allow get: if ownSchoolSnapshot(snapshotId);
      allow list: if false;
      allow create, update: if ownSchoolSnapshot(snapshotId);
      allow delete: if isAdmin() && ownSchoolSnapshot(snapshotId);
    }

    match /assessment_records_snapshots/{snapshotId} {
      allow get: if ownSchoolSnapshot(snapshotId);
      allow list: if false;
      allow create, update: if ownSchoolSnapshot(snapshotId);
      allow delete: if isAdmin() && ownSchoolSnapshot(snapshotId);
    }

    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read, update, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Receipt / student numbers only ever go up (winding a counter back would re-issue old receipt numbers).
      allow update: if isSignedIn() && request.resource.data.get('currentId', 0) > resource.data.get('currentId', 0);
      allow delete: if isSuperAdmin();
    }

    match /announcements_v2/{announcementId} {
      allow read, list: if isSignedIn() || 'Everybody' in resource.data.audience;
      allow write: if isAdmin();
    }

    // =========================================================
    // 5. HR & STAFF
    // =========================================================

    match /leaveRequests/{requestId} {
      allow read, write, list: if isSuperAdmin() || isAdmin();
      allow list: if isStaff();
      allow read: if isSignedIn() && (resource.data.staffId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if isSignedIn();
    }

    match /performanceReviews/{reviewId} {
      allow read, list: if isAdmin() || (isSignedIn() && resource.data.staffId == request.auth.uid);
      allow write: if isAdmin();
    }

    // =========================================================
    // 6. ACADEMICS
    // =========================================================

     match /classes/{classId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSuperAdmin() || ((isAdmin() || isTeacher()) && getUserSchoolId() == request.resource.data.schoolId);
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /subjects/{subjectId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSuperAdmin() || (isAdmin() && getUserSchoolId() == request.resource.data.schoolId);
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /subjects/{subjectId}/assessments/{assessmentId} {
        allow read, list: if isSignedIn();
        allow create, update: if isSuperAdmin() || ((isAdmin() || isTeacher()) && getUserSchoolId() == request.resource.data.schoolId);
        allow delete: if isSuperAdmin() || isAdmin() || isTeacher();
    }

    match /assessments/{assessmentId} {
        allow read, get, list: if isSignedIn();
        allow create: if canCreateAssessment();
        allow update: if (isAdmin() || (isTeacher() && (resource.data.get('schoolId', '') == '' || resource.data.get('schoolId', '') == getUserSchoolId()))) && notArchivedOrAdmin();
        allow delete: if (isSuperAdmin() || isAdmin() || (isTeacher() && (resource.data.get('schoolId', '') == '' || resource.data.get('schoolId', '') == getUserSchoolId()))) && notArchivedOrAdmin();
    }

    match /{path=**}/assessments/{assessmentId} {
        allow read, get, list: if isSignedIn();
        allow create: if canCreateAssessment();
        allow update: if (isAdmin() || (isTeacher() && (resource.data.get('schoolId', '') == '' || resource.data.get('schoolId', '') == getUserSchoolId()))) && notArchivedOrAdmin();
        allow delete: if (isSuperAdmin() || isAdmin() || (isTeacher() && (resource.data.get('schoolId', '') == '' || resource.data.get('schoolId', '') == getUserSchoolId()))) && notArchivedOrAdmin();
    }

    match /{path=**}/liveSessions/{sessionId} {
        allow read, list: if isSignedIn();
        allow write, create, update, delete: if isSignedIn();
    }

    match /timetables/{timetableId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSuperAdmin() || (isAdmin() && getUserSchoolId() == request.resource.data.schoolId);
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /rooms/{roomId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSuperAdmin() || (isAdmin() && getUserSchoolId() == request.resource.data.schoolId);
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /timeSlots/{timeSlotId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSuperAdmin() || ((isAdmin() || isTeacher()) && getUserSchoolId() == request.resource.data.schoolId);
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /school_calendar/{eventId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSuperAdmin() || (isAdmin() && getUserSchoolId() == request.resource.data.schoolId);
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read, get, list: if isSignedIn();
      // Marked by teachers / staff (biometric scans are written by the server). Parents and students cannot
      // write attendance, and days in a closed term are read-only except for administrators.
      allow create: if isTeacher() || isStaff() || isAdmin();
      allow update: if (isTeacher() || isStaff() || isAdmin()) && notArchivedOrAdmin();
      allow delete: if (isTeacher() || isStaff() || isAdmin()) && notArchivedOrAdmin();

      match /{document=**} {
        allow read, get, list: if isSignedIn();
        allow write: if isTeacher() || isStaff() || isAdmin();
      }
    }

    match /canteen_headcounts/{headcountId} {
      allow read, get, list: if isSignedIn();
      allow write, create, update: if isSignedIn();
      allow delete: if isSuperAdmin() || isAdmin();

      match /{document=**} {
        allow read, get, list: if isSignedIn();
        allow write, create, update: if isSignedIn();
        allow delete: if isSuperAdmin() || isAdmin();
      }
    }

    match /notification_queue/{queueId} {
      allow read, get, list: if isSignedIn();
      allow write, create, update: if isSignedIn();
      allow delete: if isSuperAdmin() || isAdmin();

      match /{document=**} {
        allow read, get, list: if isSignedIn();
        allow write, create, update: if isSignedIn();
        allow delete: if isSuperAdmin() || isAdmin();
      }
    }

    match /staff_attendance/{attendanceId} {
      allow read, get, list, write, create, update: if isSignedIn();
      allow delete: if isSuperAdmin() || isAdmin();

      match /{document=**} {
        allow read, get, list, write, create, update: if isSignedIn();
        allow delete: if isSuperAdmin() || isAdmin();
      }
    }

     match /report-cards/{reportId} {
      allow get: if isSignedIn() && (isSuperAdmin() || (getUserSchoolId() == resource.data.schoolId && (
        isTeacher() || isStaff() || isAdmin() || isDirector() ||
        resource.data.studentId == request.auth.uid ||
        parentOwnsStudent(resource.data.studentId)
      )));
      allow list: if isSignedIn();
      allow create: if isSuperAdmin() || ((isTeacher() || isStaff() || isAdmin()) && getUserSchoolId() == request.resource.data.schoolId);
      allow update: if isSuperAdmin() || ((isTeacher() || isStaff() || isAdmin()) && getUserSchoolId() == request.resource.data.schoolId && notArchivedOrAdmin());
      allow delete: if (isSuperAdmin() || isAdmin()) && notArchivedOrAdmin();
    }

    match /report_card_remarks/{id} {
      allow read, list: if isSignedIn();
      allow create, update: if isSuperAdmin() || ((isTeacher() || isAdmin()) && getUserSchoolId() == request.resource.data.schoolId);
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read, get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        isAdmin() ||
        resource.data.teacherId == request.auth.uid
      );

      match /submissions/{submissionId} {
        allow read, get, list: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isSuperAdmin() || isAdmin();
      }
    }

    match /submissions/{submissionId} {
      allow read, get, list: if isSignedIn();
      // A pupil submits their own work (staff may submit for them).
      allow create: if isSignedIn() && (request.resource.data.get('studentId', '') == request.auth.uid || isTeacher() || isAdmin());
      // Only staff grade. A pupil may replace their own UNGRADED submission but can never set a grade,
      // feedback or "Graded" status (before, any signed-in user could edit any submission, grade included).
      allow update: if isSignedIn() && ((
          resource.data.get('studentId', '') == request.auth.uid &&
          resource.data.get('status', '') != 'Graded' &&
          request.resource.data.get('studentId', '') == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['grade', 'teacherFeedback', 'gradedAt', 'assignmentId', 'schoolId']) &&
          request.resource.data.get('status', '') in ['Submitted', 'Late']
        ) || isTeacher() || isAdmin());
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // Answer keys (moved out of quizzes by the quizAnswerVault function): teachers/admins of the school only.
    match /quizKeys/{quizId} {
      allow read: if isSuperAdmin() || ((isTeacher() || isAdmin()) && resource.data.get('schoolId', '') == getUserSchoolId());
      allow write: if false;
    }

    match /quizzes/{quizId} {
      allow read, get, list: if isSignedIn();
      // Only teachers/admins create or edit quizzes (students could previously rewrite the questions/answers).
      allow create, update: if isSuperAdmin() || isTeacher() || isAdmin();
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        isAdmin() ||
        resource.data.teacherId == request.auth.uid
      );
      match /attempts/{attemptId} {
        allow read, get, list: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isSuperAdmin() || isAdmin();
      }
    }

    match /quizAttempts/{attemptId} {
      allow read, get, list: if isSignedIn();
      // Students' attempts are graded and saved by the server (submitQuizAttemptAction).
      allow create, update: if isTeacher() || isAdmin();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /assessments/{assessmentId} {
      allow read, get, list: if isSignedIn();
      allow create: if canCreateAssessment();
      allow update: if (isAdmin() || (isTeacher() && (resource.data.get('schoolId', '') == '' || resource.data.get('schoolId', '') == getUserSchoolId()))) && notArchivedOrAdmin();
      allow delete: if (isSuperAdmin() || isAdmin() || (isTeacher() && (resource.data.get('schoolId', '') == '' || resource.data.get('schoolId', '') == getUserSchoolId()))) && notArchivedOrAdmin();
    }

    match /lesson-plans/{planId} {
      allow read, list: if isSignedIn();
      allow create: if isSuperAdmin() || (((isStaff() && request.resource.data.teacherId == request.auth.uid) || isAdmin()) && getUserSchoolId() == request.resource.data.schoolId);
      allow update, delete: if isSuperAdmin() || (getUserSchoolId() == resource.data.schoolId && (isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid)));
    }

    match /learning_materials/{materialId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSuperAdmin() || ((isTeacher() || isAdmin()) && getUserSchoolId() == request.resource.data.schoolId);
      allow delete: if isSuperAdmin() || isAdmin() || isTeacher();
    }

    match /behavioral_records/{recordId} {
      allow read, list: if isSignedIn();
      allow create: if isSuperAdmin() || ((isTeacher() || isStaff() || isAdmin()) && getUserSchoolId() == request.resource.data.schoolId);
      allow update: if isSuperAdmin() || ((isTeacher() || isStaff() || isAdmin()) && getUserSchoolId() == request.resource.data.schoolId && notArchivedOrAdmin());
      allow delete: if isSuperAdmin() || (isAdmin() && getUserSchoolId() == resource.data.schoolId && notArchivedOrAdmin());
    }

    // =========================================================
    // 7. FINANCE
    // =========================================================

    // ── CASH TILLS ──────────────────────────────────────────────────────────────
    // Staff of the school open tills and record cash. Only the Director closes (approves) a till or approves
    // a manual adjustment. Adjustments start "Pending Adjustment"; a till entry's amount can never be edited.
    function tillApprovalUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['directorApproval', 'dateClosed'])
        && (request.resource.data.get('status', '') != 'Closed' || resource.data.get('status', '') == 'Closed');
    }
    match /tills/{tillId} {
      allow read, get, list: if isSignedIn();
      allow create: if isFinanceStaff() && newDocInMySchool()
        && request.resource.data.get('status', 'Open') == 'Open'
        && request.resource.data.get('directorApproval', {}).get('directorId', null) == null;
      allow update: if isFinanceStaff() && docInMySchool()
        && (tillApprovalUntouched() || isReviewDirector() || isSuperAdmin());
      allow delete: if isSuperAdmin();

      match /transactions/{transactionId} {
        allow read, get, list: if isSignedIn();
        allow create: if isFinanceStaff() && newDocInMySchool()
          && (request.resource.data.get('type', '') != 'Adjustment' || request.resource.data.get('status', '') == 'Pending Adjustment');
        allow update: if (isReviewDirector() || isSuperAdmin()) && docInMySchool()
          && request.resource.data.get('amount', 0) == resource.data.get('amount', 0);
        allow delete: if isSuperAdmin();
      }

      match /{document=**} {
        allow read, get, list: if isSignedIn();
        allow write: if isSuperAdmin();
      }
    }

    match /bank_transactions/{transactionId} {
      allow read, get, list: if isSignedIn();
      allow create: if isFinanceRole() && newDocInMySchool();
      allow update: if isFinanceRole() && docInMySchool();
      allow delete: if isSuperAdmin() || (isAdmin() && existingDocInMySchool());
    }

    // ── FINANCIAL RECORDS (bills) ──────────────────────────────────────────────
    // Read: any signed-in user (parents/students view their own bills in the portal).
    // Write: school staff only (teachers included — attendance-linked billing runs in their session).
    // Archived records (closed terms) are read-only except for administrators, and are never deletable.
    // Server code (Admin SDK: biometric billing, payment webhooks, Cloud Functions) bypasses these rules.
    function isUnpaidDailyBill(data) {
      return data.type in ['Canteen Fee (Daily)', 'Transport Fee (Daily)']
        && (data.get('amountPaid', 0) == 0)
        && (data.get('waiverAmount', 0) == 0)
        && data.get('isArchived', false) != true;
    }

    // Waivers are a write-off: only administrators/directors may change waiverAmount. Two automatic
    // exceptions used by attendance billing: voiding an absent day's bill (billed and waiver set to 0) and
    // restoring it (waiver set back to the saved originalWaiverAmount).
    function waiverChangeAllowed() {
      return request.resource.data.get('waiverAmount', 0) == resource.data.get('waiverAmount', 0)
        || (request.resource.data.get('billedAmount', 0) == 0 && request.resource.data.get('waiverAmount', 0) == 0)
        || request.resource.data.get('waiverAmount', 0) == resource.data.get('originalWaiverAmount', -1)
        || isSuperAdmin() || isReviewDirector(); // waivers: the Director only (not Administrators)
    }

    // ── "Amount paid" can only change together with a recorded payment ───────────────────────────────
    // A bill's amountPaid may change ONLY in the same save as one of:
    //  • a NEW payment record under the bill (named in lastPaymentId) for exactly the amount added;
    //  • a NEW reversal record (isReversal) when the amount goes down;
    //  • a credit move: an entry appended to creditAllocations, with the source bill's amountPaid going
    //    down by the same amount in the same save (target), or the matching "toOthers" entry (source).
    // So nobody — even someone using the database directly — can mark a bill paid without a payment record.
    // (Server code — online payments, nightly jobs — is not affected by these rules.)
    function paidBefore() { return resource.data.get('amountPaid', 0); }
    function paidAfter() { return request.resource.data.get('amountPaid', 0); }
    function payDocPath(recordId, payId) { return /databases/$(database)/documents/financialRecords/$(recordId)/payments/$(payId); }
    // The payment record named in lastPaymentId must be written in this same save: its paidAt is the
    // server time of this very request, so an old receipt cannot be "re-used" to add money twice.
    // (One document check per bill — a save may only make a limited number of such checks.)
    function newPaymentDoc(recordId) {
      return getAfter(payDocPath(recordId, request.resource.data.lastPaymentId)).data;
    }
    function namesNewPayment(recordId) {
      return request.resource.data.get('lastPaymentId', '') is string
        && request.resource.data.get('lastPaymentId', '') != ''
        && request.resource.data.get('lastPaymentId', '') != resource.data.get('lastPaymentId', '')
        && newPaymentDoc(recordId).get('paidAt', null) == request.time;
    }
    function paymentAddsExactly(recordId) {
      return namesNewPayment(recordId)
        && math.abs(newPaymentDoc(recordId).get('amount', 0) - (paidAfter() - paidBefore())) < 0.011;
    }
    function reversalRecorded(recordId) {
      return namesNewPayment(recordId)
        && newPaymentDoc(recordId).get('isReversal', false) == true;
    }
    function allocationAppended() {
      return request.resource.data.get('creditAllocations', []).size() == resource.data.get('creditAllocations', []).size() + 1;
    }
    function lastAllocation() {
      return request.resource.data.creditAllocations[request.resource.data.creditAllocations.size() - 1];
    }
    function creditMovedIn() {
      return allocationAppended()
        && lastAllocation().get('fromRecordId', '') != ''
        && math.abs(lastAllocation().get('amount', 0) - (paidAfter() - paidBefore())) < 0.011
        && getAfter(/databases/$(database)/documents/financialRecords/$(lastAllocation().fromRecordId)).data.get('amountPaid', 0)
             <= get(/databases/$(database)/documents/financialRecords/$(lastAllocation().fromRecordId)).data.get('amountPaid', 0) - (paidAfter() - paidBefore()) + 0.011;
    }
    function creditMovedOut() {
      return allocationAppended()
        && math.abs(lastAllocation().get('toOthers', 0) - (paidBefore() - paidAfter())) < 0.011;
    }
    function amountPaidChangeAllowed(recordId) {
      return paidAfter() == paidBefore()
        || isSuperAdmin()
        || (paidAfter() > paidBefore() && (paymentAddsExactly(recordId) || creditMovedIn()))
        || (paidAfter() < paidBefore() && (reversalRecorded(recordId) || creditMovedOut()));
    }

    function receiptAmountKept() {
      return request.resource.data.get('amount', 0) == resource.data.get('amount', 0)
        // credit move: part of the receipt is split out to another bill, recorded in allocatedOut
        || (request.resource.data.get('allocatedOut', 0) > resource.data.get('allocatedOut', 0)
            && math.abs((resource.data.get('amount', 0) - request.resource.data.get('amount', 0))
                        - (request.resource.data.get('allocatedOut', 0) - resource.data.get('allocatedOut', 0))) < 0.011)
        // the receiving side of a credit move (allocation receipt topped up)
        || (resource.data.get('isAllocation', false) == true && request.resource.data.get('amount', 0) > resource.data.get('amount', 0));
    }
    function reversalHasRecord(recordId, paymentId) {
      return request.resource.data.get('status', '') != 'Reversed'
        || resource.data.get('status', '') == 'Reversed'
        || existsAfter(/databases/$(database)/documents/financialRecords/$(recordId)/payments/$(paymentId + '-REV'));
    }

    match /financialRecords/{recordId} {
      allow read, list: if isSignedIn();
      // A new bill starts with nothing paid and nothing waived: money paid arrives only through a receipt,
      // and a waiver only through the Director (otherwise a "pre-paid" bill could create fake credit).
      allow create: if isFinanceStaff() && newDocInMySchool()
        && ((request.resource.data.get('amountPaid', 0) == 0 && request.resource.data.get('waiverAmount', 0) == 0)
            || isSuperAdmin() || isReviewDirector());
      allow update: if isFinanceStaff() && docInMySchool()
        && (resource.data.get('isArchived', false) != true || isAdmin())
        && waiverChangeAllowed()
        && amountPaidChangeAllowed(recordId);
      // Deleting a non-existent bill is a no-op (attendance corrections delete "just in case").
      // Staff may only remove an UNPAID daily canteen/transport bill (student re-marked absent).
      // Anything else requires an administrator, and archived records can never be deleted.
      allow delete: if isFinanceStaff() && (
        resource == null ||
        isUnpaidDailyBill(resource.data) ||
        (isAdmin() && resource.data.get('isArchived', false) != true)
      );

      match /payments/{paymentId} {
        allow read, list: if isSignedIn();
        allow create: if isFinanceStaff() && newDocInMySchool();
        // A receipt's amount cannot be edited afterwards (only split out by a recorded credit move), and a
        // receipt can only be marked "Reversed" together with its reversal record — so money taken can
        // never quietly disappear from the books.
        // Its date is fixed too: re-dating an old receipt must not let it be counted again as a new payment.
        allow update: if isFinanceStaff() && docInMySchool() && receiptAmountKept() && reversalHasRecord(recordId, paymentId)
          && request.resource.data.get('paidAt', null) == resource.data.get('paidAt', null);
        allow delete: if false; // receipts are permanent; use reversals instead
      }
    }

    // Collection Group rule for payments (dashboard live feed / sync)
    match /{path=**}/payments/{paymentId} {
      allow read, list: if isSignedIn();
      // Writes go through the bill's own rule above (this wider rule used to let them bypass its checks).
      allow create, update, delete: if false;
    }

    match /reversalLogs/{logId} {
      allow read, list, create: if isFinanceStaff() || isAdmin();
      allow update, delete: if false;
    }

    match /waiverRequests/{requestId} {
      allow read, get, list: if isSignedIn();
      allow create: if isFinanceRole() && newDocInMySchool() && request.resource.data.get('status', 'Pending') == 'Pending';
      allow update: if (isReviewDirector() || isSuperAdmin()) && docInMySchool(); // approve / reject: Director only
      allow delete: if isSuperAdmin();
    }

    match /waiver_requests/{requestId} {
      allow read, get, list: if isSignedIn();
      allow create: if isFinanceRole() && newDocInMySchool() && request.resource.data.get('status', 'Pending') == 'Pending';
      allow update: if (isReviewDirector() || isSuperAdmin()) && docInMySchool(); // approve / reject: Director only
      allow delete: if isSuperAdmin();
    }

    match /paymentVouchers/{voucherId} {
      allow read, get, list: if isSignedIn();
      allow create: if isFinanceRole() && newDocInMySchool();
      // An over-budget voucher waits for the Director; nobody else can release it.
      allow update: if isFinanceRole() && docInMySchool()
        && (resource.data.get('status', '') != 'Awaiting Override' || request.resource.data.get('status', '') == 'Awaiting Override'
            || isReviewDirector() || isSuperAdmin());
      allow delete: if isSuperAdmin() || (isReviewDirector() && existingDocInMySchool());
    }

    match /payment_vouchers/{voucherId} {
      allow read, get, list: if isSignedIn();
      allow create: if isFinanceRole() && newDocInMySchool();
      // An over-budget voucher waits for the Director; nobody else can release it.
      allow update: if isFinanceRole() && docInMySchool()
        && (resource.data.get('status', '') != 'Awaiting Override' || request.resource.data.get('status', '') == 'Awaiting Override'
            || isReviewDirector() || isSuperAdmin());
      allow delete: if isSuperAdmin() || (isReviewDirector() && existingDocInMySchool());
    }

    match /vendors/{vendorId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /sponsors/{sponsorId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /accountsPayable/{payableId} {
      allow read, get, list: if isSignedIn();
      allow write, create, update, delete: if isFinanceStaff() || isAdmin() || isSuperAdmin();
    }

    match /accountsReceivable/{receivableId} {
      allow read, get, list: if isSignedIn();
      allow write, create, update, delete: if isFinanceStaff() || isAdmin() || isSuperAdmin();
    }

    match /inventory/{itemId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin() || isDirector();
    }

    match /suppliers/{id} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /purchase_orders/{id} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /vendor_bills/{id} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /products/{productId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff();
    }

    match /categories/{categoryId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff();
    }

    match /pos_transactions/{transactionId} {
      allow read, create, list: if isSignedIn();
      allow update: if isFinanceStaff();
    }

    match /school_shop_items/{itemId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /school_shop_transactions/{transId} {
      allow read, write, list: if isFinanceStaff() || isAdmin();
    }

    match /school_academic_bundles/{bundleId} {
      allow read, list: if true;
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /school_shop_orders/{orderId} {
      allow read, list: if isSignedIn();
      // A parent places an order as UNPAID (pay at the store) or VERIFYING (Paystack); only the server
      // (after checking the payment with Paystack) or school staff can mark it PAID.
      allow create: if isSignedIn() && request.resource.data.get('parentId', '') == request.auth.uid
        && request.resource.data.get('paymentStatus', '') in ['UNPAID', 'VERIFYING'];
      allow update: if isFinanceStaff() && docInMySchool();
      allow delete: if isFinanceRole() && existingDocInMySchool();
    }

    match /accounts/{accountId} {
      allow read, get, list: if isSignedIn();
      allow write, create, update, delete: if isFinanceStaff() || isAdmin() || isSuperAdmin();
    }

    match /journal_entries/{entryId} {
      allow read, get, list: if isSignedIn();
      allow create: if (isFinanceRole() || isSuperAdmin()) && newDocInMySchool();
      allow update: if false;
      allow delete: if isSuperAdmin(); // correct with a reversing entry; posted entries are never erased
    }

    match /budgets/{budgetId} {
      allow read, get, list: if isSignedIn();
      allow create, update: if isSignedIn() && (isFinanceStaff() || isAdmin() || isSuperAdmin());
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /budget_items/{itemId} {
      allow read, get, list: if isSignedIn();
      allow create, update: if isSignedIn() && (isFinanceStaff() || isAdmin() || isSuperAdmin());
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /fixed_assets/{assetId} {
      allow read, get, list: if isSignedIn();
      allow write, create, update, delete: if isFinanceStaff() || isAdmin() || isSuperAdmin();
    }

    match /depreciation_logs/{logId} {
      allow read, get, list: if isSignedIn();
      allow write, create, update, delete: if isFinanceStaff() || isAdmin() || isSuperAdmin();
    }

    // One payroll settings document per school (id = schoolId); 'global' holds platform defaults.
    match /payrollSettings/{settingsId} {
      allow read, list: if isFinanceRole() || isSuperAdmin();
      allow write: if isSuperAdmin() || (isFinanceRole() && settingsId == getUserSchoolId());
    }

    match /payroll_settings/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /payroll_runs/{runId} {
      allow read, list: if isFinanceStaff() || isAdmin() || (isSignedIn() && request.auth.uid == resource.data.staffId);
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /payrollRecords/{recordId} {
      // Payslips: finance/admin, or the staff member's own (queries must filter by staffId).
      allow read: if isFinanceRole() || (isSignedIn() && resource.data.get('staffId', '') == request.auth.uid);
      allow create: if isFinanceRole() && newDocInMySchool();
      allow update: if isFinanceRole() && docInMySchool();
      allow delete: if isSuperAdmin();
    }

    match /staff_salary_details/{userId} {
      allow read, list: if isFinanceRole() || request.auth.uid == userId;
      allow write: if isSuperAdmin() || (isFinanceRole() && request.auth.uid != userId);
    }

    match /routes/{routeId} {
      allow read, list: if isSignedIn();
      allow write: if isSuperAdmin() || isAdmin() || isFinanceStaff() || isTransportStaff();
    }

    match /buses/{busId} {
      allow read, list: if isSignedIn();
      allow write: if isSuperAdmin() || isAdmin() || isFinanceStaff() || isTransportStaff();
    }

    // Support Staff Collections
    match /cafeteria_menus/{menuId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cook';
    }

    match /kitchen_inventory/{itemId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cook';
    }

    match /meal_logs/{logId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cook';
    }

    match /canteen_requisitions/{reqId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cook';
    }

    match /canteen_transactions/{transId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cook';
    }

    match /cleaning_tasks/{taskId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cleaner';
    }

    match /sanitation_logs/{logId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cleaner';
    }

    match /cleaning_issues/{issueId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Cleaner';
    }

    match /visitor_logs/{logId} {
      allow read, list: if isStaff() || isAdmin();
      allow write: if isAdmin() || getUserRole() == 'Security Officer';
    }

    match /security_incidents/{incidentId} {
      allow read, list: if isStaff() || isAdmin();
      allow write: if isAdmin() || getUserRole() == 'Security Officer';
    }

    match /gate_logs/{logId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Security Officer';
    }

    match /vehicle_logs/{logId} {
      allow read, list, get: if isSignedIn();
      allow create, update: if isSignedIn() && (isSuperAdmin() || isAdmin() || isTransportStaff() || isStaff());
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /{path=**}/vehicle_logs/{logId} {
      allow read, list, get: if isSignedIn();
      allow create, update: if isSignedIn() && (isSuperAdmin() || isAdmin() || isTransportStaff() || isStaff());
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /class_stories/{storyId} {
      allow read, list, get: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || isAdmin() || isTeacher();
      allow update: if isSignedIn();
      
      match /comments/{commentId} {
        allow read, list, get: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSuperAdmin() || isAdmin() || isTeacher() || resource.data.authorId == request.auth.uid;
      }
    }


    match /admissionApplications/{applicationId} {
      allow read, get, list: if isSignedIn();
      allow create: if true;
      allow update, write: if isSignedIn();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /admissionEnquiries/{enquiryId} {
      allow read, get, list: if isSignedIn();
      allow create: if true;
      allow update, write: if isSignedIn();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // =========================================================
    // 8. JUNIOR / SENIOR ACADEMY & CLUBS
    // =========================================================

    match /junior_abc_words/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /junior_phonics_sounds/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /junior_phonics_rhymes/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /junior_stories/{storyId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if request.auth.uid == resource.data.createdBy || isTeacher() || isAdmin();
    }

    match /junior_science/{factId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if request.auth.uid == resource.data.createdBy || isTeacher() || isAdmin();
    }

    match /junior_phonics/{wordId} {
      allow read, list: if isSignedIn();
      allow create: if isTeacher() || isAdmin();
      allow delete: if isTeacher() || isAdmin();
    }

    match /junior_puzzles/{puzzleId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /junior_stickers/{stickerId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /junior_sorter_items/{itemId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /junior_science_materials/{materialId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /junior_art_quests/{questId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /senior_stories/{id} {
      // Shared question bank = documents with no schoolId (managed by the platform team only).
      // Teacher content carries the school's id and can only be changed by that school's teachers/admins.
      allow read, list: if isSignedIn();
      allow create: if isSuperAdmin() || ((isTeacher() || isAdmin()) && request.resource.data.get('schoolId', '') == getUserSchoolId());
      allow update: if isSuperAdmin() || (
        (isTeacher() || isAdmin())
        && resource.data.get('schoolId', '') != ''
        && resource.data.get('schoolId', '') == getUserSchoolId()
        && request.resource.data.get('schoolId', '') == resource.data.get('schoolId', '')
      );
      allow delete: if isSuperAdmin() || (
        (isTeacher() || isAdmin())
        && resource.data.get('schoolId', '') != ''
        && resource.data.get('schoolId', '') == getUserSchoolId()
      );
    }

    match /senior_math/{id} {
      // Shared question bank = documents with no schoolId (managed by the platform team only).
      // Teacher content carries the school's id and can only be changed by that school's teachers/admins.
      allow read, list: if isSignedIn();
      allow create: if isSuperAdmin() || ((isTeacher() || isAdmin()) && request.resource.data.get('schoolId', '') == getUserSchoolId());
      allow update: if isSuperAdmin() || (
        (isTeacher() || isAdmin())
        && resource.data.get('schoolId', '') != ''
        && resource.data.get('schoolId', '') == getUserSchoolId()
        && request.resource.data.get('schoolId', '') == resource.data.get('schoolId', '')
      );
      allow delete: if isSuperAdmin() || (
        (isTeacher() || isAdmin())
        && resource.data.get('schoolId', '') != ''
        && resource.data.get('schoolId', '') == getUserSchoolId()
      );
    }

    match /senior_labs/{id} {
      // Shared question bank = documents with no schoolId (managed by the platform team only).
      // Teacher content carries the school's id and can only be changed by that school's teachers/admins.
      allow read, list: if isSignedIn();
      allow create: if isSuperAdmin() || ((isTeacher() || isAdmin()) && request.resource.data.get('schoolId', '') == getUserSchoolId());
      allow update: if isSuperAdmin() || (
        (isTeacher() || isAdmin())
        && resource.data.get('schoolId', '') != ''
        && resource.data.get('schoolId', '') == getUserSchoolId()
        && request.resource.data.get('schoolId', '') == resource.data.get('schoolId', '')
      );
      allow delete: if isSuperAdmin() || (
        (isTeacher() || isAdmin())
        && resource.data.get('schoolId', '') != ''
        && resource.data.get('schoolId', '') == getUserSchoolId()
      );
    }

    match /curriculum/{gradeId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
      match /units/{unitId} {
        allow read, list: if isSignedIn();
        allow write: if isTeacher() || isAdmin();
        match /lessons/{lessonId} {
          allow read, list: if isSignedIn();
          allow write: if isTeacher() || isAdmin();
        }
      }
    }

    match /logic_lab_missions/{missionId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /logic_lab_curriculum/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /student_progress/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /math_problems/{problemId} {
      allow read, list: if isSignedIn();
      allow write: if isStaff() || isAdmin();
    }

    match /user_results/{resultId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if isOwner(resource.data.userId) || isStaff();
      allow update, delete: if false;
    }

    match /global_leaderboard/{userId} {
      allow read, list: if isSignedIn();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    match /math_learning_history/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if request.auth.uid == resource.data.userId || isTeacher() || isAdmin();
      allow delete: if request.auth.uid == resource.data.userId || isAdmin();
    }

    match /science_problems/{problemId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    match /daily_facts/{factId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    match /science_leaderboard/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == userId;
    }

    match /science_results/{resultId} {
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) || isStaff();
      allow read, list: if isOwner(resource.data.userId) || isStaff();
      allow update, delete: if false;
    }

    match /science_lab_questions/{id} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /science_lab_results/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /science_learning_history/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if request.auth.uid == resource.data.userId || isTeacher() || isAdmin();
      allow delete: if request.auth.uid == resource.data.userId || isAdmin();
    }

    // ELA Rules
    match /ela_grammar_drills/{drillId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /ela_reading_passages/{passageId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /ela_writing_challenges/{challengeId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /ela_user_submissions/{submissionId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isTeacher() || isStaff() || isAdmin() || isDirector()
      );
      allow list: if isSignedIn() && (isTeacher() || isStaff() || isAdmin() || isDirector() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isTeacher() || isStaff() || isAdmin() || isDirector();
    }

    match /ela_learning_history/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if isSignedIn() && (request.auth.uid == id || request.auth.uid == resource.data.userId || isTeacher() || isAdmin());
      allow delete: if request.auth.uid == resource.data.userId || isAdmin();
    }

    match /ela_leaderboard/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Logic/Think Tank
    match /think_tank_paradoxes/{paradoxId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /think_tank_detective_cases/{caseId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /think_tank_debates/{debateId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /think_tank_crosswords/{puzzleId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /think_tank_submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isTeacher() || isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isTeacher() || isAdmin();
    }

    match /think_tank_responses/{responseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /scratch_assets/{assetId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /coding_curriculum/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /student_coding_progress/{progressId} {
      allow read, write: if isSignedIn() && (
        progressId.matches('^' + request.auth.uid) ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow read: if isTeacher() || isAdmin();
    }

    match /coding-club-projects/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /forumThreads/{threadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || request.auth.uid == resource.data.createdBy.uid;
      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin() || request.auth.uid == resource.data.author.uid;
      }
    }

    match /direct_messages/{chatId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      match /messages/{messageId} {
        allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/direct_messages/$(chatId)).data.participants;
      }
    }

    match /lectures/{lectureId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
      match /messages/{messageId} {
        allow read, create: if isSignedIn() && (isSuperAdmin() || getUserSchoolId() == get(/databases/$(database)/documents/lectures/$(lectureId)).data.schoolId);
      }
    }

    match /active_classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isTeacher();
      }
    }

    match /library/{itemId} {
      allow read, list: if isSignedIn();
      allow create: if isLibrarian() || isAdmin() || isTeacher();
      allow update: if isLibrarian() || isAdmin() || isTeacher() ||
                    (isStudent() && request.resource.data.status == 'Requested' && request.resource.data.currentHolderId == request.auth.uid) ||
                    (isStudent() && resource.data.currentHolderId == request.auth.uid && request.resource.data.status == 'Pending Return');
    }

    match /book_reviews/{reviewId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
    }

    // =========================================================
    // 8.2 BOARDING MODULE SUBMODULES
    // =========================================================

    match /hostel_blocks/{blockId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /hostel_rooms/{roomId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /hostel_beds/{bedId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /hostel_allocations/{allocationId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /boarding_applications/{applicationId} {
      allow read, list: if isSignedIn() && (isStaff() || isAdmin() || resource.data.studentId == request.auth.uid || parentOwnsStudent(resource.data.studentId));
      allow create: if isSignedIn() && (request.resource.data.studentId == request.auth.uid || parentOwnsStudent(request.resource.data.studentId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /student_leaves/{leaveId} {
      allow read, list: if isSignedIn() && (isStaff() || isAdmin() || resource.data.studentId == request.auth.uid || parentOwnsStudent(resource.data.studentId));
      allow write: if isAdmin();
    }

    match /boarding_visitors/{visitorId} {
      allow read, list: if isSignedIn() && (isStaff() || isAdmin() || resource.data.studentId == request.auth.uid || parentOwnsStudent(resource.data.studentId));
      allow write: if isAdmin();
    }

    match /roll_calls/{rollCallId} {
      allow read, list: if isSignedIn() && (isStaff() || isAdmin() || resource.data.studentId == request.auth.uid || parentOwnsStudent(resource.data.studentId));
      allow write: if isAdmin();
    }

    match /mess_weekly_menus/{menuId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /mess_attendance/{attendanceId} {
      allow read, list: if isSignedIn() && (isStaff() || isAdmin() || resource.data.studentId == request.auth.uid || parentOwnsStudent(resource.data.studentId));
      allow write: if isAdmin();
    }

    match /infirmary_logs/{logId} {
      allow read, list: if isSignedIn() && (isStaff() || isAdmin() || resource.data.studentId == request.auth.uid || parentOwnsStudent(resource.data.studentId));
      allow write: if isAdmin();
    }

    // =========================================================
    // 8.5 DIGITAL POCKET MONEY WALLET
    // =========================================================

    match /student_wallets/{studentId} {
      allow get: if isSignedIn() && (
        isOwner(studentId) ||
        parentOwnsStudent(studentId) ||
        isStaff() ||
        isAdmin()
      );
      allow list: if isSignedIn() && (isStaff() || isAdmin());
      allow write: if isAdmin();
    }

    match /wallet_transactions/{transactionId} {
      allow get: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        parentOwnsStudent(resource.data.studentId) ||
        isStaff() ||
        isAdmin()
      );
      allow list: if isSignedIn() && (isStaff() || isAdmin() || resource.data.studentId == request.auth.uid || parentOwnsStudent(resource.data.studentId));
      allow write: if isAdmin();
    }

    // =========================================================
    // 8.9. GALLERY SECURITY
    // =========================================================
    match /gallery/{postId} {
      allow read, list: if isSignedIn();
      allow create, delete: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
    }

    // =========================================================
    // 8.10. PARENT SATISFACTION SECURITY
    // =========================================================
    match /parent_satisfaction/{id} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn() && (resource.data.parentId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // 8.11. CLASS STORIES SECURITY
    // =========================================================
    match /class_stories/{storyId} {
      allow read, list, get: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();

      match /comments/{commentId} {
        allow read, list, get: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }
    }

    // =========================================================
    // 8.12. STUDENT TIMELINE & PUBLIC PORTFOLIO SECURITY
    // =========================================================
    match /students/{studentId} {
      allow read, get, list: if true; // Public verified portfolio view
      allow write: if isSignedIn();

      match /timeline/{eventId} {
        allow read, get, list: if true; // Public verified timeline view
        allow write: if isSignedIn();
      }
    }

    // Fee-change review trail: written ONLY by the server (functions/src/finance-review.ts).
    // The Director marks items OK or queries them (never their own changes); the staff member who made the
    // change can only answer a query. Nobody can create or delete review items from the app.
    function isReviewDirector() { return getUserRole() in ['Director', 'director', 'Owner', 'owner']; }
    match /financeReviews/{reviewId} {
      allow get, list: if isSuperAdmin() || (resource.data.schoolId == getUserSchoolId()
        && (isReviewDirector() || isAdmin() || resource.data.editedBy == request.auth.uid));
      allow create, delete: if false;
      allow update: if isSuperAdmin() || (resource.data.schoolId == getUserSchoolId() && (
        (isReviewDirector() && resource.data.editedBy != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'directorNote', 'resolvedBy', 'resolvedByName', 'resolvedAt'])
          && request.resource.data.status in ['ok', 'queried'])
        || (resource.data.editedBy == request.auth.uid && resource.data.status == 'queried'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'response', 'respondedAt'])
          && request.resource.data.status == 'answered')
      ));
    }

    // =========================================================
    // 9. CATCH-ALL (Platform Super-Admin only — keep at bottom)
    // =========================================================
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

  }
}