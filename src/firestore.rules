// v3.4: [SECURITY PATCH] Enforced view-only access for Secretary role on Students and Parents collections.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // 0. GLOBAL ALERT SYSTEM (SPOT CHECKS) - HIGH PRIORITY
    // =========================================================
    
    match /spot_checks/{checkId} {
        allow read, list: if request.auth != null; 
        allow create: if request.auth != null && (
          exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['Director', 'Administrator', 'Admin']
        );
        allow update: if request.auth != null; 
        allow delete: if request.auth != null && (
          exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['Director', 'Administrator', 'Admin']
        );
    }

    // =========================================================
    // 1. HELPER FUNCTIONS
    // =========================================================

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isSuperAdmin() {
      return request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2" ||
             request.auth.uid == "gZxe3nMbGcQhNgEzkwEZwDBnkFR2";
    }

    // Robust Role Detection
    function getUserRole() {
      return exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
           ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
           : '');
    }

    // Secretaries are NOT considered Admins for sensitive staff/HR data OR Academics
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        getUserRole() in ['Director', 'Administrator', 'Admin']
      );
    }

    function isTeacher() { return isSignedIn() && getUserRole() == 'Teacher'; }
    function isStudent() { return exists(/databases/$(database)/documents/students/$(request.auth.uid)); }
    function isStaff() { return exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isParent() { return exists(/databases/$(database)/documents/parents/$(request.auth.uid)); }

    function isFinanceStaff() {
      return isSignedIn() && (getUserRole() in ['Accountant', 'Director', 'Admin']);
    }

    function parentOwnsStudent(studentId) {
      return isParent() && studentId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.studentIds;
    }

    function isAnyStaff(schoolId) {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.schoolId == schoolId)
      );
    }

    // =========================================================
    // 3. SAAS CORE
    // =========================================================

    match /schools/{schoolId} {
      allow get, list: if true;
      allow write: if isSuperAdmin();
      allow update: if isSignedIn() && isAdmin();
    }

    match /schoolSettings/{schoolId} {
      allow read: if isSuperAdmin() || isAnyStaff(schoolId);
      allow write: if isSuperAdmin() || isAdmin();

      match /{allPaths=**} {
        allow read: if isSuperAdmin() || isAnyStaff(schoolId);
        allow write: if isSuperAdmin() || isAdmin();
      }
    }

    match /leads/{leadId} {
      allow read, write: if isSuperAdmin();
    }

    // =========================================================
    // 4. CORE COLLECTIONS
    // =========================================================

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    match /staff/{staffId} {
      allow get, list: if (resource.data.showOnWebsite == true) || isAdmin() || isOwner(staffId);
      allow list: if (isSignedIn() && (isAdmin() || getUserRole() == 'Receptionist')) || resource.data.showOnWebsite == true;
      allow write: if isAdmin() || isOwner(staffId);
      match /payroll/{configId} {
        allow read, write: if isFinanceStaff() || isAdmin();
      }
    }

    match /students/{studentId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isOwner(studentId);
    }

    match /parents/{parentId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isOwner(parentId);
    }

    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read, update, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, list: if isAdmin(); 
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFinanceStaff();
    }

    match /announcements_v2/{announcementId} {
      allow read, list: if isSignedIn() || 'Everybody' in resource.data.audience;
      allow write: if isAdmin() || getUserRole() == 'Secretary';
    }

    // Secretary role explicitly blocked from listing/reading admission data per user request
    match /admissionApplications/{appId} {
      allow read, write, list: if isAdmin() || isSuperAdmin();
      allow create: if true;
      allow read: if isSignedIn() && resource.data.submittedByParentId == request.auth.uid;
    }

    // =========================================================
    // 5. HR & STAFF
    // =========================================================

    match /leaveRequests/{requestId} {
      allow read, write, list: if isSuperAdmin() || isAdmin();
      allow list: if isStaff();
      allow read: if isSignedIn() && (resource.data.staffId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if isSignedIn();
    }

    match /performanceReviews/{reviewId} {
      allow read, list: if isAdmin() || (isSignedIn() && resource.data.staffId == request.auth.uid);
      allow write: if isAdmin();
    }

    // =========================================================
    // 6. ACADEMICS
    // =========================================================

    match /classes/{classId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /subjects/{subjectId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId}/assessments/{assessmentId} {
        allow read, list: if isSignedIn();
        allow write: if isAdmin() || isTeacher();
    }

    match /assessments/{assessmentId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isTeacher();
    }

    match /timetables/{timetableId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /timeSlots/{timeSlotId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /school_calendar/{eventId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || getUserRole() == 'Secretary';
    }

    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isTeacher() || isStaff() || isAdmin() ||
        parentOwnsStudent(resource.data.studentId)
      );
      allow list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /staff_attendance/{attendanceId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || isOwner(resource.data.staffId);
      allow list: if isAdmin(); 
    }

    match /report-cards/{reportId} {
      allow get: if isSignedIn() && (
        isTeacher() || isStaff() || isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        parentOwnsStudent(resource.data.studentId)
      );
      allow list: if isSignedIn();
      allow write: if isTeacher() || isStaff() || isAdmin();
    }

    match /report_card_remarks/{id} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    // =========================================================
    // 7. FINANCE
    // =========================================================

    match /financialRecords/{recordId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        isFinanceStaff() || isAdmin() || isTeacher() ||
        resource.data.studentId == request.auth.uid ||
        parentOwnsStudent(get(/databases/$(database)/documents/financialRecords/$(recordId)).data.studentId)
      );
      allow list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin() || isTeacher();
    }

    match /vendors/{vendorId} {
      allow read, list: if isSignedIn();
      allow write: if isFinanceStaff() || isAdmin();
    }

    match /inventory/{itemId} {
      allow read, list: if isSuperAdmin() || (isSignedIn() && isStaff());
      allow write: if isSuperAdmin() || isFinanceStaff() || isAdmin();
    }

    match /accountsPayable/{payableId} {
        allow read, list: if isFinanceStaff() || isAdmin() || getUserRole() == 'Secretary';
        allow write: if isFinanceStaff() || isAdmin() || getUserRole() == 'Secretary';
    }

    match /school_shop_items/{itemId} {
        allow read, list: if isSignedIn();
        allow write: if isFinanceStaff() || isAdmin() || getUserRole() == 'Secretary';
    }

    match /fixed_assets/{assetId} {
      allow read, write: if isFinanceStaff() || isAdmin();
    }

    match /depreciation_logs/{logId} {
      allow read, write: if isFinanceStaff() || isAdmin();
    }

    // Transport Security
    match /routes/{routeId} {
        allow read, list: if isSignedIn();
        allow write: if isAdmin() || getUserRole() == 'Transport Staff';
    }
    match /buses/{busId} {
        allow read, list: if isSignedIn();
        allow write: if isAdmin() || getUserRole() == 'Transport Staff';
    }

    // =========================================================
    // 7.5. JUNIOR / SENIOR ACADEMY & CLUBS
    // =========================================================

    match /junior_abc_words/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /junior_phonics_sounds/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /junior_phonics_rhymes/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /junior_stories/{storyId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if request.auth.uid == resource.data.createdBy || isTeacher() || isAdmin();
    }

    match /junior_science/{factId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if request.auth.uid == resource.data.createdBy || isTeacher() || isAdmin();
    }

    match /junior_phonics/{wordId} {
      allow read, list: if isSignedIn();
      allow create: if isTeacher() || isAdmin();
      allow delete: if isTeacher() || isAdmin();
    }

    match /junior_puzzles/{puzzleId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /junior_stickers/{stickerId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /junior_sorter_items/{itemId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /junior_science_materials/{materialId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    match /junior_art_quests/{questId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    // =========================================================
    // 8. CATCH-ALL
    // =========================================================

    match /{document=**} {
      allow read, write: if isAdmin();
    }

  }
}
