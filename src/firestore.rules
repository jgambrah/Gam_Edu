
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // 1. HELPER FUNCTIONS
    // =========================================================
    
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function getUserRole() {
      return exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
           ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
           : '');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2" || 
        getUserRole() in ['Director', 'Administrator', 'Admin']
      );
    }

    function isTeacher() { return isSignedIn() && getUserRole() == 'Teacher'; }
    function isStudent() { return exists(/databases/$(database)/documents/students/$(request.auth.uid)); }
    function isStaff() { return exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isFinanceStaff() { return getUserRole() in ['Accountant', 'Administrator', 'Director', 'Admin']; }
    function isDirector() { return getUserRole() == 'Director'; }
    function isLibrarian() { return getUserRole() == 'Librarian'; }

    // =========================================================
    // 2. SAAS CORE
    // =========================================================

    match /schools/{schoolId} {
      allow read, write: if request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2"; 
      allow read: if isSignedIn() && (
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.schoolId == schoolId)
      );
      allow update: if isSignedIn() && 
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'Director' &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.schoolId == schoolId;
    }
    
    match /schoolSettings/{docId} { 
      allow read: if isSignedIn(); 
      allow write: if isAdmin(); 
      match /{subcollection}/{subdocId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /leads/{leadId} {
      allow read, write: if request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2";
    }

    // =========================================================
    // 3. CORE COLLECTIONS
    // =========================================================

    match /users/{userId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    match /staff/{staffId} { 
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin() || isOwner(staffId); 
      match /payroll/{configId} { 
        allow read, write: if isFinanceStaff() || isAdmin(); 
      } 
    }
    match /students/{studentId} { allow read, list: if isSignedIn(); allow write: if isAdmin() || isOwner(studentId); }
    match /parents/{parentId} { allow read, list: if isSignedIn(); allow write: if isAdmin() || isOwner(parentId); }
    
    match /notifications/{notificationId} { allow create: if isSignedIn(); allow read, update, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid); allow delete: if isAdmin(); }
    
    match /auditLogs/{logId} { 
        allow read, list: if isSignedIn(); 
        allow create: if isSignedIn(); 
        allow update, delete: if false; 
    }
    
    match /counters/{counterId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /announcements_v2/{announcementId} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }

    // =========================================================
    // 5. HR & STAFF
    // =========================================================

    match /leaveRequests/{requestId} { allow read, write, list: if request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2" || isAdmin(); allow list: if isStaff(); allow read: if isSignedIn() && (resource.data.staffId == request.auth.uid || resource.data.parentId == request.auth.uid); allow create: if isSignedIn(); }
    match /performanceReviews/{reviewId} { allow read, list: if isAdmin() || (isSignedIn() && resource.data.staffId == request.auth.uid); allow write: if isAdmin(); }

    // =========================================================
    // 6. ACADEMICS
    // =========================================================

    match /classes/{classId} { allow read, list: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /subjects/{subjectId} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    match /timetables/{timetableId} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    match /rooms/{roomId} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    match /timeSlots/{timeSlotId} { allow read, list: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /school_calendar/{eventId} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    
    match /attendance/{attendanceId} {
        // Updated to allow students to read their own records
        allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || isTeacher() || isAdmin() || isDirector());
        allow list: if isAdmin() || isTeacher() || (isSignedIn() && request.query.where.studentId == request.auth.uid);
        allow write: if isTeacher() || isAdmin() || isDirector();
    }

    match /staff_attendance/{attendanceId} {
        allow create: if isSignedIn();
        allow read: if isAdmin() || isOwner(resource.data.staffId);
        allow list: if isAdmin() || (isSignedIn() && request.query.where.staffId == request.auth.uid);
    }

    match /report-cards/{reportId} { allow read, list: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /report_card_remarks/{id} { allow read, list: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }

    match /assignments/{assignmentId} { allow read, list: if isSignedIn(); allow write: if isTeacher() || isAdmin(); match /submissions/{submissionId} { allow read, list: if isTeacher() || isAdmin() || request.auth.uid == resource.data.studentId; allow create: if isStudent(); allow update: if isTeacher() || isAdmin(); } }
    match /submissions/{submissionId} { allow create: if isSignedIn(); allow read, list: if isSignedIn(); allow update: if isTeacher() || isAdmin(); allow delete: if false; }
    match /quizzes/{quizId} { allow read, list: if isSignedIn(); allow create: if isStaff() && request.resource.data.teacherId == request.auth.uid; allow update, delete: if isTeacher() && get(/databases/$(database)/documents/quizzes/$(quizId)).data.teacherId == request.auth.uid; match /attempts/{attemptId} { allow read, list: if isTeacher() || isAdmin() || request.auth.uid == resource.data.studentId; allow create: if isStudent(); } }
    match /quizAttempts/{attemptId} { allow create: if isSignedIn(); allow read, list: if isSignedIn(); allow update, delete: if isTeacher() || isAdmin(); }
    match /assessments/{assessmentId} { allow read, list: if isSignedIn(); allow create, update: if isTeacher() || isStaff() || isAdmin(); allow delete: if isAdmin(); }
    
    match /lesson-plans/{planId} {
      allow read, list: if isSignedIn();
      allow create: if (isStaff() && request.resource.data.teacherId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /learning_materials/{materialId} { allow read, list: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    match /behavioral_records/{recordId} { allow read, write, list: if isSignedIn(); }

    // =========================================================
    // 7. FINANCE (Updated Fixes)
    // =========================================================

    match /tills/{tillId} { 
      allow read, write, list: if isFinanceStaff() || isAdmin(); 
      match /transactions/{transactionId} { allow read, write, list: if isFinanceStaff() || isAdmin(); } 
    }

    match /bank_transactions/{transactionId} {
        allow read, list: if isFinanceStaff() || isAdmin();
        allow create: if isFinanceStaff();
        allow update: if isAdmin();
    }

    match /financialRecords/{recordId} { allow read, list: if request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2" || isFinanceStaff() || isAdmin() || isTeacher(); allow write: if isFinanceStaff() || isAdmin() || isTeacher(); }
    match /accountsPayable/{payableId} { allow read, list: if request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2" || isFinanceStaff() || isAdmin(); allow write: if isFinanceStaff() || isAdmin(); }
    match /accountsReceivable/{receivableId} { allow read, list: if request.auth.uid == "L4oE5XWweKRYrhtIXn6hB8IDHBC2" || isFinanceStaff() || isAdmin(); allow write: if isFinanceStaff() || isAdmin(); }
    
    match /inventory/{itemId} { 
        allow read, list: if isSignedIn(); 
        allow write: if isFinanceStaff() || isAdmin() || isDirector(); 
    }
    
    match /suppliers/{id} { allow read, list: if isSignedIn(); allow write: if isFinanceStaff() || isAdmin(); }
    match /purchase_orders/{id} { allow read, list: if isSignedIn(); allow write: if isFinanceStaff() || isAdmin(); }
    match /vendor_bills/{id} { allow read, list: if isSignedIn(); allow write: if isFinanceStaff() || isAdmin(); }
    
    match /products/{productId} { allow read, list: if isSignedIn(); allow write: if isFinanceStaff(); }
    match /categories/{categoryId} { allow read, list: if isSignedIn(); allow write: if isFinanceStaff(); }
    match /pos_transactions/{transactionId} { allow read, create, list: if isSignedIn(); allow update: if isFinanceStaff(); }
    
    match /school_shop_items/{itemId} { 
      allow read, list: if isSignedIn(); 
      allow write: if isFinanceStaff() || isAdmin(); 
    }
    match /school_shop_transactions/{transId} { allow read, write, list: if isFinanceStaff() || isAdmin(); }
    
    match /accounts/{accountId} { allow read, list: if isSignedIn(); allow write: if isFinanceStaff() || isAdmin(); }
    match /journal_entries/{entryId} { allow read, list: if isFinanceStaff() || isAdmin(); allow create: if isFinanceStaff() || isAdmin(); allow update: if false; }
    match /payment_vouchers/{voucherId} { allow read, write, list: if isFinanceStaff() || isAdmin(); }
    match /payrollSettings/{settingsId} { allow read, list: if isFinanceStaff(); allow write: if isAdmin(); }
    match /payroll_settings/{docId} { allow read, list: if isSignedIn(); allow write: if isFinanceStaff() || isAdmin(); }
    match /payroll_runs/{runId} { allow read, list: if isFinanceStaff() || isAdmin() || (isSignedIn() && request.auth.uid == resource.data.staffId); allow write: if isFinanceStaff() || isAdmin(); }
    match /payrollRecords/{recordId} { allow read, list: if isFinanceStaff(); allow get: if request.auth.uid == resource.data.staffId; allow write: if isFinanceStaff(); }
    match /staff_salary_details/{userId} { allow read, list: if isFinanceStaff() || isAdmin() || request.auth.uid == userId; allow write: if isFinanceStaff() || isAdmin(); }
    match /routes/{routeId} { allow read, list: if isSignedIn(); allow write: if isAdmin() || isFinanceStaff(); }
    match /buses/{busId} { allow read, list: if isSignedIn(); allow write: if isAdmin() || isFinanceStaff(); }
    match /admissionApplications/{applicationId} { allow read, write, list: if isAdmin(); allow create: if isSignedIn(); allow read: if isSignedIn() && resource.data.submittedByParentId == request.auth.uid; }

    // =========================================================
    // 8. JUNIOR / SENIOR ACADEMY & CLUBS
    // =========================================================

    // Junior
    match /junior_stories/{storyId} { allow read, list: if isSignedIn(); allow create: if isSignedIn(); allow update, delete: if request.auth.uid == resource.data.createdBy || isTeacher() || isAdmin(); }
    match /junior_science/{factId} { allow read, list: if isSignedIn(); allow create: if isSignedIn(); allow update, delete: if request.auth.uid == resource.data.createdBy || isTeacher() || isAdmin(); }
    match /junior_phonics/{wordId} { allow read, list: if isSignedIn(); allow create: if isTeacher() || isAdmin(); allow delete: if isTeacher() || isAdmin(); }
    match /junior_puzzles/{puzzleId} { allow read, list: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    match /junior_stickers/{stickerId} { allow read, list: if isSignedIn(); allow create: if isSignedIn(); allow update, delete: if isOwner(resource.data.userId) || isAdmin(); }
    match /junior_sorter_items/{itemId} { allow read, list: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    match /junior_science_materials/{materialId} { allow read, list: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    match /junior_art_quests/{questId} { allow read, list: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }

    // Senior
    match /senior_stories/{id} { allow read, list: if true; allow write: if isTeacher() || isAdmin(); }
    match /senior_math/{id} { allow read, list: if true; allow write: if isTeacher() || isAdmin(); }
    match /senior_labs/{id} { allow read, list: if true; allow write: if isTeacher() || isAdmin(); }
    
    // Curriculum
    match /curriculum/{gradeId} {
      allow read, list: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
      match /units/{unitId} {
        allow read, list: if isSignedIn();
        allow write: if isTeacher() || isAdmin();
        match /lessons/{lessonId} {
          allow read, list: if isSignedIn();
          allow write: if isTeacher() || isAdmin();
        }
      }
    }

    // Clubs
    match /logic_lab_missions/{missionId} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    match /logic_lab_curriculum/{docId} { allow read, list: if isSignedIn(); allow write: if isAdmin(); }
    match /student_progress/{userId} { allow read, write: if request.auth.uid == userId; }
    match /coding-club-projects/{userId} { allow read, write: if isOwner(userId); }
    match /math_problems/{problemId} { allow read, list: if isSignedIn(); allow write: if isStaff() || isAdmin(); }
    match /user_results/{resultId} { allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow read, list: if isOwner(resource.data.userId) || isStaff(); allow update, delete: if false; }
    match /global_leaderboard/{userId} { allow read, list: if isSignedIn(); allow write: if request.auth.uid == userId || isAdmin(); }
    match /math_learning_history/{id} { allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow read, list: if request.auth.uid == resource.data.userId || isTeacher() || isAdmin(); allow delete: if request.auth.uid == resource.data.userId || isAdmin(); }
    match /science_problems/{problemId} { allow read: if true; allow write: if isTeacher() || isAdmin(); }
    match /daily_facts/{factId} { allow read: if true; allow write: if isTeacher() || isAdmin(); }
    match /science_leaderboard/{userId} { allow read: if isSignedIn(); allow write: if request.auth.uid == userId; }
    match /science_results/{resultId} { allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) || isStaff(); allow read, list: if isOwner(resource.data.userId) || isStaff(); allow update, delete: if false; }
    match /science_lab_questions/{id} { allow read, write: if isSignedIn(); }
    match /science_lab_results/{id} { allow read: if isSignedIn(); allow create: if isSignedIn(); }
    match /science_learning_history/{id} { allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow read, list: if request.auth.uid == resource.data.userId || isTeacher() || isAdmin(); allow delete: if request.auth.uid == resource.data.userId || isAdmin(); }
    match /ela_grammar_drills/{drillId} { allow read: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    match /ela_reading_passages/{passageId} { allow read: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    match /ela_writing_challenges/{challengeId} { allow read: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    match /ela_user_submissions/{submissionId} { allow create: if isOwner(request.resource.data.userId); allow read, list: if isOwner(request.data.userId) || isTeacher() || isAdmin(); allow update: if isTeacher() || isAdmin(); }
    match /ela_learning_history/{id} { allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow read, list: if isSignedIn(); allow delete: if request.auth.uid == resource.data.userId || isAdmin(); }
    match /ela_leaderboard/{userId} { allow read: if isSignedIn(); allow write: if isOwner(userId) || isAdmin(); }
    match /think_tank_paradoxes/{paradoxId} { allow read: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    match /think_tank_detective_cases/{caseId} { allow read: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    match /think_tank_debates/{debateId} { allow read: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    match /think_tank_crosswords/{puzzleId} { allow read: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    match /think_tank_submissions/{submissionId} { allow read: if isSignedIn(); allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow update: if isTeacher() || isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid); allow delete: if isTeacher() || isAdmin(); }
    match /think_tank_responses/{responseId} { allow read: if isSignedIn(); allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid; }

    match /scratch_assets/{assetId} { allow read: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    match /coding_curriculum/{lessonId} { allow read: if isSignedIn(); allow write: if isTeacher() || isAdmin(); }
    match /student_coding_progress/{progressId} { allow read, write: if isSignedIn() && (progressId.startsWith(request.auth.uid) || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid); allow read: if isTeacher() || isAdmin(); }
    match /student_coding_projects/{projectId} { allow read: if isSignedIn(); allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid; }
    match /forumThreads/{threadId} { allow read: if isSignedIn(); allow create: if isSignedIn(); allow update: if isSignedIn(); allow delete: if isAdmin() || request.auth.uid == resource.data.createdBy.uid; match /replies/{replyId} { allow read: if isSignedIn(); allow create: if isSignedIn(); allow update, delete: if isAdmin() || request.auth.uid == resource.data.author.uid; } }
    
    match /direct_messages/{chatId} { 
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow list: if isSignedIn(); 
      allow create: if isSignedIn();
      match /messages/{messageId} { 
        allow read, write: if isSignedIn(); 
      } 
    }

    match /lectures/{lectureId} { allow read: if isSignedIn(); allow write: if isTeacher() || isAdmin(); match /messages/{messageId} { allow read, create: if isSignedIn(); } }
    match /active_classes/{classId} { allow read, write: if isSignedIn(); match /{document=**} { allow read, write: if isSignedIn(); } }
    
    match /library/{itemId} { 
      allow read: if true; 
      allow write: if isLibrarian() || isAdmin() || isTeacher();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
