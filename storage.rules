rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // School-specific assets like logos and student photos
    match /schools/{schoolId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; 
    }
    
    // Digital signatures - only the owner can upload/delete
    match /signatures/{schoolId}/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}